{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synaptiai/agent-capability-standard/schemas/interop/standard_agents_annotation.schema.json",
  "title": "Agent Capability Standard annotation for a Standard Agents tool",
  "description": "The value of the `acs` key in a Standard Agent Specification tool's `annotations`: a carrier of the tool binding record (schemas/interop/tool_binding.schema.json, Standard 1.2.0 section 5.18.1), with the Standard it cites. `layer` and the effective flags are informative copies, which a safety layer ignores; a copy may not name another layer than the capability's, or be weaker than its ontology flags. Generated by scripts/gen_standard_agents_binding.py from the ontology.",
  "type": "object",
  "required": [
    "standard",
    "ontology"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the Agent Capability Standard the classification follows."
    },
    "ontology": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the capability ontology the capability id and flags come from (`meta.version`)."
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "description": "The name the tool states for itself: what an approver is shown, and the record's `tool`."
    },
    "capability": {
      "enum": [
        "retrieve",
        "search",
        "observe",
        "receive",
        "detect",
        "classify",
        "measure",
        "predict",
        "compare",
        "discover",
        "plan",
        "decompose",
        "critique",
        "explain",
        "state",
        "transition",
        "attribute",
        "ground",
        "simulate",
        "generate",
        "transform",
        "integrate",
        "execute",
        "mutate",
        "send",
        "verify",
        "checkpoint",
        "rollback",
        "constrain",
        "audit",
        "persist",
        "recall",
        "delegate",
        "synchronize",
        "invoke",
        "inquire"
      ],
      "description": "The ontology capability the tool performs."
    },
    "layer": {
      "enum": [
        "PERCEIVE",
        "UNDERSTAND",
        "REASON",
        "MODEL",
        "SYNTHESIZE",
        "EXECUTE",
        "VERIFY",
        "REMEMBER",
        "COORDINATE"
      ],
      "description": "Informative copy: the capability's layer."
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)*$",
      "description": "The capability's domain parameter, a domain id (section 5.2.4), e.g. `config` or `image.object`."
    },
    "flags": {
      "type": "object",
      "properties": {
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "mutation": {
          "type": "boolean"
        },
        "requires_checkpoint": {
          "type": "boolean"
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The safety flags the tool declares (section 5.2.1)."
    },
    "additional_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "retrieve",
          "search",
          "observe",
          "receive",
          "detect",
          "classify",
          "measure",
          "predict",
          "compare",
          "discover",
          "plan",
          "decompose",
          "critique",
          "explain",
          "state",
          "transition",
          "attribute",
          "ground",
          "simulate",
          "generate",
          "transform",
          "integrate",
          "execute",
          "mutate",
          "send",
          "verify",
          "checkpoint",
          "rollback",
          "constrain",
          "audit",
          "persist",
          "recall",
          "delegate",
          "synchronize",
          "invoke",
          "inquire"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Other capabilities the same call performs (section 5.18.3)."
    },
    "classifier": {
      "type": "string",
      "minLength": 1,
      "description": "Names the classifier a layer applies to each call (section 5.18.3)."
    },
    "invokes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "The tools the tool may call while it runs (section 5.18.4)."
    },
    "approval": {
      "type": "object",
      "properties": {
        "min_approvers": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "pattern": "^(\\d+(ms|s|m|h|d)|P(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+(\\.\\d{1,9})?S)?)?)$"
        }
      },
      "additionalProperties": false,
      "description": "How approval of a call is counted (section 5.18.7)."
    },
    "control": {
      "const": true,
      "description": "The tool only signals the host: never refused (section 5.18.3)."
    },
    "destination": {
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$",
      "description": "For a `send` tool: an RFC 6901 pointer to the argument that holds the destination (section 4.4.2)."
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Informative copy: the effective risk, at least the ontology's (section 5.2.1)."
    },
    "mutation": {
      "type": "boolean",
      "description": "Informative copy: whether the tool changes persistent state."
    },
    "requires_checkpoint": {
      "type": "boolean",
      "description": "Informative copy: whether a checkpoint must precede each call."
    },
    "requires_approval": {
      "type": "boolean",
      "description": "Informative copy: whether each call needs approval."
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "capability"
      ],
      "not": {
        "required": [
          "control"
        ]
      }
    },
    {
      "required": [
        "control"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "capability"
            ]
          },
          {
            "required": [
              "domain"
            ]
          },
          {
            "required": [
              "flags"
            ]
          },
          {
            "required": [
              "additional_capabilities"
            ]
          },
          {
            "required": [
              "classifier"
            ]
          },
          {
            "required": [
              "invokes"
            ]
          },
          {
            "required": [
              "approval"
            ]
          },
          {
            "required": [
              "destination"
            ]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "const": "retrieve"
          }
