{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synaptiai/agent-capability-standard/schemas/interop/standard_agents_annotation.schema.json",
  "title": "Agent Capability Standard annotation for a Standard Agents tool",
  "description": "The value of the `acs` key in a Standard Agent Specification tool's `annotations`: the ontology capability the tool performs and its effective safety flags. Generated by scripts/gen_standard_agents_binding.py from the ontology.",
  "type": "object",
  "required": [
    "standard",
    "ontology",
    "capability",
    "layer",
    "risk",
    "mutation",
    "requires_checkpoint",
    "requires_approval"
  ],
  "additionalProperties": false,
  "properties": {
    "standard": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the Agent Capability Standard the classification follows."
    },
    "ontology": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the capability ontology the capability id and flags come from (`meta.version`)."
    },
    "capability": {
      "enum": [
        "retrieve",
        "search",
        "observe",
        "receive",
        "detect",
        "classify",
        "measure",
        "predict",
        "compare",
        "discover",
        "plan",
        "decompose",
        "critique",
        "explain",
        "state",
        "transition",
        "attribute",
        "ground",
        "simulate",
        "generate",
        "transform",
        "integrate",
        "execute",
        "mutate",
        "send",
        "verify",
        "checkpoint",
        "rollback",
        "constrain",
        "audit",
        "persist",
        "recall",
        "delegate",
        "synchronize",
        "invoke",
        "inquire"
      ],
      "description": "The one ontology capability the tool performs."
    },
    "layer": {
      "enum": [
        "PERCEIVE",
        "UNDERSTAND",
        "REASON",
        "MODEL",
        "SYNTHESIZE",
        "EXECUTE",
        "VERIFY",
        "REMEMBER",
        "COORDINATE"
      ],
      "description": "The capability's layer."
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "The capability's domain parameter, e.g. `config`."
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Effective risk: the higher of the tool's declaration and the ontology's value (Standard §5.2.1)."
    },
    "mutation": {
      "type": "boolean",
      "description": "Whether the tool changes persistent state."
    },
    "requires_checkpoint": {
      "type": "boolean",
      "description": "Whether a checkpoint must precede each call."
    },
    "requires_approval": {
      "type": "boolean",
      "description": "Whether each call needs approval."
    }
  }
}
