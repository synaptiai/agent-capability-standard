{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synaptiai/agent-capability-standard/schemas/workflow_catalog.schema.json",
  "title": "Grounded Agency Workflow Catalog Schema",
  "description": "JSON Schema for workflow_catalog.yaml — defines composed workflow patterns that orchestrate atomic capabilities from the ontology.",
  "type": "object",
  "patternProperties": {
    "^x-": {
      "description": "Vendor data; not a workflow."
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/workflow"
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "required": ["goal", "risk", "steps"],
      "additionalProperties": true,
      "properties": {
        "spec_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "Standard version the workflow targets (e.g. \"1.1\"). Without it, a '# Standard version:' file header applies."
        },
        "domain": {
          "type": "string",
          "description": "Domain the workflow belongs to (e.g. healthcare)."
        },
        "profile": {
          "type": "string",
          "description": "Path of the domain profile the workflow runs under."
        },
        "goal": {
          "type": "string",
          "description": "The objective this workflow achieves."
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Overall risk level of the workflow."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the workflow pattern."
        },
        "success": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Success criteria for the workflow."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Ordered list of capability steps."
        },
        "risk_propagation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "strategy": {
              "type": "string",
              "description": "How risk propagates across steps."
            },
            "computed_risk": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "The computed overall risk from propagation."
            }
          }
        },
        "data_flow": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Data flow pattern between steps."
            },
            "rule": {
              "type": "string",
              "description": "Rule governing data flow."
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/workflow_input"
          },
          "propertyNames": { "not": { "const": "_recovery" } },
          "description": "Workflow-level input declarations (_recovery is reserved)."
        },
        "workflow_extensions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "supports_input_bindings": {
              "type": "boolean"
            },
            "supports_conditions": {
              "type": "boolean"
            },
            "supports_parallel_groups": {
              "type": "boolean"
            },
            "supports_recovery_loops": {
              "type": "boolean"
            },
            "supports_gates": {
              "type": "boolean"
            },
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["triggers@1", "recovery@1", "wait@1", "approval@1", "delegation@1", "quorum@1"]
              },
              "description": "Extensions the workflow depends on (STANDARD v1.1 §5.9). A consumer that does not implement one must refuse the workflow."
            }
          }
        },
        "triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/trigger" },
          "description": "How runs of this workflow start (STANDARD v1.1 §5.10; needs triggers@1)."
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(ms|s|m|h|d)|P(?=[0-9]|T[0-9])([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+(\\.[0-9]{1,9})?S)?)?)$(?!\\n)",
      "description": "A duration: <digits>(ms|s|m|h|d) or an ISO-8601 day-time duration (STANDARD v1.1 §5.10.1)."
    },
    "positive_duration": {
      "allOf": [
        { "$ref": "#/$defs/duration" },
        { "not": { "pattern": "^(0+(ms|s|m|h|d)|P(0+D)?(T(0+H)?(0+M)?(0+(\\.0+)?S)?)?)$" } }
      ],
      "description": "A duration longer than zero."
    },
    "fireable_code": {
      "type": "string",
      "enum": ["R401", "R402", "R403", "R405", "F502"]
    },
    "trigger": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["schedule", "event", "manual", "invoke"] },
        "attendance": { "type": "string", "enum": ["attended", "unattended"] },
        "schedule": { "$ref": "#/$defs/schedule" },
        "event": { "$ref": "#/$defs/event_trigger" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "schedule" } }, "required": ["kind"] },
          "then": { "required": ["schedule"] },
          "else": { "not": { "required": ["schedule"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "event" } }, "required": ["kind"] },
          "then": { "required": ["event"] },
          "else": { "not": { "required": ["event"] } }
        }
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": true,
      "oneOf": [{ "required": ["cron"] }, { "required": ["every"] }],
      "properties": {
        "cron": { "type": "string", "description": "Five-field cron expression; no CRON_TZ= prefix." },
        "every": {
          "$ref": "#/$defs/positive_duration",
          "description": "An interval longer than zero."
        },
        "timezone": { "type": "string", "description": "IANA time zone name (default UTC)." },
        "overlap": { "type": "string", "enum": ["skip", "buffer_one", "allow_all"] }
      }
    },
    "event_trigger": {
      "type": "object",
      "required": ["event_type", "delivers_to"],
      "additionalProperties": true,
      "properties": {
        "event_type": { "type": "string" },
        "source_kind": {
          "type": "string",
          "enum": ["log", "api", "sensor", "message_bus", "human", "agent"],
          "description": "An event_schema source kind."
        },
        "delivers_to": { "type": "string", "description": "Workflow input whose ref is the canonical event." }
      }
    },
    "workflow_input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Data type of this input."
        },
        "required": {
          "type": "boolean",
          "description": "Whether this input is required."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description."
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Sub-properties of this input."
        },
        "ref": {
          "type": "string",
          "description": "Reference to an external schema."
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["capability", "purpose", "store_as"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "handler": { "const": true } },
            "required": ["handler"]
          },
          "then": {
            "properties": { "capability": { "const": "invoke" } }
          }
        },
        {
          "if": { "required": ["wait"] },
          "then": {
            "required": ["timeout"],
            "properties": { "timeout": { "$ref": "#/$defs/duration" } }
          }
        }
      ],
      "properties": {
        "capability": {
          "type": "string",
          "description": "The atomic capability to invoke."
        },
        "purpose": {
          "type": "string",
          "description": "Why this step exists in the workflow."
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Risk level of this step. Omitted, it inherits the ontology's; a lower value is ignored (W602)."
        },
        "mutation": {
          "type": "boolean",
          "description": "Whether this step modifies persistent state. Omitted, it inherits the ontology's; false where the ontology says true is ignored (W602)."
        },
        "requires_checkpoint": {
          "type": "boolean",
          "description": "Whether a checkpoint is required before this step. Omitted, it inherits the ontology's; false where the ontology says true is ignored (W602)."
        },
        "requires_approval": {
          "type": "boolean",
          "description": "Whether human approval is needed. Omitted, it inherits the ontology's; false where the ontology says true is ignored (W602)."
        },
        "timeout": {
          "type": ["string", "null"],
          "description": "Execution timeout (e.g. '5m') or null for no timeout."
        },
        "retry": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Maximum retry attempts."
                },
                "backoff": {
                  "type": "string",
                  "description": "Backoff strategy (e.g. 'exponential')."
                }
              }
            }
          ],
          "description": "Retry policy or null for no retry."
        },
        "store_as": {
          "type": "string",
          "not": { "const": "_recovery" },
          "description": "Key under which this step's output is stored (_recovery is reserved)."
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure_mode"
          },
          "description": "Known failure modes and their recovery strategies."
        },
        "input_bindings": {
          "type": "object",
          "additionalProperties": true,
          "description": "Bindings that wire previous step outputs into this step's inputs."
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate"
          },
          "description": "Conditional gates that may skip or stop the step."
        },
        "parallel_group": {
          "type": "string",
          "description": "Group ID for parallel execution."
        },
        "join": {
          "type": "string",
          "description": "Join strategy for parallel groups (e.g. 'all_complete')."
        },
        "domain": {
          "type": "string",
          "description": "Domain specialization for this capability invocation."
        },
        "condition": {
          "type": "string",
          "description": "Expression that must be true for this step to execute."
        },
        "skip_if_false": {
          "type": "boolean",
          "description": "Whether to skip this step if its condition evaluates to false."
        },
        "wait": {
          "$ref": "#/$defs/wait",
          "description": "Wait for a matching event (STANDARD v1.1 §5.13; needs wait@1). Only on receive, or synchronize over at least two agents; the step needs a duration timeout."
        },
        "approval": {
          "$ref": "#/$defs/approval",
          "description": "How the step's approval is obtained and bound (STANDARD v1.1 §5.14; needs approval@1). Only where approval is required."
        },
        "handler": {
          "type": "boolean",
          "description": "An invoke step that runs only as an escalation target (STANDARD v1.1 §5.11; needs recovery@1)."
        },
        "workflow_id": {
          "type": "string",
          "description": "For invoke steps, the ID of the sub-workflow to execute."
        },
        "mapping_ref": {
          "type": "string",
          "description": "Reference to a transformation mapping file."
        },
        "output_conforms_to": {
          "type": "string",
          "description": "Schema reference that the step output must conform to."
        }
      }
    },
    "wait": {
      "type": "object",
      "required": ["event_type"],
      "additionalProperties": true,
      "properties": {
        "event_type": { "type": "string", "description": "The event_type to wait for." },
        "source_kind": {
          "type": "string",
          "enum": ["log", "api", "sensor", "message_bus", "human", "agent"],
          "description": "Only events from this kind of source match (event_schema.yaml source.kind)."
        },
        "correlate": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Keys the event must carry, mapped to the references whose values they must equal."
        },
        "liveness": {
          "type": "object",
          "required": ["mode", "interval"],
          "additionalProperties": true,
          "properties": {
            "mode": { "type": "string", "enum": ["push", "probe"] },
            "interval": { "$ref": "#/$defs/positive_duration" },
            "failure_threshold": { "type": "integer", "minimum": 1, "default": 3 }
          },
          "description": "Give up early when the source stops answering: interval × failure_threshold must be shorter than the step's timeout."
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["approver"],
      "additionalProperties": true,
      "properties": {
        "approver": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": true,
          "if": {
            "properties": { "kind": { "const": "standing_mandate" } },
            "required": ["kind"]
          },
          "then": { "required": ["mandate_ref"] },
          "else": { "not": { "required": ["mandate_ref"] } },
          "properties": {
            "kind": { "type": "string", "enum": ["human", "standing_mandate"] },
            "role": { "type": "string" },
            "min_approvers": { "type": "integer", "minimum": 1, "default": 1 },
            "mandate_ref": { "type": "string", "description": "The standing mandate that approves (kind standing_mandate only)." }
          }
        },
        "mode": { "type": "string", "enum": ["in_session", "out_of_band"], "default": "in_session" },
        "shows": {
          "type": "array",
          "items": { "type": "string" },
          "description": "References whose values the approvers see; the decision binds to their digest."
        },
        "binds_to": { "type": "string", "enum": ["digest"], "default": "digest" },
        "recheck": {
          "type": "object",
          "required": ["source"],
          "additionalProperties": true,
          "properties": {
            "source": { "type": "string", "description": "Reference re-read before acting." },
            "compare": { "type": "string", "enum": ["version", "digest"], "default": "digest" },
            "on_change": { "type": "string", "enum": ["reask", "replan", "stop"], "default": "reask" }
          }
        },
        "expires": {
          "$ref": "#/$defs/positive_duration",
          "description": "How long a decision stays valid; longer than zero."
        },
        "when_unattended": {
          "type": "string",
          "enum": ["defer_to_queue", "skip", "fail"],
          "default": "fail",
          "description": "What an unattended run does here: queue the action and end deferred, skip the step, or fail with F502."
        }
      }
    },
    "failure_mode": {
      "type": "object",
      "required": ["condition", "action"],
      "additionalProperties": true,
      "if": {
        "properties": { "action": { "const": "escalate" } },
        "required": ["action"]
      },
      "then": {
        "required": ["recovery"],
        "properties": {
          "recovery": {
            "type": "object",
            "required": ["goto_step"],
            "not": {
              "anyOf": [
                { "required": ["max_loops"] },
                { "required": ["on_exhausted"] },
                { "required": ["inject_context"] }
              ]
            }
          }
        }
      },
      "properties": {
        "condition": {
          "type": "string",
          "description": "Prose description of the failure."
        },
        "when": {
          "type": "string",
          "description": "Expression (STANDARD §5.8) that fires this failure mode; an expression that errors does not fire it."
        },
        "action": {
          "type": "string",
          "enum": ["stop", "rollback", "request_more_context", "pause_and_checkpoint", "escalate"],
          "description": "Action to take when the failure mode fires (escalate needs recovery@1)."
        },
        "on_error": {
          "oneOf": [
            { "$ref": "#/$defs/fireable_code" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fireable_code" } }
          ],
          "description": "Runtime code(s) that fire this failure mode (STANDARD v1.1 §5.12)."
        },
        "recovery": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "goto_step": { "type": "string", "description": "store_as of the loop target or handler step." },
                "inject_context": { "type": "object", "description": "Values readable as ${_recovery.<key>} from the loop target onward." },
                "max_loops": { "type": "integer", "minimum": 1 },
                "on_exhausted": {
                  "type": "object",
                  "required": ["goto_step"],
                  "properties": { "goto_step": { "type": "string" } },
                  "description": "Handler step to escalate to when max_loops is exhausted (needs recovery@1)."
                }
              }
            }
          ],
          "description": "Recovery strategy — a human-readable string or a structured object (e.g. goto_step with context injection)."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["when", "action"],
      "additionalProperties": true,
      "if": {
        "properties": { "phase": { "const": "after" } },
        "required": ["phase"]
      },
      "then": {
        "properties": { "action": { "not": { "const": "skip" } } }
      },
      "properties": {
        "when": {
          "type": "string",
          "description": "Expression (STANDARD §5.8) that fires this gate; an expression that errors fires it."
        },
        "action": {
          "type": "string",
          "enum": ["stop", "rollback", "skip", "warn"],
          "description": "Action to take when the gate fires."
        },
        "phase": {
          "type": "string",
          "enum": ["before", "after"],
          "description": "Evaluated before the step (default) or after it; an after-gate cannot skip."
        },
        "message": {
          "type": "string",
          "description": "Human-readable message explaining the gate action."
        }
      }
    }
  }
}
