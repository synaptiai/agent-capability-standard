    "delegate.input": {
      "type": "object",
      "required": [
        "task",
        "agent"
      ],
      "properties": {
        "task": {
          "type": "object",
          "description": "Task to delegate"
        },
        "agent": {
          "type": "string",
          "description": "Target agent"
        },
        "constraints": {
          "type": "object",
          "description": "Delegation constraints"
        },
        "fresh_context": {
          "type": "boolean",
          "description": "Start the delegate without this agent's context (delegation@1, STANDARD v1.1 §5.15)"
        },
        "model_family": {
          "type": "string",
          "description": "Model family the delegate should run on (delegation@1)"
        },
        "role": {
          "type": "string",
          "description": "Role the delegate takes, e.g. reviewer (delegation@1)"
        },
        "read_only": {
          "type": "boolean",
          "description": "The delegate may read but must not change anything (files, repositories, external state); the host attests it in effective (delegation@1, STANDARD v1.1 §5.15)"
        },
        "accept_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a delegate that waits, principals to accept its result from; others are dropped and counted (delegation@1, STANDARD v1.1 §5.13, §5.15)"
        },
        "sender_check": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a delegate that waits, how the result's sender must have been authenticated (identity@1, STANDARD v1.1 §5.17)"
        },
        "accept_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a delegate that waits, trust classes to accept its result from (identity@1, STANDARD v1.1 §5.17)"
        },
        "always_ask_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a delegate that waits, trust classes whose result (and a result with no trust class) makes any step that requires approval and uses it be asked of a person (identity@1, STANDARD v1.1 §5.17)"
        }
      }
    },
    "delegate.output": {
      "type": "object",
      "required": [
        "accepted",
        "evidence_anchors"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "task_id": {
          "type": "string",
          "description": "Delegated task ID"
        },
        "agent": {
          "type": "string",
          "description": "Assigned agent"
        },
        "effective": {
          "type": "object",
          "description": "The delegation settings actually used, as attested by the host",
          "properties": {
            "fresh_context": {
              "type": "boolean"
            },
            "model_family": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "read_only": {
              "type": "boolean"
            },
            "identity": {
              "type": "object",
              "description": "The agent_identity of the party that took the delegation (identity@1); a waiting delegate keeps only its results"
            }
          }
        },
        "result": {
          "type": "object",
          "description": "The delegate's result, when the step waits for it (wait@1, STANDARD v1.1 §5.13), with its sender (and, with identity@1, its sender_identity)"
        },
        "evidence_anchors": {
          "type": "array"
        }
      }
    },
    "synchronize.input": {
      "type": "object",
      "required": [
        "agents",
        "state"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "description": "Agents to synchronize"
        },
        "state": {
          "type": "object",
          "description": "State to agree on"
        },
        "timeout": {
          "type": "string",
          "description": "Sync timeout"
        },
        "accept_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Principals to accept state from (delegation@1, STANDARD v1.1 §5.15)"
        },
        "sender_check": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "How a sender must have been authenticated (agent_identity authenticated_by values); a state update whose sender identity says otherwise, or that carries none, is dropped and counted (identity@1, STANDARD v1.1 §5.17)"
        },
        "accept_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trust classes to accept state from; updates from others, or with no trust class, are dropped and counted (identity@1, STANDARD v1.1 §5.17)"
        },
        "always_ask_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trust classes whose state (and state with no trust class) makes any step that requires approval and uses it be asked of a person, whatever mandate would cover it (identity@1, STANDARD v1.1 §5.17)"
        }
      }
    },
    "synchronize.output": {
      "type": "object",
      "required": [
        "synchronized",
        "evidence_anchors"
      ],
      "properties": {
        "synchronized": {
          "type": "boolean"
        },
        "agreed_state": {
          "type": "object",
          "description": "Agreed state"
        },
        "participants": {
          "type": "array",
          "description": "Participating agents"
        },
        "sender": {
          "type": "string",
          "description": "The host-authenticated principal that delivered the agreed state, when the step waited for it (wait@1)"
        },
        "sender_identity": {
          "type": "object",
          "description": "The sender's identity as the host reported it (agent_identity_schema.yaml; identity@1, STANDARD v1.1 §5.17)"
        },
        "evidence_anchors": {
          "type": "array"
        }
      }
    },
