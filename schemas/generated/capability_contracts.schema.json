{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synaptiai/agent-capability-standard/schemas/generated/capability_contracts.schema.json",
  "$comment": "Generated from schemas/capability_ontology.yaml (ontology 2.1.0) by scripts/gen_capability_json_schemas.py. Do not edit: change the ontology and run that script.",
  "title": "Capability contracts of ontology 2.1.0",
  "description": "The input and output contract of each capability in the Agent Capability Standard ontology, rendered as JSON Schema Draft 2020-12. `$defs` holds `<capability>.input` and `<capability>.output`; the document itself constrains nothing. The ontology writes `type: any`, and writes a union as `a|b`. A union is rendered as a type list. `any` is rendered as a schema with no `type`, which accepts every value, and the keyword `\"x-acs-type\": \"any\"`. A schema with neither `type` nor that keyword is one whose type the ontology does not state. Objects are open: a contract lists the fields it requires and does not forbid others.",
  "$defs": {
    "retrieve.input": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "Reference to data (ID, path, URI)"
        },
        "format": {
          "type": "string",
          "description": "Expected format of retrieved data"
        },
        "filter": {
          "type": "object",
          "description": "Criteria the retrieved data must meet (e.g. a time range)"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Further references to retrieve along with the target (e.g. search results)"
        }
      }
    },
    "retrieve.output": {
      "type": "object",
      "required": [
        "data",
        "evidence_anchors",
        "confidence"
      ],
      "properties": {
        "data": {
          "x-acs-type": "any",
          "description": "Retrieved data"
        },
        "evidence_anchors": {
          "type": "array",
          "description": "Source references"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "search.input": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": [
