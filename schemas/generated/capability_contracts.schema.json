    "receive.input": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "description": "Source channel"
        },
        "filter": {
          "type": "object",
          "description": "Event filter criteria"
        },
        "timeout": {
          "type": "string",
          "description": "Wait timeout"
        },
        "accept_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Principals to accept items from; items from others are dropped and counted (delegation@1, STANDARD v1.1 §5.15)"
        },
        "sender_check": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "How a sender must have been authenticated (agent_identity authenticated_by values); items whose sender identity says otherwise, or that carry none, are dropped and counted (identity@1, STANDARD v1.1 §5.17)"
        },
        "accept_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trust classes to accept items from; others, and items with no trust class, are dropped and counted (identity@1, STANDARD v1.1 §5.17)"
        },
        "always_ask_trust_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trust classes whose items (and items with no trust class) make any step that requires approval and uses them be asked of a person, whatever mandate would cover it (identity@1, STANDARD v1.1 §5.17)"
        }
      }
    },
    "receive.output": {
      "type": "object",
      "required": [
        "data",
        "evidence_anchors"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender": {
                "type": "string",
