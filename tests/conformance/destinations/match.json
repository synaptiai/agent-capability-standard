{
  "description": "Destination policy vectors (Agent Capability Standard 1.2.0, section 4.4.2). Normative. `patterns`: each pattern is valid or not. `matches`: with every policy in `policies` in force (an empty list of policies: none in force), the destination is allowed or not. Strings are compared by code point, with no case folding or Unicode normalisation; non-ASCII characters are written as \\u escapes.",
  "patterns": [
    {"pattern": "https://hooks.example.com/v1/send", "valid": true},
    {"pattern": "https://hooks.example.com/*", "valid": true},
    {"pattern": "https://hooks.example.com?*", "valid": true},
    {"pattern": "https://hooks.example.com/v1?*", "valid": true},
    {"pattern": "file:///srv/out/*", "valid": true},
    {"pattern": "https:*", "valid": true, "why": "scheme only: allows every https destination"},
    {"pattern": "mailto:*", "valid": true},
    {"pattern": "queue:billing.*", "valid": true},
    {"pattern": "doc#*", "valid": true},
    {"pattern": "*@example.com", "valid": true},
    {"pattern": "*.example.com", "valid": true},
    {"pattern": "ops-channel", "valid": true},
    {"pattern": "", "valid": false},
    {"pattern": "*", "valid": false},
    {"pattern": "**", "valid": false},
    {"pattern": "*@", "valid": false},
    {"pattern": "https://hooks.example.com*", "valid": false},
    {"pattern": "*example.com", "valid": false},
    {"pattern": "https://*.example.com/", "valid": false},
    {"pattern": "a*b", "valid": false},
    {"pattern": "*@example.com/*", "valid": false},
    {"pattern": "https://hooks.example.com:*", "valid": false, "why": "bypass: the authority is incomplete; it allowed https://hooks.example.com:x@evil.net/"},
    {"pattern": "https://hooks.example.*", "valid": false, "why": "bypass: the authority is incomplete; it allowed https://hooks.example.evil.net"},
    {"pattern": "https://hooks.example.com@*", "valid": false, "why": "the authority is incomplete"},
    {"pattern": "https://*", "valid": false, "why": "the authority is incomplete; use https:* to allow every https destination"}
  ],
  "matches": [
    {"policies": [], "destination": "anything", "allowed": true},
    {"policies": [[]], "destination": "anything", "allowed": false},
    {"policies": [["ops-channel"]], "destination": "ops-channel", "allowed": true},
    {"policies": [["ops-channel"]], "destination": "ops-channel2", "allowed": false},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.com/v1", "allowed": true},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.com/", "allowed": true},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.com", "allowed": false},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.com.evil.net/", "allowed": false},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.com:x@evil.net/", "allowed": false, "why": "bypass: userinfo; the valid prefix form does not match it"},
    {"policies": [["https://hooks.example.com/*"]], "destination": "https://hooks.example.evil.net/", "allowed": false},
    {"policies": [["https://hooks.example.com/*"]], "destination": "HTTPS://hooks.example.com/v1", "allowed": false},
    {"policies": [["https:*"]], "destination": "https://anywhere.example/x", "allowed": true},
    {"policies": [["*@example.com"]], "destination": "bob@example.com", "allowed": true},
    {"policies": [["*@example.com"]], "destination": "bob+ops@example.com", "allowed": true},
    {"policies": [["*@example.com"]], "destination": "first.last@example.com", "allowed": true},
    {"policies": [["*@example.com"]], "destination": "@example.com", "allowed": false},
    {"policies": [["*@example.com"]], "destination": "bob@example.com.evil", "allowed": false},
    {"policies": [["*@example.com"]], "destination": "bob@sub.example.com", "allowed": false},
    {"policies": [["*@example.com"]], "destination": "a@evil.net,b@example.com", "allowed": false, "why": "bypass: a list of recipients"},
    {"policies": [["*@example.com"]], "destination": "mailto:x@evil.net?cc=y@example.com", "allowed": false, "why": "bypass: a URL with a second recipient"},
    {"policies": [["*@example.com"]], "destination": "bob%evil.net@example.com", "allowed": false, "why": "percent-hack source route"},
    {"policies": [["*@example.com"]], "destination": "\"bob\" <bob@example.com>", "allowed": false},
    {"policies": [["*.example.com"]], "destination": "sub.example.com", "allowed": true},
    {"policies": [["*.example.com"]], "destination": "a.b-c.example.com", "allowed": true},
    {"policies": [["*.example.com"]], "destination": ".example.com", "allowed": false},
    {"policies": [["*.example.com"]], "destination": "https://evil.net/?.example.com", "allowed": false, "why": "bypass: a URL that ends with the suffix"},
    {"policies": [["*.example.com"]], "destination": "evil.net/.example.com", "allowed": false},
    {"policies": [["*.example.com"]], "destination": "bob@sub.example.com", "allowed": false},
    {"policies": [["mailto:*"]], "destination": "mailto:ops@example.com", "allowed": true},
    {"policies": [["https://a.example/*"], ["https://a.example/x/*"]], "destination": "https://a.example/y", "allowed": false},
    {"policies": [["https://a.example/*"], ["https://a.example/x/*"]], "destination": "https://a.example/x/1", "allowed": true},
    {"policies": [["https://a.example/*", "*@example.com"]], "destination": "ann@example.com", "allowed": true},
    {"policies": [["caf\u00e9/*"]], "destination": "caf\u00e9/menu", "allowed": true, "why": "NFC pattern, NFC destination"},
    {"policies": [["caf\u00e9/*"]], "destination": "cafe\u0301/menu", "allowed": false, "why": "NFC pattern, NFD destination: no normalisation"}
  ]
}
