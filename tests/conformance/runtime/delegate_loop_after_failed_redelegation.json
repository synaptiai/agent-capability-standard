{
  "description": "When a retry's re-delegation fails and a recovery loop delegates again, the new delegation still names the one it replaces.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1
          },
          "input_bindings": {
            "task": {
              "review": "x"
            },
            "agent": "a"
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m"
            }
          },
          "failure_modes": [
            {
              "condition": "The replacement could not be delegated.",
              "on_error": "R402",
              "action": "request_more_context",
              "recovery": {
                "goto_step": "ra",
                "max_loops": 1
              }
            }
          ]
        }
      ],
      "workflow_extensions": {
        "requires": [
          "wait@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "attempt": 1
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent"
      },
      "respond": {
        "kind": "LivenessLost"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "attempt": 2,
        "replaces": "t1"
      },
      "respond": {
        "kind": "Error",
        "code": "R402",
        "message": "busy"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "replaces": "t1"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t3",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "correlate": {
          "task_id": "t3"
        }
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t3"
        }
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "outputs": {
      "ra": {
        "task_id": "t3"
      }
    }
  },
  "trace_kinds": [
    "retry",
    "failure_mode_fired",
    "loop",
    "delegated"
  ]
}
