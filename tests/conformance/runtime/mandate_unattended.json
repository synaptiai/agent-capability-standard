{
  "description": "An unattended run still asks a standing mandate; an approval lets the step run.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "repo"
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "policy",
          "input_bindings": {
            "target": "config",
            "constraints": [
              "policy"
            ]
          }
        },
        {
          "capability": "mutate",
          "purpose": "mutate step",
          "store_as": "m",
          "input_bindings": {
            "target": "config",
            "operation": {
              "set": 1
            }
          },
          "approval": {
            "approver": {
              "kind": "standing_mandate",
              "mandate_ref": "mandates/nightly-sync"
            }
          }
        },
        {
          "capability": "observe",
          "purpose": "observe step",
          "store_as": "other",
          "input_bindings": {
            "target": "elsewhere"
          }
        },
        {
          "capability": "verify",
          "purpose": "verify step",
          "store_as": "v",
          "input_bindings": {
            "target": "${m.success: boolean}",
            "conditions": [
              "applied"
            ]
          }
        },
        {
          "capability": "explain",
          "purpose": "explain step",
          "store_as": "e",
          "input_bindings": {
            "conclusion": "${v.passed}"
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "approval@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "unattended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "constrain"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "compliant": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 2,
        "approver": {
          "kind": "standing_mandate"
        }
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "approved",
        "approvers": [
          "mandate"
        ],
        "digest": "{{digest}}"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "mutate",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "success": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "observe",
        "step": 3
      },
      "respond": {
        "kind": "Output",
        "value": {
          "observation": {},
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "verify",
        "step": 4
      },
      "respond": {
        "kind": "Output",
        "value": {
          "passed": true,
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "explain",
        "step": 5
      },
      "respond": {
        "kind": "Output",
        "value": {
          "explanation": "ok",
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "action_records": [
      {
        "status": "executed",
        "approval": {
          "mandate_ref": "mandates/nightly-sync",
          "decision": "approved"
        }
      }
    ]
  },
  "trace_kinds": [
    "approval_requested",
    "approval_decided"
  ]
}
