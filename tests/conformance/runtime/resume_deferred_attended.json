{
  "description": "A run that ended deferred is resumed attended: its queued step is asked afresh of a person, the request names the queued action, a checkpoint taken before the resumption authorises nothing after it, and the planned record is updated in place; the step that ran before the deferral is not asked again (STANDARD v1.2 \u00a75.14.1).",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "retrieve",
          "purpose": "retrieve step",
          "store_as": "r",
          "input_bindings": {
            "target": "config"
          }
        },
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "repo"
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "policy",
          "input_bindings": {
            "target": "config",
            "constraints": [
              "policy"
            ]
          }
        },
        {
          "capability": "mutate",
          "purpose": "mutate step",
          "store_as": "m",
          "input_bindings": {
            "target": "config",
            "operation": {
              "set": 1
            }
          },
          "approval": {
            "approver": {
              "kind": "human"
            },
            "when_unattended": "defer_to_queue"
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "approval@1"
        ]
      }
    }
  },
  "header": null,
  "workflow": "w",
  "inputs": {},
  "attendance": "unattended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "retrieve",
        "step": 0
      },
      "respond": {
        "kind": "Output",
        "value": {
          "data": "before",
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint",
        "step": 1
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "constrain",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "compliant": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "Completed",
        "outcome": "deferred",
        "deferred": [
          {
            "step": 3,
            "action_id": "run-1/w/3/0"
          }
        ]
      }
    },
    {
      "resume": {
        "attendance": "attended",
        "at": 3600000
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 3,
        "queued_action_id": "run-1/w/3/0",
        "approver": {
          "kind": "human"
        },
        "mode": "in_session",
        "shown": [
          {
            "target": "config",
            "operation": {
              "set": 1
            }
          }
        ]
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "approved",
        "approvers": [
