{
  "description": "A wait with only an R401 failure mode does not catch lost liveness: the run fails with R406.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "workflow_extensions": {
        "requires": [
          "wait@1",
          "recovery@1"
        ]
      },
      "steps": [
        {
          "capability": "receive",
          "purpose": "receive step",
          "store_as": "r",
          "timeout": "1h",
          "wait": {
            "event_type": "job.done",
            "liveness": {
              "mode": "probe",
              "interval": "1m"
            }
          },
          "failure_modes": [
            {
              "condition": "the wait expired",
              "on_error": "R401",
              "action": "escalate",
              "recovery": {
                "goto_step": "page"
              }
            }
          ]
        },
        {
          "capability": "invoke",
          "purpose": "invoke step",
          "store_as": "page",
          "handler": true,
          "workflow_id": "oncall",
          "input_bindings": {
            "workflow": "oncall",
            "input": {
              "why": "the worker is silent"
            }
          }
        }
      ]
    },
    "oncall": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "inputs": {
        "why": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "capability": "inquire",
          "purpose": "inquire step",
          "store_as": "q",
          "input_bindings": {
            "ambiguous_input": "${why}"
          }
        }
      ]
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 0,
        "deadline": 3600000
      },
      "respond": {
        "kind": "LivenessLost"
      },
      "at": 180000
    }
  ],
  "end": {
    "kind": "Failed",
    "code": "R406",
    "step": 0
  },
  "trace_kinds": [
    "step_failed"
  ]
}
