{
  "description": "verdicts may be one reference to a single verdict, such as one reviewer's result.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "a",
            "read_only": true
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m",
              "failure_threshold": 3
            }
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "gate",
          "input_bindings": {
            "target": "${change}",
            "constraints": [
              "one approval"
            ],
            "action_on_violation": "block"
          },
          "quorum": {
            "verdicts": "${ra.result: object}",
            "reviewers": [
              "ra"
            ],
            "vocabulary": [
              "approve",
              "request_changes"
            ],
            "pass_values": [
              "approve"
            ],
            "min_pass": 1,
            "pinned_to": "${change}"
          }
        }
      ],
      "inputs": {
        "change": {
          "type": "string",
          "required": true
        }
      },
      "workflow_extensions": {
        "requires": [
          "wait@1",
          "delegation@1",
          "quorum@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {
    "change": "c1"
  },
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "step": 0
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t1",
          "agent": "a",
          "effective": {
            "read_only": true
          },
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 0
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t1",
          "reviewer_id": "a",
          "value": "approve",
          "pinned": "c1"
        },
        "principal": "a"
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "outputs": {
      "gate": {
        "compliant": true,
        "tally": {
          "passes": 1
        }
      }
    }
  },
  "trace_kinds": [
    "quorum"
  ]
}
