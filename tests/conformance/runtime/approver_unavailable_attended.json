{
  "description": "In an attended run an unavailable approver means the step cannot go ahead (F502).",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "repo"
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "policy",
          "input_bindings": {
            "target": "config",
            "constraints": [
              "policy"
            ]
          }
        },
        {
          "capability": "mutate",
          "purpose": "mutate step",
          "store_as": "m",
          "input_bindings": {
            "target": "config",
            "operation": {
              "set": 1
            }
          },
          "approval": {
            "approver": {
              "kind": "human"
            }
          }
        },
        {
          "capability": "observe",
          "purpose": "observe step",
          "store_as": "other",
          "input_bindings": {
            "target": "elsewhere"
          }
        },
        {
          "capability": "verify",
          "purpose": "verify step",
          "store_as": "v",
          "input_bindings": {
            "target": "${m.success: boolean}",
            "conditions": [
              "applied"
            ]
          }
        },
        {
          "capability": "explain",
          "purpose": "explain step",
          "store_as": "e",
          "input_bindings": {
            "conclusion": "${v.passed}"
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "approval@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "constrain"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "compliant": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 2
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "unavailable",
        "approvers": [],
        "digest": "{{digest}}"
      }
    }
  ],
  "end": {
    "kind": "Failed",
    "code": "F502",
    "action_records": [
      {
        "status": "rejected",
        "reason": "the approver was unavailable"
      }
    ]
  },
  "trace_kinds": []
}
