{
  "description": "require_distinct_identities: two reviewers whose hosts attest different principals both count.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
