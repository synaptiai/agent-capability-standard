          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "a",
            "read_only": true
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m",
              "failure_threshold": 3
            }
          }
        },
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "rb",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "b",
            "read_only": true
