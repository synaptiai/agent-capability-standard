      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 1
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t2",
          "reviewer_id": "b",
          "value": "approve",
          "pinned": "c1"
        },
        "principal": "rev-b"
