              "${rb.result: object}"
            ],
            "reviewers": [
              "ra",
              "rb"
            ],
            "vocabulary": [
              "approve",
              "request_changes"
            ],
            "pass_values": [
              "approve"
            ],
            "blocking_values": [
              "request_changes"
            ],
            "min_pass": 2,
            "pinned_to": "${change}",
            "require_read_only": true,
            "require_distinct_identities": true
          }
        }
      ],
      "inputs": {
        "change": {
          "type": "string",
          "required": true
        }
      },
      "workflow_extensions": {
        "requires": [
          "wait@1",
          "delegation@1",
          "quorum@1",
          "identity@1"
        ]
      }
    }
