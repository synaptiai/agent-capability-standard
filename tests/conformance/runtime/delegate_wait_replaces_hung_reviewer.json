{
  "description": "A delegate step that waits delegates, then awaits that delegation's result (correlated by task_id). When reviewer b goes silent (R406), its retry delegates again; reviewer a is not asked again, and the quorum counts both results.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "a",
            "read_only": true
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m",
              "failure_threshold": 3
            }
          }
        },
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "rb",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "b",
            "read_only": true
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m",
              "failure_threshold": 3
            }
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "gate",
          "input_bindings": {
            "target": "${change}",
            "constraints": [
              "two approvals"
            ],
            "action_on_violation": "block"
          },
          "quorum": {
            "verdicts": [
              "${ra.result: object}",
              "${rb.result: object}"
            ],
            "reviewers": [
              "ra",
              "rb"
            ],
            "vocabulary": [
              "approve",
              "request_changes"
            ],
            "pass_values": [
              "approve"
            ],
            "blocking_values": [
              "request_changes"
            ],
            "min_pass": 2,
            "pinned_to": "${change}",
            "require_read_only": true
          }
        }
      ],
      "inputs": {
        "change": {
          "type": "string",
          "required": true
        }
      },
      "workflow_extensions": {
        "requires": [
          "wait@1",
          "delegation@1",
          "quorum@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {
    "change": "c1"
  },
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "step": 0,
        "attempt": 1,
        "inputs": {
          "read_only": true
        }
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t1",
          "agent": "a",
          "effective": {
            "read_only": true
          },
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 0,
        "correlate": {
          "task_id": "t1"
        }
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t1",
          "reviewer_id": "a",
          "value": "approve",
          "pinned": "c1"
        },
        "principal": "a"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "step": 1,
        "attempt": 1
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t2",
          "agent": "b",
          "effective": {
            "read_only": true
          },
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 1,
        "correlate": {
          "task_id": "t2"
        }
      },
      "respond": {
        "kind": "LivenessLost"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "step": 1,
        "attempt": 2,
        "replaces": "t2"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t3",
          "agent": "b",
          "effective": {
            "read_only": true
          },
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 1,
        "correlate": {
          "task_id": "t3"
        }
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t3",
          "reviewer_id": "b",
          "value": "approve",
          "pinned": "c1"
        },
        "principal": "b"
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "outputs": {
      "ra": {
        "task_id": "t1",
        "result": {
          "reviewer_id": "a",
          "sender": "a"
        }
      },
      "rb": {
        "task_id": "t3",
        "result": {
          "reviewer_id": "b"
        }
      },
      "gate": {
        "compliant": true,
        "tally": {
          "passes": 2,
          "voters": [
            "a",
            "b"
          ]
        }
      }
    }
  },
  "trace_kinds": [
    "delegated",
    "retry",
    "event_received",
    "quorum"
  ]
}
