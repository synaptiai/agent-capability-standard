{
  "description": "The executor's own rollback after a send: the host restored what the checkpoint captured and lists the transmission as not covered (transmitted); the run records it and ends as the failure mode says (\u00a74.4.1, \u00a74.4.2).",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "report_state"
          }
        },
        {
          "capability": "send",
          "purpose": "send step",
          "store_as": "s",
          "input_bindings": {
            "destination": "ops",
            "payload": {
              "report": 1
            }
          }
        },
        {
          "capability": "verify",
          "purpose": "verify step",
          "store_as": "v",
          "input_bindings": {
            "conditions": [
              "delivered"
            ]
          },
          "failure_modes": [
            {
              "condition": "not delivered",
              "when": "${v.passed} == false",
              "action": "rollback"
            }
          ]
        }
      ]
    }
  },
  "header": null,
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint",
        "step": 0
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 1
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "approved",
        "approvers": [
          "alice"
        ],
        "digest": "{{digest}}"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "send",
        "step": 1,
        "idempotency_key": "run-1:3"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "sent": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "verify",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "passed": false,
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "Rollback",
        "step": 2,
        "checkpoint_id": "cp1"
      },
      "respond": {
        "kind": "RolledBack",
        "not_covered": [
          {
            "item": "send to ops (run-1:3)",
            "reason": "transmitted"
          }
        ]
      }
    }
  ],
  "end": {
    "kind": "Failed",
    "code": "R402",
    "step": 2
  },
  "trace_kinds": [
    "failure_mode_fired",
    "rolled_back"
  ]
}
