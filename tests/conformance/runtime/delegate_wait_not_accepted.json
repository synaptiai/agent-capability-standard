{
  "description": "A delegation the host did not accept is an R402, retried like any other: the step delegates again before it waits.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "x"
            },
            "agent": "a"
          },
          "wait": {
            "event_type": "review.done"
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "wait@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "attempt": 1
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": false,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "attempt": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t9",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "correlate": {
          "task_id": "t9"
        }
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t9"
        }
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "outputs": {
      "ra": {
        "task_id": "t9"
      }
    }
  },
  "trace_kinds": [
    "retry",
    "delegated"
  ]
}
