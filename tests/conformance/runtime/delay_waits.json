{
  "description": "A delay sleeps before the step; like a wait it invalidates the checkpoint taken before it, so the later mutation needs a new one.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "repo"
          }
        },
        {
          "capability": "observe",
          "purpose": "observe step",
          "store_as": "o",
          "input_bindings": {
            "target": "y"
          },
          "delay": "1m"
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "policy",
          "input_bindings": {
            "target": "config",
            "constraints": [
              "policy"
            ]
          }
        },
        {
          "capability": "mutate",
          "purpose": "mutate step",
          "store_as": "m",
          "input_bindings": {
            "target": "config",
            "operation": {
              "set": 1
            }
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "wait@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint",
        "step": 0
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "Sleep",
        "until": 60000
      }
    },
    {
      "tick": 60000
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "observe",
        "step": 1
      },
      "respond": {
        "kind": "Output",
        "value": {
          "observation": {},
          "confidence": 1,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "constrain",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "compliant": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 3
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "approved",
        "approvers": [
          "alice"
        ],
        "digest": "{{digest}}"
      }
    },
    {
      "expect": {
        "kind": "CreateCheckpoint",
        "step": 3
      },
      "respond": {
        "kind": "Checkpoint",
        "checkpoint_id": "cp2"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "mutate",
        "step": 3
      },
      "respond": {
        "kind": "Output",
        "value": {
          "success": true,
          "evidence_anchors": []
        }
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed"
  },
  "trace_kinds": [
    "delay_started",
    "delay_finished",
    "checkpoints_invalidated",
    "checkpoint_created"
  ]
}
