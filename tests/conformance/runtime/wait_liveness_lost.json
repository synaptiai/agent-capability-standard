{
  "description": "A source that stops answering ends the wait with R406, not the R401 of a timeout.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "receive",
          "purpose": "receive step",
          "store_as": "r",
          "timeout": "1h",
          "wait": {
            "event_type": "job.done",
            "liveness": {
              "mode": "probe",
              "interval": "1m"
            }
          }
        }
      ],
      "workflow_extensions": {
        "requires": [
          "wait@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {},
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "AwaitEvent",
        "liveness": {
          "mode": "probe",
          "interval": "1m"
        }
      },
      "respond": {
        "kind": "LivenessLost"
      }
    }
  ],
  "end": {
    "kind": "Failed",
    "code": "R406"
  },
  "trace_kinds": []
}
