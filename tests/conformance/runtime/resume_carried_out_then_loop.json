{
  "description": "A re-entered queued step whose action is carried out, and which a failure mode's when then loops back to, runs again as a new action: the second request names no queued action, and the action carried out keeps its record and approval beside the new one's, as in a run that never deferred (\u00a75.14.1).",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "checkpoint",
          "purpose": "checkpoint step",
          "store_as": "cp",
          "input_bindings": {
            "scope": "repo"
          }
        },
        {
          "capability": "constrain",
          "purpose": "constrain step",
          "store_as": "policy",
          "input_bindings": {
            "target": "config",
            "constraints": [
              "policy"
            ]
          }
        },
        {
          "capability": "mutate",
          "purpose": "mutate step",
          "store_as": "m",
          "input_bindings": {
            "target": "config",
            "operation": {
              "set": 1
            }
          },
          "approval": {
            "approver": {
              "kind": "human"
            },
            "when_unattended": "defer_to_queue"
          },
          "failure_modes": [
            {
              "condition": "the change did not apply",
              "when": "${m.success} == false",
              "action": "request_more_context",
              "recovery": {
                "goto_step": "m",
                "max_loops": 1
              }
            }
          ]
        }
      ],
      "workflow_extensions": {
        "requires": [
          "approval@1",
          "recovery@1"
        ]
      }
    }
  },
  "header": null,
  "workflow": "w",
  "inputs": {},
  "attendance": "unattended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "checkpoint"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "checkpoint_id": "cp1",
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "constrain"
      },
      "respond": {
        "kind": "Output",
        "value": {
          "compliant": true,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "Completed",
        "outcome": "deferred",
        "deferred": [
          {
            "step": 2,
            "action_id": "run-1/w/2/0"
          }
        ]
      }
    },
    {
      "resume": {
        "attendance": "attended",
        "at": 3600000
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 2,
        "queued_action_id": "run-1/w/2/0",
        "approver": {
          "kind": "human"
        }
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d1",
        "decision": "approved",
        "approvers": [
          "alice"
        ],
        "digest": "{{digest}}"
      }
    },
    {
      "expect": {
        "kind": "CreateCheckpoint",
        "step": 2
      },
      "respond": {
        "kind": "Checkpoint",
        "checkpoint_id": "cp2"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "mutate",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "success": false,
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "RequestApproval",
        "step": 2,
        "approver": {
          "kind": "human"
        }
      },
      "respond": {
        "kind": "Decision",
        "decision_id": "d2",
        "decision": "approved",
        "approvers": [
          "bob"
        ],
        "digest": "{{digest}}"
      }
    },
    {
      "expect": {
        "kind": "CreateCheckpoint",
        "step": 2
      },
      "respond": {
        "kind": "Checkpoint",
        "checkpoint_id": "cp3"
      }
    },
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "mutate",
        "step": 2
      },
      "respond": {
        "kind": "Output",
        "value": {
          "success": true,
          "evidence_anchors": []
        }
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "deferred": [],
    "action_records": [
      {
        "action_id": "run-1/w/2/0",
        "status": "executed",
        "approval": {
          "approvers": [
            "alice"
          ]
        }
      },
      {
        "action_id": "run-1/w/2/1",
        "status": "executed",
        "approval": {
          "approvers": [
            "bob"
          ]
        }
      }
    ]
  },
  "trace_kinds": [
    "run_resumed",
    "loop"
  ]
}
