{
  "description": "Without identity@1 an attested identity is not read: the wait carries no delegate_principal, and a correlated result from another principal is kept.",
  "catalog": {
    "w": {
      "goal": "g",
      "risk": "high",
      "spec_version": "1.1",
      "steps": [
        {
          "capability": "delegate",
          "purpose": "delegate step",
          "store_as": "ra",
          "timeout": "2h",
          "retry": {
            "max": 1,
            "backoff": "none"
          },
          "input_bindings": {
            "task": {
              "review": "${change}"
            },
            "agent": "a",
            "read_only": true
          },
          "wait": {
            "event_type": "review.done",
            "liveness": {
              "mode": "push",
              "interval": "10m",
              "failure_threshold": 3
            }
          }
        }
      ],
      "inputs": {
        "change": {
          "type": "string",
          "required": true
        }
      },
      "workflow_extensions": {
        "requires": [
          "wait@1",
          "delegation@1"
        ]
      }
    }
  },
  "workflow": "w",
  "inputs": {
    "change": "c1"
  },
  "attendance": "attended",
  "start": 0,
  "script": [
    {
      "expect": {
        "kind": "InvokeCapability",
        "capability": "delegate",
        "step": 0
      },
      "respond": {
        "kind": "Output",
        "value": {
          "accepted": true,
          "task_id": "t1",
          "agent": "a",
          "effective": {
            "read_only": true,
            "identity": {
              "principal": "rev-a",
              "kind": "agent"
            }
          },
          "evidence_anchors": []
        }
      }
    },
    {
      "expect": {
        "kind": "AwaitEvent",
        "step": 0
      },
      "respond": {
        "kind": "Event",
        "event": {
          "event_type": "review.done",
          "task_id": "t1",
          "reviewer_id": "a",
          "value": "approve",
          "pinned": "c1"
        },
        "principal": "anyone"
      }
    }
  ],
  "end": {
    "kind": "Completed",
    "outcome": "completed",
    "outputs": {
      "ra": {
        "result": {
          "sender": "anyone"
        }
      }
    }
  },
  "trace_kinds": [
    "delegated",
    "event_received"
  ]
}
