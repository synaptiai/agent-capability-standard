{
  "description": "Inquiry answer vectors (Agent Capability Standard 1.2.0, section 5.13.1). Normative for what a host may deliver. `inquiry` is an inquire output and `item` a receive item (or event) that answers it. A case with `expect` is an item a host may deliver: `expect` maps each answered question's key (its `id`, or its `parameter` when it has no id) to the answer's value; unanswered questions are left out. A case with `error` is an item a host MUST NOT deliver, and names why: `other_inquiry` (its inquiry_id is not a string equal to the inquiry's; an inquiry without a string inquiry_id has no answers a host may deliver), `unknown_question` (a question_id names no question of the inquiry), `wrong_type` (a value that does not have its question's answer_type: text a string, choice equal as a JSON value to one of the question's options, where a boolean never equals a number and numbers compare by value, boolean a boolean, number a number that is not a boolean), `duplicate_answer` (a question answered twice), `malformed` (answers is not a list of objects with a string question_id).",
  "cases": [
    {"name": "keyed by id", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "q1", "value": "orders"}]}, "expect": {"q1": "orders"}},
    {"name": "keyed by parameter", "inquiry": {"inquiry_id": "inq-1", "questions": [{"question": "Which table?", "parameter": "table"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "table", "value": "orders"}]}, "expect": {"table": "orders"}},
    {"name": "unanswered questions are left out", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}, {"id": "q2", "question": "How many rows?", "answer_type": "number"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "q2", "value": 10}]}, "expect": {"q2": 10}},
    {"name": "number and choice", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "rows", "question": "How many?", "answer_type": "number"}, {"id": "mode", "question": "Which mode?", "answer_type": "choice", "options": ["fast", "safe"]}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "rows", "value": 2.5}, {"question_id": "mode", "value": "safe"}]}, "expect": {"rows": 2.5, "mode": "safe"}},
    {"name": "boolean", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "ok", "question": "Go ahead?", "answer_type": "boolean"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "ok", "value": false}]}, "expect": {"ok": false}},
    {"name": "no answer_type takes any value", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Anything?"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "q1", "value": {"free": "form"}}]}, "expect": {"q1": {"free": "form"}}},
    {"name": "a numeric choice compares by value", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "m", "question": "Which level?", "answer_type": "choice", "options": [1, 2]}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "m", "value": 2.0}]}, "expect": {"m": 2.0}},
    {"name": "boolean of the wrong type", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "ok", "question": "Go ahead?", "answer_type": "boolean"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "ok", "value": "yes"}]}, "error": "wrong_type"},
    {"name": "a boolean is not a number", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "rows", "question": "How many?", "answer_type": "number"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "rows", "value": true}]}, "error": "wrong_type"},
    {"name": "choice outside the options", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "mode", "question": "Which mode?", "answer_type": "choice", "options": ["fast", "safe"]}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "mode", "value": "reckless"}]}, "error": "wrong_type"},
    {"name": "a boolean is not a numeric choice", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "m", "question": "Which level?", "answer_type": "choice", "options": [1, 0]}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "m", "value": true}]}, "error": "wrong_type"},
    {"name": "a number is not a boolean choice", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "m", "question": "Strict?", "answer_type": "choice", "options": [true, false]}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "m", "value": 0}]}, "error": "wrong_type"},
    {"name": "an unknown question", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "q9", "value": "x"}]}, "error": "unknown_question"},
    {"name": "another inquiry", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}]}, "item": {"inquiry_id": "inq-2", "answers": [{"question_id": "q1", "value": "x"}]}, "error": "other_inquiry"},
    {"name": "an inquiry without an inquiry_id", "inquiry": {"questions": [{"id": "q", "question": "Which table?", "answer_type": "text"}]}, "item": {"answers": [{"question_id": "q", "value": "x"}]}, "error": "other_inquiry"},
    {"name": "an item without an inquiry_id", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q", "question": "Which table?", "answer_type": "text"}]}, "item": {"answers": [{"question_id": "q", "value": "x"}]}, "error": "other_inquiry"},
    {"name": "a question answered twice", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}]}, "item": {"inquiry_id": "inq-1", "answers": [{"question_id": "q1", "value": "a"}, {"question_id": "q1", "value": "b"}]}, "error": "duplicate_answer"},
    {"name": "answers is not a list", "inquiry": {"inquiry_id": "inq-1", "questions": [{"id": "q1", "question": "Which table?", "answer_type": "text"}]}, "item": {"inquiry_id": "inq-1", "answers": {"q1": "a"}}, "error": "malformed"}
  ]
}
