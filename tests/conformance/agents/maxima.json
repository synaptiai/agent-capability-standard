    {"name": "no capability", "capabilities": [], "read_only": false, "maxima": {"risk": "low", "mutation": false, "requires_checkpoint": false, "requires_approval": false}},
    {"name": "delegate only", "capabilities": ["delegate"], "read_only": false, "maxima": {"risk": "medium", "mutation": false, "requires_checkpoint": false, "requires_approval": false}},
