        {
          "id": "person:acme/hr/employee/12345",
          "type": "person",
          "attributes": {
            "employee_id": "12345",
            "email": "kari@acme.example"
          }
        },
        {
          "id": "person:acme/crm/contact/889",
          "type": "person",
          "attributes": {
            "employee_id": "12345"
          }
        }
      ],
      "into": "person:acme/hr/employee/12345",
      "unique_attributes": [
        "serial",
        "employee_id"
      ],
      "expect": {
        "ok": true,
        "lineage": {
          "operation": "merge",
          "class": "person",
          "from": [
            "person:acme/hr/employee/12345",
