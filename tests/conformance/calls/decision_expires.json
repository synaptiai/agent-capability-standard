{
  "description": "A recorded decision expires after the binding's approval.expires.",
  "ontology": "2.2.0",
  "needs": [
    "recorded_approval"
  ],
  "bindings": [
    {
      "tool": "save",
      "ontology": "2.2.0",
      "capability": "checkpoint"
    },
    {
      "tool": "write",
      "ontology": "2.2.0",
      "capability": "mutate",
      "approval": {
        "expires": "10m"
      }
    },
    {
      "tool": "undo",
      "ontology": "2.2.0",
      "capability": "rollback"
    },
    {
      "tool": "done",
      "ontology": "2.2.0",
      "control": true
    },
    {
      "tool": "batch",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "write"
      ]
    },
    {
      "tool": "fix",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "undo"
      ]
    },
    {
      "tool": "solo",
      "ontology": "2.2.0",
      "capability": "invoke"
    },
    {
      "tool": "apply",
      "ontology": "2.2.0",
      "capability": "plan",
      "additional_capabilities": [
        "mutate"
      ]
    }
  ],
  "sequence": [
    {
      "call": "write",
      "args": {
        "path": "a"
      },
      "approve": [
        "alice"
      ],
      "expect": {
        "refuse": "F501"
      }
    },
    {
      "expire": "decision"
    },
    {
      "call": "save",
      "expect": "run"
    },
    {
      "call": "write",
      "args": {
        "path": "a"
      },
      "expect": {
        "refuse": "F502"
      }
    }
  ]
}
