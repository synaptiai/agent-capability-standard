{
  "description": "Under a destination policy, a layer that does not see a composite's nested calls refuses with F504 a composite whose invokes reach, directly or through another composite, a binding that performs send, before approval and the checkpoint; a send of its own is checked by its destination.",
  "ontology": "2.2.0",
  "without": [
    "nested_calls"
  ],
  "destination_policy": [
    "https://hooks.example.com/*"
  ],
  "bindings": [
    {
      "tool": "save",
      "ontology": "2.2.0",
      "capability": "checkpoint"
    },
    {
      "tool": "write",
      "ontology": "2.2.0",
      "capability": "mutate"
    },
    {
      "tool": "undo",
      "ontology": "2.2.0",
      "capability": "rollback"
    },
    {
      "tool": "done",
      "ontology": "2.2.0",
      "control": true
    },
    {
      "tool": "batch",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "write"
      ]
    },
    {
      "tool": "fix",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "undo"
      ]
    },
    {
      "tool": "solo",
      "ontology": "2.2.0",
      "capability": "invoke"
    },
    {
      "tool": "apply",
      "ontology": "2.2.0",
      "capability": "plan",
      "additional_capabilities": [
        "mutate"
      ]
    },
    {
      "tool": "notify",
      "ontology": "2.2.0",
      "capability": "send",
      "destination": "/to"
    },
    {
      "tool": "relay",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "notify"
      ]
    },
    {
      "tool": "outer",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "relay"
      ]
    }
  ],
  "sequence": [
    {
      "call": "save",
      "expect": "run"
    },
    {
      "call": "relay",
      "approve": [
        "alice"
      ],
      "expect": {
        "refuse": "F504"
      }
    },
    {
      "call": "outer",
      "approve": [
        "alice"
      ],
      "expect": {
        "refuse": "F504"
      }
    },
    {
      "call": "notify",
      "args": {
        "to": "https://elsewhere.example.net/a"
      },
      "approve": [
        "alice"
      ],
      "expect": {
        "refuse": "F504"
      }
    },
    {
      "call": "notify",
      "args": {
        "to": "https://hooks.example.com/a"
      },
      "approve": [
        "alice"
      ],
      "expect": "run"
    }
  ]
}
