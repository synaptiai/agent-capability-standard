{
  "description": "A call whose output is refused has run: it used its checkpoint, and the next call needs a new one.",
  "ontology": "2.2.0",
  "bindings": [
    {
      "tool": "save",
      "ontology": "2.2.0",
      "capability": "checkpoint"
    },
    {
      "tool": "write",
      "ontology": "2.2.0",
      "capability": "mutate"
    },
    {
      "tool": "undo",
      "ontology": "2.2.0",
      "capability": "rollback"
    },
    {
      "tool": "done",
      "ontology": "2.2.0",
      "control": true
    },
    {
      "tool": "batch",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "write"
      ]
    },
    {
      "tool": "fix",
      "ontology": "2.2.0",
      "capability": "invoke",
      "invokes": [
        "undo"
      ]
    },
    {
      "tool": "solo",
      "ontology": "2.2.0",
      "capability": "invoke"
    },
    {
      "tool": "apply",
      "ontology": "2.2.0",
      "capability": "plan",
      "additional_capabilities": [
        "mutate"
      ]
    }
  ],
  "sequence": [
    {
      "call": "save",
      "expect": "run"
    },
    {
      "call": "write",
      "args": {
        "path": "a"
      },
      "approve": [
        "alice"
      ],
      "returns": {
        "success": true
      },
      "expect": {
        "refuse_output": "R402"
      }
    },
    {
      "call": "write",
      "args": {
        "path": "b"
      },
      "approve": [
        "alice"
      ],
      "expect": {
        "refuse": "F501"
      }
    },
    {
      "call": "save",
      "expect": "run"
    },
    {
      "call": "write",
      "args": {
        "path": "b"
      },
      "approve": [
        "alice"
      ],
      "expect": "run"
    }
  ]
}
