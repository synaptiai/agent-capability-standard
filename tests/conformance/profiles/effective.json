{
  "description": "Domain profile effect vectors (Agent Capability Standard 1.2.0, section 5.21.3). Normative. `flags`: the effective flags (section 5.2.1) of a step or call of `capability`, with its own `declared` flags, under the profiles given, and whether a person must decide. `policy`: the rules the profiles put in force besides flags. The profiles load without error.",
  "standard": "1.2.0",
  "ontology": "2.2.0",
  "section": "5.21.3",
  "status": "normative",
  "fields": {
    "name": "The vector's id.",
    "about": "The rule it pins.",
    "profiles": "The profiles applied, in order.",
    "capability": "flags: the step's capability.",
    "declared": "flags: the step's own risk and flags, if any.",
    "expect": "flags: {risk, mutation, requires_checkpoint, requires_approval, person}. policy: {minimum_confidence (the highest, or null), grounding ([{require, kinds}], one per profile with require_grounding, kinds null for any kind), destinations (one list per profile that sets allowed_destinations), trust_weights (the lowest per key)}."
  },
  "flags": [
    {
      "name": "no_profile_mutate",
      "about": "no profile: the ontology's flags",
      "profiles": [],
      "capability": "mutate",
      "expect": {
        "risk": "high",
        "mutation": true,
        "requires_checkpoint": true,
        "requires_approval": true,
        "person": false
      }
    },
    {
      "name": "review_low_retrieve",
