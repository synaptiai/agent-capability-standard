          "risk_thresholds": {
            "require_review": "low"
          }
        }
      ],
      "capability": "retrieve",
      "expect": {
        "risk": "low",
        "mutation": false,
        "requires_checkpoint": false,
        "requires_approval": true,
        "person": false
      }
    },
