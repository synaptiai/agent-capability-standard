{
  "description": "Domain profile load vectors (Agent Capability Standard 1.2.0, section 5.21.2). Normative. Each vector gives the profiles applied together, in order, and the diagnostics loading them reports: errors and warnings, each with its code, its location.profile (the profile's domain, or #<i>, its zero-based position, when it has no valid domain) and its location.field. Both lists are exact; their order is free.",
  "standard": "1.2.0",
  "ontology": "2.2.0",
  "section": "5.21.2",
  "status": "normative",
  "fields": {
    "name": "The vector's id.",
    "about": "The rule it pins.",
    "profiles": "The profiles given, in order.",
    "expect.errors": "Every error diagnostic, as {code, profile, field}.",
    "expect.warnings": "Every warning diagnostic, as {code, profile, field}."
  },
  "vectors": [
    {
      "name": "minimal",
      "about": "domain and version are all a profile needs",
      "profiles": [
        {
          "domain": "d",
          "version": "1.0.0"
        }
      ],
      "expect": {
        "errors": [],
        "warnings": []
      }
    },
    {
