{
  "name": "agent-capability-standard",
  "version": "2.0.0",
  "description": "Grounded Agency: 36 atomic capabilities across 9 cognitive layers with typed contracts, safety-by-construction, and grounded reasoning for reliable AI agents",
  "author": {
    "name": "Agent Capability Standard Contributors",
    "url": "https://github.com/synaptiai/agent-capability-standard"
  },
  "homepage": "https://acs.synapti.ai/",
  "repository": "https://github.com/synaptiai/agent-capability-standard",
  "license": "Apache-2.0",
  "keywords": [
    "ai-capabilities",
    "agent-skills",
    "world-modeling",
    "perception",
    "reasoning",
    "generation",
    "agentic"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "remote": {
      "command": "/usr/bin/env",
      "args": [
        "-u",
        "DEVELOPER_DIR",
        "-u",
        "TOOLCHAINS",
        "-u",
        "SDKROOT",
        "/usr/bin/python3",
        "-I",
        "${CLAUDE_PLUGIN_ROOT}/grounded_agency/remote_writes.py",
        "serve"
      ]
    }
  }
}
