.loadProfiles().map((p) => p.profileFile));\n      break;\n    default:\n      break;\n  }\n  const all = [...new Set([...own, ...extra])].sort();\n  if (all.length === 0) throw new Error(`page-dates: ${route.url} (${route.template}) names no file it is built from`);\n  return all;\n}\n\n/** The latest of the dates of a page's files, or null when none of them is in the history yet. */\nexport function pageLastModified(route: Route, dates: ReadonlyMap<string, string> = fileDates()): string | null {\n  let best: string | null = null;\n  let bestMs = -Infinity;\n  for (const p of pageSources(route)) {\n    const d = dates.get(p);\n    if (d === undefined) continue;\n    const ms = Date.parse(d);\n    if (ms > bestMs) {\n      best = d;\n      bestMs = ms;\n    }\n  }\n  return best;\n}\n\nexport interface Skill {\n  entry: SkillEntry;\n  source: string;\n  bytes: Buffer;\n}\n\n/** The front matter of a SKILL.md as an object. */\nexport function skillFrontmatter(text: string, source: string): { name: string; description: string } {\n  const m = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n/.exec(text);\n  if (!m) throw new Error(`agent-skills: ${source} has no front matter`);\n  const fm = parse(m[1]!) as Record<string, unknown>;\n  if (typeof fm.name !== 'string' || typeof fm.description !== 'string') throw new Error(`agent-skills: ${source} lacks a name or description`);\n  return { name: fm.name, description: fm.description.trim() };\n}\n\nexport function sha256(bytes: Buffer): string {\n  return `sha256:${createHash('sha256').update(bytes).digest('hex')}`;\n}\n\nlet cached: Skill[] | undefined;\n      required: ['query'],\n      additionalProperties: false,\n    },\n    annotations: readOnly,\n    async execute(input) {\n      const query = stringArg(input, 'query');\n      const raw = input?.limit;\n      const limit =\n        raw === undefined ? SEARCH_LIMIT_DEFAULT : Number.isInteger(raw) ? Math.min(Math.max(raw as number, 1), SEARCH_LIMIT_MAX) : NaN;\n      if (Number.isNaN(limit)) throw new Error(`\"limit\" must be an integer from 1 to ${SEARCH_LIMIT_MAX}.`);\n      const pf = await deps.loadPagefind();\n      if (!pf) throw new Error('The search index could not load. Try again, or read /llms.txt for a list of pages.');\n      const found = await pf.search(query);\n      const all = found?.results ?? [];\n      // Keep only results that really match every query word, as the search\n      // dialog does (lib/search-match.ts): Pagefind also returns pages matched\n      // on a one-letter prefix of a made-up word.\n      const items: PagefindResultData[] = [];\n      for (let i = 0; i < all.length && items.length < limit; i += limit) {\n        const batch = await Promise.all(all.slice(i, i + limit).map((r) => r.data()));\n        for (const r of batch) {\n          const matched = [...wordsAt(r.content, r.locations), ...(r.meta.title ?? '').split(/\\s+/)];\n          if (items.length < limit && isRealMatch(query, matched)) items.push(r);\n        }\n      }\n      if (items.length === 0) return `No pages match \"${query}\".`;","is_error":false}]},"uuid":"bc223e51-539a-417f-9dfd-e49e89628503","timestamp":"2026-11-13T15:47:37.701Z","toolUseResult":{"stdout":"49:class RpcError extends Error {\n50-  constructor(\n51-    readonly code: number,\n52-    message: string,\n53-    readonly status = 200,\n54-    readonly data?: unknown,\n55-  ) {\n56-    super(message);\n57-  }\n--\n67:function rpcError(id: Id | null, e: RpcError): Response {\n68-  return json({ jsonrpc: '2.0', id, error: { code: e.code, message: e.message, ...(e.data === undefined ? {} : { data: e.data }) } }, e.status);\n69-}\n70-\n71-/** A valid serialized origin (\"https://example.com\"), or \"null\". */\n72-function validOrigin(value: string): boolean {\n73-  if (value === 'null') return true;\n74-  try {\n75-    const u = new URL(value);\n--\n244:export function mcpInternalError(): Response {\n245-  return rpcError(null, new RpcError(-32603, 'Internal error', 500))