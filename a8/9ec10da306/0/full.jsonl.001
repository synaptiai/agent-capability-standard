form', () => {\n25\t    expect(stripComments('a<!<!-- x -->-- y -->b')).toBe('ab');\n26\t  });\n27\t  it('drops the rest after an unclosed comment', () => {\n28\t    expect(stripComments('a<!-- b')).toBe('a');\n29\t  });\n30\t});"}]}}
