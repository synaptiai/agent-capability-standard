 and their Markdown copies', () => {","   it('answers Accept: text/markdown on a page with its Markdown copy, Vary and a canonical link', async () => {","     const res = await get('/', { Accept: 'text/markdown' });"]}]}],"moreFiles":0,"changedFiles":["/Users/danielbentes/agent-capability-standard/.claude/worktrees/i-signals/site/test/agent-discovery.test.ts","/Users/danielbentes/agent-capability-standard/.claude/worktrees/i-signals/site/test/worker.test.ts"]}},"sandboxed":false,"sourceToolAssistantUUID":"39222767-804c-4658-a1c6-0bc9f767b649","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i-signals/site","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/content-signals","slug":"i-just-came-across-imperative-newell"}
