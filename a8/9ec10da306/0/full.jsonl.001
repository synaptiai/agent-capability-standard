{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"f8b100f67057d360b03e2ef3a22d74fee2f41883d65faa3bb596eb1484252336","message":{"role":"user","content":[{"tool_use_id":"toolu_014xHjxPf1Xk6TmAyeRoFoDS","type":"tool_result","content":"174:  it('answers Accept: text/markdown on a page with its Markdown copy, Vary and a canonical link', async () => {\n201:  it('serves <page>.md as the page\\'s Markdown copy', async () => {\n209:  it('serves <page>/index.md with the Markdown type and a canonical link', async () => {\n216:  it('keeps the static file\\'s ETag and CORS header on a Markdown answer', async () => {\n228:  it('answers a conditional request for a fresh Markdown copy with 304', async () => {\n242:  it('gives GPTBot, ClaudeBot, PerplexityBot and the user fetchers Markdown even when they ask for HTML', async () => {\n264:  it('leaves static assets untouched and does not look for a Markdown copy', async () => {\n318:  it('answers a <page>.md with no page with a Markdown 404', async () => {\n655:  it('read_page returns the Markdown copy for a listed page, however its path is written', async () => {\n1034:  it('sends its Markdown copy to the copy of the page it redirects to', async () => {\n27:const BASE = 'https://acs.synapti.ai';\n28-\n29-const HOME_MD = '# Agent Capability Standard\\n\\nHome page copy.\\n';\n30-const MUTATE_MD = '# mutate\\n\\nChange persistent state\\n';\n31-const GUIDE_MD = '# Getting started\\n\\nInstall the plugin.\\n';\n32-// A long page: 30 lines of 1,000 characters (30,030 with newlines) under\n33-// \"## Alpha\", then \"## Beta\" with a subsection, a fenced \"## Not a heading\",\n34-// and \"## Gamma\". Section texts are written out in the tests.\n35-const LINE = 'x'.repeat(1000);\n36-const BETA = '## Beta\\n\\nBeta text.\\n\\n### Beta detail\\n\\n```md\\n## Not a heading\\n```\\n\\n';\n37-const LONG_MD = `# Long page\\n\\n## Alpha\\n\\n${`${LINE}\\n`.repeat(30)}\\n${BETA}## Gamma\\n\\nEnd.\\n`;\n38-const NOT_FOUND_HTML = '<!DOCTYPE html><html lang=\"en\"><title>Page not found</title><h1>Page not found</h1></html>';\n39-\n--\n99:function fakeEnv(files: Record<string, FakeFile> = FILES): Env & { calls: string[] } {\n100-  const calls: string[] = [];\n101-  return {\n102-    calls,\n103-    ASSETS: {\n104-      async fetch(input: Request | string | URL) {\n105-        const req = input instanceof Request ? input : new Request(input);\n106-        const p = new URL(req.url).pathname;\n107-        calls.push(p);\n108-        const f = files[p.endsWith('/') ? `${p}index.html` : p];\n109-        const body = (b: string) => (req.method === 'HEAD' ? null : b);\n110-        if (!f) return new Response(body(NOT_FOUND_HTML), { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8' } });\n111-        // Like Pages: an ETag per file, CORS open, and a 304 for a matching If-None-Match.","is_error":false}]}}
