nt, never HTML.\n  return stripTags(excerpt)\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#0?39;/g, \"'\")\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n/**\n * The site path of the Markdown copy of the page at `path` (a site path or a\n * URL on this site): `/capabilities/detect/` and `/capabilities/detect` give\n * `/capabilities/detect/index.md`. Throws for another origin.\n */\nexport function markdownPath(path: string, origin: string): string {\n  let url: URL;\n  try {\n    url = new URL(path, origin);\n  } catch {\n    throw new Error(`\"${path}\" is not a path on this site.`);\n  }\n  if (url.origin !== new URL(origin).origin) throw new Error(`\"${path}\" is not on this site (${origin}).`);\n  let p = url.pathname;\n  if (p.endsWith('/index.md')) return p;\n  if (p.endsWith('/index.html')) p = p.slice(0, -'index.html'.length);\n  else if (p.endsWith('.md')) p = `${p.slice(0, -'.md'.length)}/`;\n  if (!p.endsWith('/')) p += '/';\n  return `${p}index.md`;\n}\n\nasync function fetchText(deps: ToolDeps, path: string, missing: string, signal?: AbortSignal): Promise<string> {\nbackground|Background 14\ncapabilities|Capabilities 46\ncommunity|Community 11\ncompliance|Compliance 16\ndomains|Domains 8\nguides|Guides 21\nhome|Home 1\nrfcs|RFCs 6\nspec|Specification 11\nstart|Get started 7\nworkflows|Workflows 31\n{\"url\":\"https://acs.synapti.ai/start/faq/\",\"title\":\"Frequently Asked Questions\",\"section\":\"start\",\"group\":null,\"description\":\"Answers to common questions about adopting the standard, its capabilities and workflows, implementation, safety, multimodal support, and how it compares with other approaches.\"}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"f41f91e8-2d11-4ca7-a0b3-bacd950a14ca","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ef9