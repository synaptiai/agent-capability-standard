"-  const codes = sectionCodes(k);","-  const areas = rows.length > 0 ? `the most name ${rows[0]!.area}/ (${rows[0]!.count})` : 'none names a repository path';","-  return `${plural(k.entries.length, 'entry', 'entries')}: ${areas}; ${plural(none, 'entry names', 'entries name')} no path; ${codes.length === 0 ? 'no diagnostic code is named' : `${plural(codes.length, 'diagnostic code is', 'diagnostic codes are')} named`}. An area counts an entry when the entry names a path in it in code formatting.`;","+export function sectionCaption(r: Release, k: KindSection, known: ReadonlySet<string>): string {","+  const { rows, none } = issueCounts(k);","+  const codes = sectionCodes(k, known);","+  const issues =","+    rows.length === 0","+      ? 'none cites an issue'","+      : `${plural(k.entries.length - none, 'entry cites', 'entries cite')} ${plural(rows.length, 'issue', 'issues')}, #${rows[0]!.issue} the most (${rows[0]!.count})`;","+  const codeWords = codes.length === 0 ? 'no diagnostic code is named' : `${plural(codes.length, 'diagnostic code', 'diagnostic codes')} of the Standard named, each linked to its entry on the diagnostics page`;","+  return `${plural(k.entries.length, 'entry', 'entries')} under ${k.kind} in ${r.version}: ${issues}; ${codeWords}.`;"," }"," ","-/** The long kind sections: those that get a figure and fold. */","+/** The long kind sections: those that fold, whether or not they get a figure. */"," export function longSections(releases: Release[]): { release: Release; section: KindSection }[] {","   return releases.flatMap((release) => release.kinds.filter((k) => k.entries.length >= LONG_SECTION).map((section) => ({ release, section })));"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/src/lib/release-figures.ts"]}},"sandboxed":false,"sourceToolAssistantUUID":"adbd0492-03eb-4b65-a748-21685c5c979e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mod