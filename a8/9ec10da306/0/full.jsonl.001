 ok: false, message: `offset ${offset} is past the end of the text (${text.length} characters).`, headings: [] };\n  }\n  let end = Math.min(text.length, offset + max);\n  if (end < text.length) {\n    const nl = text.lastIndexOf('\\n', end - 1);\n    if (nl >= offset) end = nl + 1;\n  }\n  return { ok: true, markdown: text.slice(offset, end), offset, nextOffset: end < text.length ? end : null, totalLength: text.length };\n}\n\n/** The H2 headings of a Markdown text: the sections a caller can ask for by name. */\nexport function sectionNames(markdown: string): string[] {\n  return markdownHeadings(markdown)\n    .filter((h) => h.level === 2)\n    .map((h) => h.text);\n}\n8:import { PAGE_CHUNK, pagePart, sectionNames } from './page-text';\n57:      `Return the Markdown text of one page of the documentation site, given its path from search_standard results (for example \"/capabilities/mutate/\" or \"/spec/1.1.0/\"). Use it for prose: the Standard, guides, RFCs, layer and domain pages. One call returns at most ${PAGE_CHUNK.toLocaleString('en')} characters, cut at a line end; when a page is longer, the result gives nextOffset to pass as offset for the next part, and the page's section headings. Pass section to read one section by its heading instead.`,\n67:        section: {\n71:          description: 'A heading of the page, such as \"Safety\" (any level from ##, case ignored): return only that section, up to the next heading of its level.',\n77:          description: 'Where to start, in characters, in the page (or in the section): the nextOffset of the previous result.',\n90:        section: { type: 'string', description: 'The section asked for, when one was.' },\n91:        markdown: { type: 'string', description: 'The Markdown text: the page or the section, from offset, at most one part long.' },\n94:        totalLength: { type: 'integer', description: 'The length in characters of the whole page, or of the section.' },\n95:        sections: { type: 'array', items: { 