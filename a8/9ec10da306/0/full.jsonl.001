'',","     `Documentation, curl examples and the other ways agents can read the site (Markdown copies, llms.txt, an MCP server): ${SITE_ORIGIN}${DEVELOPERS_URL}`,","   ].join('\\n');"]},{"oldStart":306,"oldLines":9,"newStart":306,"newLines":12,"lines":["     const tag = TAGS[e.operationId];","     if (!tag) throw new Error(`openapi: ${e.operationId} has no tag`);","     const responses: Record<string, unknown> = {","-      '200': { description: e.summary, content: { 'application/json': { schema: ref(e.schema) } } },","+      // `type` beside the $ref (allowed in OpenAPI 3.1) lets a tool that does","+      // not follow references see that the response is an object.","+      '200': { description: e.summary, content: { 'application/json': { schema: { type: 'object', ...ref(e.schema) } } } },","     };","     if (e.param) responses['404'] = { $ref: '#/components/responses/NotFound' };","+    responses['503'] = { $ref: '#/components/responses/Unavailable' };","     const op: Record<string, unknown> = { operationId: e.operationId, summary: e.summary, description: e.description, tags: [tag], responses };","     if (e.param) {","       op.parameters = ["]},{"oldStart":353,"oldLines":6,"newStart":356,"newLines":11,"lines":["           description: 'No file at this path: the id is not one the enum lists.',","           content: { 'application/problem+json': { schema: ref('Problem') } },","         },","+        Unavailable: {","+          description: 'The file could not be read this time. Retry after the number of seconds in the Retry-After header.',","+          headers: { 'Retry-After': { description: 'Seconds to wait before retrying.', schema: { type: 'integer', minimum: 0 } } },","+          content: { 'application/problem+json': { schema: ref('Problem') } },","+        },","       },","     },","   };"]}]}],"moreFiles":0,"changedFiles":["/Users/danielbentes/agent-capability-standard/.claude/worktrees/i-followup/site/src/lib/openapi.ts"]}},"sandboxed":false,"sourceToolA