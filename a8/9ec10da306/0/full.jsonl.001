{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"353dd98a9919999904aafdc218999afe8dcd7f5b0da972286338b042d5edad51","message":{"role":"user","content":[{"tool_use_id":"toolu_016umSFmv4KrfFeeCPg7LWDC","type":"tool_result","content":"---\n// Registers the site's read-only WebMCP tools (lib/webmcp.ts) on every page,\n// for an agent working in the visitor's browser. In a browser without the\n// WebMCP API it does nothing. The search tool loads the Pagefind index on its\n// first call, as the search dialog does on its first open.\n---\n<script>\n  import { retryingLoader } from '../lib/search-loader';\n  import { webMcpTools, type ModelContextTool, type PagefindApi } from '../lib/webmcp';\n\n  // document.modelContext is the API's entry point; navigator.modelContext,\n  // from earlier drafts, is only the fallback.\n  function register(tool: ModelContextTool): unknown {\n    if (document.modelContext) return document.modelContext.registerTool(tool);\n    return navigator.modelContext!.registerTool(tool);\n  }\n\n  if (document.modelContext || (typeof navigator !== 'undefined' && navigator.modelContext)) {\n    const loadPagefind = retryingLoader('/pagefind/pagefind.js', async (url) => {\n      const mod = (await import(/* @vite-ignore */ url)) as PagefindApi & { options(o: Record<string, unknown>): Promise<void> };\n      // The same options as the search dialog, so either may load it first.\n      await mod.options({ excerptLength: 24 });\n      return mod;\n    });\n    const tools = webMcpTools({\n      origin: location.origin,\n      fetch: (url, init) => fetch(url, init),\n      loadPagefind,\n    });\n    for (const tool of tools) {\n      // A browser that refuses a tool (a name already taken, say) must not\n      // stop the others or put an error in the console.\n      try {\n        Promise.resolve(register(tool)).catch(() => {});\n      } catch {\n        // Ignored, as above.\n      }\n    }\n  }\n</script>\n32 matches in 