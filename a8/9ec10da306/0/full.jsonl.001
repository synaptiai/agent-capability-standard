{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"bd84750bd9960f8e6db639818e2cb304b44cd4811e6fc13b7ba2898384cda74f","message":{"role":"user","content":[{"tool_use_id":"toolu_01U7munQSTT7jnX4ppQL5UQx","type":"tool_result","content":"// Entry point of the Cloudflare Pages worker, bundled into dist/_worker.js\n// by src/lib/worker-build.ts when the site is built.\n//\n// Why \"advanced mode\" (_worker.js) and not a functions/ folder:\n// - The deploy job in .github/workflows/site.yml downloads the built dist/\n//   artifact and runs `wrangler pages deploy dist` with no checkout of the\n//   repository. Wrangler compiles a functions/ folder only from the directory\n//   it runs in, so site/functions/ would never be deployed; a _worker.js\n//   inside dist/ is deployed with the files, by that same command, unchanged.\n// - The bundle is one self-contained ES module that uses only web-standard\n//   APIs (no node: imports, no compatibility flags), because no wrangler\n//   configuration file reaches the deploy either.\n//\n// Which requests run it: dist/_routes.json (written next to it) sends every\n// path to the worker except the static assets that never need it (scripts,\n// styles, the search index, fonts, images, robots.txt, the sitemap and\n// llms.txt). Those stay free, unlimited static requests; every other request\n// counts against the Workers plan (100,000 a day on the Free plan).\n//\n// Cloudflare's documentation says _headers and _redirects are not applied to\n// responses a worker generates. The worker reads every file through\n// env.ASSETS.fetch, and under `wrangler pages dev` (4.160.0) those responses\n// do carry the _headers rules and the /spec/ redirect; that was checked\n// locally, not on the production project. The worker sets the headers of the\n// responses it builds itself.\n\nimport type { Env, WorkerConfig } from './env';\nimport { createHandler } from './site';\n\ndeclare const __ACS_WORKER_CONFIG__: WorkerConfig;\n\nconst handle = createHandler(__ACS_WORKER_CONFIG__);\n\nexport default {\n  fetch(request: Request, env: Env): Promise<Response> {\n    return handle(request, env);\n  },\n};\n// Writes the Cloudflare Pages worker into the build output when the site is\n// built (astro.config.mjs, astro:build:done): dist/_worker.js, bundled from\n// src/worker/entry.ts with rolldown, and dist/_routes.json, which keeps the\n// static assets from invoking it. Why advanced mode: src/worker/entry.ts.\nimport { writeFileSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { build } from 'rolldown';\nimport { loadVersions } from '../data/versions';\nimport type { WorkerConfig } from '../worker/env';\nimport { SITE_ORIGIN } from './origin';\n\nexport const WORKER_FILE = '_worker.js';\nexport const ROUTES_FILE = '_routes.json';\n\n/**\n * Paths that never run the worker. Each names files the build writes (the\n * dist test checks that every rule matches one), and none of them is a page,\n * a Markdown copy, /api/, /mcp or /.well-known/, which the worker handles.\n */\nexport const ROUTES_EXCLUDE = [\n  '/_astro/*',\n  '/pagefind/*',\n  '/fonts/*',\n  '/favicon.png',\n  '/favicon.svg',\n  '/og.png',\n  '/robots.txt',\n  '/sitemap.xml',\n  '/llms.txt',\n  '/llms-full.txt',\n] as const;\n\nexport function routesJson(): string {\n  return `${JSON.stringify({ version: 1, include: ['/*'], exclude: [...ROUTES_EXCLUDE] }, null, 2)}\\n`;\n}\n\nexport function workerConfig(): WorkerConfig {\n  const v = loadVersions();\n  return { version: v.plugin, standardVersion: v.standard.current.version, origin: SITE_ORIGIN };\n}\n\n/** Bundle the worker into `distDir` and write its routes file. Returns the bundle's size in bytes. */\nexport async function writeWorker(distDir: string): Promise<number> {\n  const entry = fileURLToPath(new URL('../worker/entry.ts', import.meta.url));\n  const out = await build({\n    input: entry,\n    platform: 'neutral',\n    transform: { define: { __ACS_WORKER_CONFIG__: JSON.stringify(workerConfig()) } },\n    output: { format: 'esm', file: path.join(distDir, WORKER_FILE), codeSplitting: false },\n    write: true,\n  });\n  writeFileSync(path.join(distDir, ROUTES_FILE), routesJson());\n  return out.output.reduce((n, o) => n + (o.type === 'chunk' ? o.code.length : 0), 0);\n}\n# Cloudflare Pages response headers.\n# The Markdown copy of each page, at <route>index.md.\n/*.md\n  Content-Type: text/markdown; charset=utf-8\n\n/llms.txt\n  Content-Type: text/plain; charset=utf-8\n\n/llms-full.txt\n  Content-Type: text/plain; charset=utf-8\n\n# Keep the pages.dev copies of the site out of search engines.\nhttps://:project.pages.dev/*\n  X-Robots-Tag: noindex\n\nhttps://:version.:project.pages.dev/*\n  X-Robots-Tag: noindex\n\n# The data API and its description: JSON, readable from any origin.\n/api/*\n  Content-Type: application/json; charset=utf-8\n  Access-Control-Allow-Origin: *\n\n/openapi.json\n  Content-Type: application/json; charset=utf-8\n  Access-Control-Allow-Origin: *\n\n# The API catalog (RFC 9727).\n/.well-known/api-catalog\n  Content-Type: application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\"\n  Access-Control-Allow-Origin: *","is_error":false}]}}
