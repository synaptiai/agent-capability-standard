25-relnotes/site/test/release-figures.test.ts":{"backupFileName":null,"version":5,"backupTime":"2026-11-14T10:35:01.911Z","realParentDir":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/test"},".claude/worktrees/i125-relnotes/site/src/plugins/release-figures-hast.ts":{"backupFileName":null,"version":5,"backupTime":"2026-11-14T10:35:01.911Z","realParentDir":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/src/plugins"},".claude/worktrees/i125-relnotes/site/src/lib/release-figures.ts":{"backupFileName":null,"version":5,"backupTime":"2026-11-14T10:35:01.911Z","realParentDir":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/src/lib"},"/private/tmp/claude-501/-Users-danielbentes-agent-capability-standard/ef9f3fc8-12b6-4fe4-9f49-aaeedec05648/scratchpad/ora-checks.md":{"backupFileName":"7ce8a60e93eb7ed8@v2","version":2,"backupTime":"2026-11-14T10:35:01.941Z","realParentDir":"REDACTED"},".claude/worktrees/i125-relnotes/site/src/twins/release-blocks.ts":{"backupFileName":null,"version":5,"backupTime":"2026-11-14T10:35:01.911Z","realParentDir":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/src/twins"},"/private/tmp/claude-501/-Users-danielbentes-agent-capability-standard/ef9f3fc8-12b6-4fe4-9f49-aaeedec05648/scratchpad/pr-127-body.md":{"backupFileName":"491ff259ddc90147@v2","version":2,"backupTime":"2026-11-14T10:35:01.941Z","realParentDir":"REDACTED"},"/private/tmp/claude-501/-Users-danielbentes-agent-capability-standard/ef9f3fc8-12b6-4fe4-9f49-aaeedec05648/scratchpad/agents-brief.md":{"backupFileName":"4f86edfe30bf76ce@v2","version":2,"backupTime":"2026-11-14T10:35:01.941Z","realParentDir":"REDACTED"},"/private/tmp/claude-501/-Users-danielbentes-agent-capability-standard/ef9f3fc8-12b6-4fe4-9f49-aaeedec05648/scratchpad/issue-agents.md":{"backupFileName":"54a2e2c4ede642e8@v2","version":2,"backupTime":"2026-11-14T10:35:01.941Z","realPare