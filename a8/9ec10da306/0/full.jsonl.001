('.table-wrap').clientWidth + 1));\n  console.log(name, figs.length, 'figures; page height', await p.evaluate(() => document.documentElement.scrollHeight), '; timeline scrolls sideways:', sideways);\n}\nawait b.close();\n","structuredPatch":[{"oldStart":6,"oldLines":16,"newStart":6,"newLines":18,"lines":["   await p.goto('http://127.0.0.1:8793/community/release-notes/');","   await p.addStyleTag({ content: 'header, .site-header { position: static !important; }' });","   const figs = await p.$$('figure.fig');","-  let i = 0;","-  for (const f of figs) {","-    await f.screenshot({ path: `${out}/fig${i}-${name}.png` });","-    i++;","-    if (i > 2) break;","-  }","-  const more = await p.$('details.release-more');","-  const box = await more.boundingBox();","-  await p.evaluate((y) => window.scrollTo(0, y), Math.max(0, box.y - 500));","-  await p.screenshot({ path: `${out}/fold-${name}.png` });","-  console.log(name, figs.length, 'figures, page height', await p.evaluate(() => document.documentElement.scrollHeight));","+  await figs[0].screenshot({ path: `${out}/fig0-${name}.png` });","+  await figs[1].screenshot({ path: `${out}/fig1-${name}.png` });","+  // The first fold, with the list above it.","+  const top = await p.evaluate(() => {","+    const d = document.querySelector('details.release-more');","+    const ul = d.previousElementSibling;","+    const a = ul.getBoundingClientRect();","+    const z = d.getBoundingClientRect();","+    return { y: a.top + window.scrollY + Math.max(0, a.height - 300), h: Math.min(700, z.bottom - a.top + 40) };","+  });","+  await p.screenshot({ path: `${out}/fold-${name}.png`, fullPage: true, clip: { x: 0, y: top.y, width: w, height: 400 } });","+  const sideways = await p.evaluate(() => [...document.querySelectorAll('.release-line')].some((t) => t.closest('.table-wrap').scrollWidth > t.closest('.table-wrap').clientWidth + 1));","+  console.log(name, figs.length, 'figures; page height', await p.evaluate(() => document.documentElement.scrollHeight), '; timeline scrolls sideways:', sideways);"," }"," await b.close();"]}],"originalFile":"import { chromium } from '/Users/danielbentes/.REDACTED.mjs';\nconst out = 'REDACTED';\nconst b = await chromium.launch({ executablePath: 'REDACTED Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing' });\nfor (const [name, w, scheme] of [['1440-light', 1440, 'light'], ['1440-dark', 1440, 'dark'], ['360-light', 360, 'light']]) {\n  const p = await b.newPage({ viewport: { width: w, height: 1000 }, colorScheme: scheme, reducedMotion: 'reduce' });\n  await p.goto('http://127.0.0.1:8793/community/release-notes/');\n  await p.addStyleTag({ content: 'header, .site-header { position: static !important; }' });\n  const figs = await p.$$('figure.fig');\n  let i = 0;\n  for (const f of figs) {\n    await f.screenshot({ path: `${out}/fig${i}-${name}.png` });\n    i++;\n    if (i > 2) break;\n  }\n  const more = await p.$('details.release-more');\n  const box = await more.boundingBox();\n  await p.evaluate((y) => window.scrollTo(0, y), Math.max(0, box.y - 500));\n  await p.screenshot({ path: `${out}/fold-${name}.png` });\n  console.log(name, figs.length, 'figures, page height', await p.evaluate(() => document.documentElement.scrollHeight));\n}\nawait b.close();\n","userModified":false},"sourceToolAssistantUUID":"cdf746ae-8706-4445-b602-29e2dba8c1a1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/issue-125-site-visuals","slug":"i-just-came-across-imperative-newell"}
