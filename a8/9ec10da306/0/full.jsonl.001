nt-weight: 600;\n    color: var(--link, var(--accent-ink, var(--ink)));\n  }\n\n  .release-more > ul {\n    margin-top: var(--space-2);\n  }\n\n'''\nassert s.count(anchor)==1\nopen(p,'w').write(s.replace(anchor, add+anchor))\nEOF\ngrep -n \"^\\s*--link:\\|--link-color\\|^\\s*--accent-ink\" src/styles/tokens.css | head -3; grep -n \"summary\" src/styles/components.css | head -5","description":"Add release figure styles"},"caller":{"type":"direct"}}]}}
