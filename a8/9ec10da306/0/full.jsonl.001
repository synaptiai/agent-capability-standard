{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"64ff3b241dfce0ffe78a9166ef11f571752aeafcdcb90a787557f00856097ffb","message":{"role":"user","content":[{"tool_use_id":"toolu_01W7DGeHjwdot73FPeBEp6kW","type":"tool_result","content":"    .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')\n    .replace(/[`*_]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction same(a: string, b: string): boolean {\n  return a.toLowerCase() === b.toLowerCase();\n}\n\nexport type PagePart =\n  | {\n      ok: true;\n      /** The text returned: the section asked for (or the page), from offset, at most PAGE_CHUNK characters. */\n      markdown: string;\n      offset: number;\n      /** Where the next read starts, or null when this one reached the end. */\n      nextOffset: number | null;\n      /** The length of the section asked for, or of the page. */\n      totalLength: number;\n    }\n  | { ok: false; message: string; headings: string[] };\n\n/**\n * The part of `markdown` to return: the section whose heading is `section`\n * (from the heading to the next heading of the same or a higher level), or\n * the whole text; then from `offset`, at most `max` characters, cut at the\n * end of a line when the text goes on.\n */\nexport function pagePart(markdown: string, opts: { section?: string; offset?: number; max?: number } = {}): PagePart {\n  const max = opts.max ?? PAGE_CHUNK;\n  let text = markdown;\n  if (opts.section !== undefined) {\n    const heads = markdownHeadings(markdown);\n    const i = heads.findIndex((h) => same(h.text, opts.section!.trim()));\n    if (i === -1) {\n      return { ok: false, message: `The page has no section headed \"${opts.section}\".`, headings: heads.map((h) => h.text) };\n    }\n    const h = heads[i]!;\n    const next = heads.slice(i + 1).find((n) => n.level <= h.level);\n    text = markdown.slice(h.start, next ? next.start : markdown.length);\n  }\n  const offset = opts.offset ?? 0;\n  if (offset > text.length) {\n    return { ok: false, message: `offset ${offset} is past the end of the text (${text.length} characters).`, headings: [] };\n  }\n  let end = Math.min(text.length, offset + max);\n  if (end < text.length) {\n    const nl = text.lastIndexOf('\\n', end - 1);\n    if (nl >= offset) end = nl + 1;\n  }\n  return { ok: true, markdown: text.slice(offset, end), offset, nextOffset: end < text.length ? end : null, totalLength: text.length };\n}\n\n/** The H2 headings of a Markdown text: the sections a caller can ask for by name. */\nexport function sectionNames(markdown: string): string[] {\n  return markdownHeadings(markdown)\n    .filter((h) => h.level === 2)\n    .map((h) => h.text);\n}\n8:import { PAGE_CHUNK, pagePart, sectionNames } from './page-text';\n57:      `Return the Markdown text of one page of the documentation site, given its path from search_standard results (for example \"/capabilities/mutate/\" or \"/spec/1.1.0/\"). Use it for prose: the Standard, guides, RFCs, layer and domain pages. One call returns at most ${PAGE_CHUNK.toLocaleString('en')} characters, cut at a line end; when a page is longer, the result gives nextOffset to pass as offset for the next part, and the page's section headings. Pass section to read one section by its heading instead.`,\n67:        section: {\n71:          description: 'A heading of the page, such as \"Safety\" (any level from ##, case ignored): return only that section, up to the next heading of its level.',\n77:          description: 'Where to start, in characters, in the page (or in the section): the nextOffset of the previous result.',\n90:        section: { type: 'string', description: 'The section asked for, when one was.' },\n91:        markdown: { type: 'string', description: 'The Markdown text: the page or the section, from offset, at most one part long.' },\n94:        totalLength: { type: 'integer', description: 'The length in characters of the whole page, or of the section.' },\n95:        sections: { type: 'array', items: { type: 'string' }, description: 'The page\\'s ## headings, which section accepts; given when the text did not fit in one part.' },\n160:              section: { type: 'string' },\n245: * the path, the description and headings, the section, and least the page's\n267:  const sectionWords = stems(page.section);","is_error":false}]}}
