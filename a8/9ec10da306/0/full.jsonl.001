rflow-wrap: anywhere;\nsrc/styles/figures-prose.css:474:    overflow-wrap: anywhere;\nsrc/styles/figures-spec.css:1962:    overflow-wrap: anywhere;\nsrc/styles/figures-spec.css:2060:     region; the drawing's overflow-wrap: anywhere would break every word. */\nsrc/styles/figures-spec.css:2103:      overflow-wrap: anywhere;\nsrc/styles/figures-workflow-page.css:167:    overflow-wrap: anywhere;","is_error":false}]}}
