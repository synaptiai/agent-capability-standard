 type YesNo = 'yes' | 'no' | 'partial';\n341:export function yesNo(v: string): YesNo | null {\n350:export function yesNoColumn(cells: string[]): YesNo[] | null {\n359:export function riskColumn(header: string, cells: string[]): ('low' | 'medium...\n  +17 more in src/plugins/rehype-prose-figures.ts [see remaining: tail -n +26 \"$HOME/Library/Application Support/rtk/tee/1794519702_grep_0___5746d6.log\"]\n744 plugins/rehype-prose-figures.ts\n71 twins/prose-blocks.ts\nΣ 815","is_error":false}]}}
