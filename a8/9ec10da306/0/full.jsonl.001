missing (a failed read throws ReadFailed). */\"\"\"),\n])\ns=open('src/worker/data.ts').read()\ni=s.index('export class SiteData') if 'export class SiteData' in s else s.index('class SiteData')\ns=s[:i]+\"\"\"/** A site file that exists but could not be read: any status but 200 or 404, or JSON that does not parse. */\nexport class ReadFailed extends Error {\n  constructor(\n    readonly path: string,\n    readonly reason: string,\n  ) {\n    super(`${path} could not be read (${reason})`);\n  }\n}\n\n\"\"\"+s[i:]\nopen('src/worker/data.ts','w').write(s)\n\n# MCP: ReadFailed -> -32603 with a retry message; log every unexpected error\nedit('src/worker/mcp.ts', [\n(\"\"\"  } catch (e) {\n    if (e instanceof RpcError) return rpcError(id, e);\n    return rpcError(id, new RpcError(-32603, 'Internal error', 500));\n  }\n}\"\"\",\"\"\"  } catch (e) {\n    if (e instanceof RpcError) return rpcError(id, e);\n    if (e instanceof ReadFailed) {\n      console.error('mcp: read failed', method, e.path, e.reason);\n      return rpcError(id, new RpcError(-32603, `The site's data could not be read (${e.path}: ${e.reason}). Try again.`, 503));\n    }\n    console.error('mcp: internal error', method, e);\n    return rpcError(id, new RpcError(-32603, 'Internal error', 500));\n  }\n}\"\"\"),\n])\ns=open('src/worker/mcp.ts').read()\nm=re.search(r\"import \\{([^}]*)\\} from './data';\", s)\nassert m, 'data import'\nnames=[n.strip() for n in m.group(1).split(',') if n.strip()]\nif 'ReadFailed' not in names: names.append('ReadFailed')\ns=s[:m.start()]+\"import { \"+\", \".join(names)+\" } from './data';\"+s[m.end():]\nopen('src/worker/mcp.ts','w').write(s)\n\n# ERR-1 / ERR-4: log, and guard the fail-open fallback\nedit('src/worker/site.ts', [\n(\"\"\"    try {\n      return await route(request, env, cfg);\n    } catch {\n      // Fail open: if anything here breaks, the static files are still served as they are.\n      return withStaticRules(new URL(request.url), await env.ASSETS.fetch(reque