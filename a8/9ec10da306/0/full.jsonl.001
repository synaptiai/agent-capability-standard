{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"1cf47515fa67f617ffc6ddf19523738e7d2fd4fc9136dc0f2da4209442bfbfa5","message":{"role":"user","content":[{"tool_use_id":"toolu_0151S7FfzNv1XhLkKuiD7j4x","type":"tool_result","content":"// Tests on what the capability page's figures show (visual spec 3.1, 6.3).\n// Expected values come from line scans of the ontology and the SKILL.md\n// files (test/independent.ts), from the spec's own reading of mutate at\n// 824eea1 (a hand-written fixture), or from the spec's caption wording;\n// never from the functions under test.\nimport { describe, expect, it } from 'vitest';\nimport { loadOntology } from '../src/data/ontology';\nimport {\n  chainChecks,\n  compositionChain,\n  exampleFields,\n  exampleFieldsIsFigure,\n  contractRowId,\n  contractSummary,\n  edgeRules,\n  outputFields,\n  outputFieldsCaption,\n  outputFieldsIsFigure,\n  procedureMap,\n  procedureMapCaption,\n  procedureMapIsFigure,\n  safetySequence,\n  sequenceCaption,\n  sequenceIsFigure,\n  neighbourCounts,\n  neighbourhoodCaption,\n  neighbours,\n  relationWords,\n  splitAtH2s,\n} from '../src/lib/capability-figures';\n9:  chainChecks,\n10:  compositionChain,\n58:describe('neighbours (F-C1)', () => {\n115:describe('exampleFields (F-C9)', () => {\n133:describe('chainChecks', () => {\n139:    const checks = chainChecks(cap, { follows: ['checkpoint'], precedes: ['verify'] }, o, wfs);\n150:describe('composition text against the ontology', () => {\n158:      const chain = compositionChain(repoText(`skills/${c.id}/SKILL.md`));\n166:describe('compositionChain', () => {\n180:    const got = compositionChain(text);\n187:    expect(compositionChain(text)).toEqual({ follows: ['plan'], precedes: [] });\n191:describe('splitAtH2s', () => {\n203:describe('contractRowId', () => {\n210:describe('edgeRules (F-C5)', () => {\n229:describe('safetySequence (F-C5)', () => {\n266:describe('outputFields (F-C6)', () => {\n296:describe('procedureMap (F-C7)', () => {\nsrc/lib/capability-figures.ts:198:export function compositionChain(skillText: string, ontology: Ontology = loadOntology()): CompositionChain {\nsrc/lib/capability-figures.ts:239:export function chainChecks(cap: Capability, chain: CompositionChain, ontology: Ontology = loadOntology(), workflows: { steps: { capability: string }[] }[] = loadWorkflows().all): ChainCheck[] {\nsrc/lib/capability-figures.ts:252:export function chainCaption(cap: Capability, chain: CompositionChain, checks: ChainCheck[] = chainChecks(cap, chain)): string {\nsrc/lib/edge-figures.ts:190:export function parseChains(fence: string, o: Ontology = loadOntology(), where = EDGE_TYPES_SOURCE): Chain[] {\nsrc/lib/edge-figures.ts:247:export function exampleChains(heading: string, text = readRepoFile(EDGE_TYPES_SOURCE)): Chain[] {\nsrc/lib/edge-figures.ts:252:export function chainKey(chains: Chain[]): { id: string; symbol: string }[] {\nsrc/lib/edge-figures.ts:256:export function chainCaption(chains: Chain[]): string {","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"bec0c2f4d8301c31f721d853170d5b09d41213e139c0b095dc6e4c5d3e873e9a","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01HzXKbd4B9kCYvMrBb5zpea","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/wf_08f3cd25-fc3-8/site && python3 - <<'EOF'\np='test/capability-figures.test.ts'\ns=open(p).read()\ns=s.replace(\"  chainChecks,\\n  compositionChain,\",\"  chainCaption,\\n  chainChecks,\\n  compositionChain,\",1)\ns+='''\ndescribe('chainCaption', () => {\n  // spec/EDGE_TYPES.md: for requires, \"the 'from' capability MUST be\n  // satisfied before 'to' can execute\". The ontology's edge is\n  // checkpoint -> mutate, so the caption must say checkpoint runs first,\n  // never that checkpoint requires mutate.\n  it('reads an edge from its source to its target', () => {\n    const cap = loadOntology().capabilities.find((c) => c.id === 'mutate')!;\n    const text = chainCaption(cap, { follows: ['checkpoint'], precedes: [] });\n    expect(text).toContain(\"the tile's capability must run before mutate\");\n    expect(text).not.toContain(\"the tile's capability requires mutate\");\n  });\n});\n'''\nopen(p,'w').write(s)\nEOF\nnpx vitest run test/capability-figures.test.ts 2>&1 | tail -4","description":"Add a regression test for the edge direction"},"caller":{"type":"direct"}}]}}
