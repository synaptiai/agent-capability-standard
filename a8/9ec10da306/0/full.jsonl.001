{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"568c9119eb75b1dd778c61ec6dd2eed445c9dd8acda4a8febdc157036e47e5bd","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"I'm updating the tests to match the five fixes, then I'll run the checks and push."},{"type":"tool_use","id":"toolu_01Xwaa84PptXmMg4hPpEXQp5","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/wf_08f3cd25-fc3-8/site && python3 - <<'EOF'\ndef sub(p, old, new):\n    s=open(p).read(); assert s.count(old)==1,(p,old[:50]); open(p,'w').write(s.replace(old,new))\nsub('test/workflow-domain-pages.test.ts', \"\"\"  it('warns when the README has no Capability Usage section', () => {\n    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});\n    expect(capabilityUsage('# Domain\\\\n\\\\n## Overview\\\\n\\\\nText.\\\\n', 'docs/domains/x/README.md')).toEqual([]);\n    expect(warn.mock.calls.map((c) => c[0])).toEqual(['docs/domains/x/README.md: no \"## Capability Usage\" section; no usage figures']);\n  });\"\"\", \"\"\"  it('fails on a README without the section unless it is listed, and on a listed README that gains one', () => {\n    const none = '# Domain\\\\n\\\\n## Overview\\\\n\\\\nText.\\\\n';\n    expect(() => capabilityUsage(none, 'docs/domains/x/README.md')).toThrow(/no \"## Capability Usage\" section; add one, or add the README to NO_USAGE_SECTION/);\n    expect(capabilityUsage(none, 'docs/domains/healthcare/README.md')).toEqual([]);\n    expect(() => capabilityUsage('# D\\\\n\\\\n## Capability Usage\\\\n', 'docs/domains/healthcare/README.md')).toThrow(/remove it from NO_USAGE_SECTION/);\n  });\n\n  it('lists exactly the domain READMEs that have no Capability Usage section', () => {\n    // Read from the files with a plain line test, not through capabilityUsage.\n    const dir = path.join(REPO, 'docs/domains');\n    const without = readdirSync(dir)\n      .map((d) => `docs/domains/${d}/README.md`)\n      .filter((p) => existsSync(path.join(REPO, p)) && !/^## Capability Usage\\\\s*$/m.test(readFileSync(path.join(REPO, p), 'utf8')))\n      .sort();\n    expect([...NO_USAGE_SECTION].sort()).toEqual(without);\n  });\"\"\")\nsub('test/data.test.ts', \"\"\"  it('rejects a workflow id that is not lowercase letters, digits and underscores', () => {\n    // The id is written into a CSS selector on the workflow page.\n    for (const id of ['Bad', 'a-b', 'a\"]{}', 'a b']) {\n      expect(() => parseCatalog('t.yaml', `\"${id.replace(/\"/g, '\\\\\\\\\"')}\":\\\\n  goal: g\\\\n  risk: low\\\\n  steps:\\\\n  - capability: plan\\\\n`, 'core', loadOntology()), id).toThrow(/is not lowercase letters, digits and underscores/);\n    }\n    expect(parseCatalog('t.yaml', 'ok_2:\\\\n  goal: g\\\\n  risk: low\\\\n  steps:\\\\n  - capability: plan\\\\n', 'core', loadOntology()).map((w) => w.id)).toEqual(['ok_2']);\n  });\"\"\", \"\"\"  it('accepts any workflow name the Standard allows (§5.1 names no pattern)', () => {\n    // The workflow page escapes the id where it writes it into CSS.\n    for (const id of ['Bad', 'a-b', 'a\"]{}', 'a b']) {\n      expect(parseCatalog('t.yaml', `\"${id.replace(/\"/g, '\\\\\\\\\"')}\":\\\\n  goal: g\\\\n  risk: low\\\\n  steps:\\\\n  - capability: plan\\\\n`, 'core', loadOntology()).map((w) => w.id), id).toEqual([id]);\n    }\n  });\"\"\")\ns=open('test/release-figures.test.ts').read()\ns+='''\ndescribe('fenced lines', () => {\n  it('does not count a bullet inside a code fence as an entry', () => {\n    // Hand count: 3 real entries; the 2 fenced \"- \" lines are code.\n    const text = ['## [v1.0.0] — 2026-01-01', '', '### Added', '- one', '- two', '', '```yaml', '- not an entry', '- nor this', '```', '', '- three', ''].join('\\\\n');\n    expect(kindCount(parseReleases(text)[0]!, 'Added')).toBe(3);\n  });\n});\n'''\nopen('test/release-figures.test.ts','w').write(s)\ns=open('test/toc.test.ts').read()\ns=s.replace(\"import { tocEntries } from '../src/lib/toc';\",\"import { decodeEntities, tocEntries } from '../src/lib/toc';\",1)\ns+='''\ndescribe('decodeEntities', () => {\n  it('reads numeric references, and leaves a named one it does not know unchanged', () => {\n    expect(decodeEntities('A &#x26; B &#X3C; C &#38;')).toBe('A & B < C &');\n    // Named references whose second letter is x are not hex references.\n    expect(decodeEntities('&excl; &exist; &ex;')).toBe('&excl; &exist; &ex;');\n  });\n});\n'''\nopen('test/toc.test.ts','w').write(s)\nEOF\nhead -12 test/workflow-domain-pages.test.ts; grep -n \"^import\" test/toc.test.ts","description":"Update and add tests for the fixes"},"caller":{"type":"direct"}}]}}
