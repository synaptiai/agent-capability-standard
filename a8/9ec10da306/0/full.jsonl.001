: string): { code: string; name: string; severity: Severity }[] {\nsrc/data/diagnostics.ts:128:    severity: m[4] === 'Error' ? 'error' : 'warning',\nsrc/data/diagnostics.ts:150:export function loadDiagnostics(): Diagnostic[] {\n14:export interface Diagnostic {\n15-  code: string;\n16-  name: string;\n17-  severity: Severity;\n18-  /** The §9 subsection heading without its number, e.g. \"Validation Errors\". */\n19-  category: string;\n20-  /** Spec section number, e.g. \"9.2\". */\n21-  section: string;\n22-  /** GitHub-style id of that section's heading in the spec. */\n31:function readGithubBase(): string {\n34:  if (typeof repo !== 'string' || !/^https:\\/\\/github\\.com\\/[^/]+\\/[^/]+$/.test(repo)) {\n35:    throw new Error(`repo: plugin.json \"repository\" is not a GitHub URL: ${String(repo)}`);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"349eb1be-1a77-469b-bcea-dc00bd0b5628","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/issue-125-site-visuals","slug":"i-just-came-across-imperative-newell"}
