{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"6b1b3acba548e3f9bca5b948f67d7f20b00efa9fb73963bfc2a636984c678b99","message":{"role":"user","content":[{"tool_use_id":"toolu_01UPT2redLhbqDdvWN3P9Et8","type":"tool_result","content":"  });\n});\n\ndescribe('robots.txt', () => {\n  it('allows every crawler, names the AI search and user agents with the same rule, and lists the sitemap', () => {\n    const text = read('robots.txt');\n    const groups = text.split(/\\n\\s*\\n/).filter((g) => /User-agent:/i.test(g));\n    for (const g of groups) expect(g.split('\\n').filter((l) => /^(Allow|Disallow):/i.test(l))).toEqual(['Allow: /']);\n    for (const bot of ['*', 'OAI-SearchBot', 'Claude-SearchBot', 'PerplexityBot', 'ChatGPT-User', 'Claude-User', 'Perplexity-User']) {\n      expect(text).toContain(`User-agent: ${bot}\\n`);\n    }\n    expect(text).toContain(`Sitemap: ${ORIGIN}/sitemap.xml`);\n  });\n});\n\ndescribe('home page metadata', () => {\n  const graph = () => {\n53:      line: `${ROUTES.length} pages for people, each with a canonical URL and a link to its Markdown copy.`,\n193:  'Each copy opens with front matter (title, description, canonical and last_updated), then the page with a top-level heading. Links in a copy point at the other pages\\' copies, so an agent can follow them without reading HTML. Figures are given as tables or lists with the same data.',","is_error":false}]}}
