a long kind section (LONG_SECTION entries or more) whose entries\n//   cite an issue (\"#N\") or name a diagnostic code the Standard defines: the\n//   issues with the number of entries citing each, and the codes as tiles\n//   linked to the diagnostics page. Every long section shows its first\n//   SHOWN_ENTRIES entries and folds the rest; the Markdown copy keeps them all.\"\"\")\ns=s.replace(\"export function sectionTitle(r: Release, k: KindSection): string {\\n  return `What the ${k.entries.length} ${k.kind.toLowerCase()} entries of ${r.version} name`;\",\"export function sectionTitle(r: Release, k: KindSection): string {\\n  return `Issues and diagnostic codes in ${r.version}, ${k.kind}`;\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"areas\\|AREAS\" src/lib/release-figures.ts","description":"Switch section figure from areas to issues and codes"}},"wireIngestContext":{"toolu_012iRYoPs1JqGfRRczjygYXN":{"cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site"}},"serverClassifierRequest":"95c33f2a-df06-4b31-ba4a-b294662cff02","apiBlockIndex":0,"requestId":"req_011CgymJ5MbJAnnrJuVgyZNN","requestRef":"e9611942-00cc-4c08-a4e3-61a97447d721","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"adbd0492-03eb-4b65-a748-21685c5c979e","timestamp":"2026-11-12T21:44:17.936Z","advisorModel":"claude-fable-5-2","effort":"medium","perTurnEffort":"medium","session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/issue-125-site-visuals","slug":"i-just-came-across-imperative-newell"}
