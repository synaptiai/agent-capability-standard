'/capabilities/nothing.md', { Accept: BROWSER_ACCEPT });\n    expect(res.status).toBe(404);\n    expect(res.headers.get('Content-Type')).toBe('text/markdown; charset=utf-8');\n  });\n\n  it('answers an unknown /api/v1/ path with RFC 9457 problem details', async () => {\n    const res = await get('/api/v1/capabilities/nothing.json', { Accept: BROWSER_ACCEPT });\n    expect(res.status).toBe(404);\n    expect(res.headers.get('Content-Type')).toBe('application/problem+json');\n    expect(await res.json()).toEqual({\n      type: 'https://acs.synapti.ai/developers/#ref-errors',\n      title: 'Not Found',\n6:import { readFileSync } from 'node:fs';\n7:import path from 'node:path';\n8:import { describe, expect, it, vi } from 'vitest';\n9:import { parseAccept, prefersMarkdown } from '../src/worker/accept';\n10:import type { Env, WorkerConfig } from '../src/worker/env';\n11:import { createHandler } from '../src/worker/site';\n12:import { scorePage } from '../src/worker/tools';\n13:import { pagePart } from '../src/worker/page-text';\n14:import type { PageEntry } from '../src/worker/data';\n15:import { HEADER_RULES } from '../src/worker/static-rules';\n16:import { pageSearchTerms, searchTerms, stem, TERMS_PER_PAGE } from '../src/worker/terms';\n17:import { validate } from './json-schema-lite';\n18:import { REPO_ROOT } from '../src/lib/repo';","is_error":false}]},"uuid":"25d56048-d132-465c-af84-9edb4c8ceda5","timestamp":"2026-11-14T12:41:57.648Z","toolUseResult":{"stdout":"  });\n});\n\ndescribe('pages and their Markdown copies', () => {\n  it('answers Accept: text/markdown on a page with its Markdown copy, Vary and a canonical link', async () => {\n    const res = await get('/', { Accept: 'text/markdown' });\n    expect(res.status).toBe(200);\n    expect(res.headers.get('Content-Type')).toBe('text/markdown; charset=utf-8');\n    expect(res.headers.get('Vary')).toContain('Accept');\n    expect(res.headers.get('Link')).toBe('<https://acs.synapti.ai/>; rel=\"canonical\"');\n    exp