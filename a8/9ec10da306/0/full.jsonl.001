{"parentUuid":"98751324-9e07-4c83-963b-0c16e6f131e6","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:Bash","toolUseID":"toolu_01Gk8PaS7c7Ji7ufmEgRsqm9","hookEvent":"PreToolUse","content":"","stdout":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecisionReason\":\"RTK auto-rewrite\",\"updatedInput\":{\"command\":\"cd site; rtk grep -n \\\"WEBMCP_TOOLS\\\\|MCP_TOOLS\\\" src/lib/agent-contract.ts src/lib/developers.ts | head; sed -n 205,220p src/lib/developers.ts; sed -n 60,110p test/webmcp.test.ts; sed -n 220,260p test/webmcp.test.ts; rtk grep -n \\\"agent-contract\\\\|WEBMCP\\\" -n test/agent-contract.test.ts | head\",\"description\":\"Read tool-list contract and existing tests\"}}}\n","stderr":"","exitCode":0,"command":"command hook 1","durationMs":23},"type":"attachment","uuid":"feff4594-2d3a-48a5-90ba-92b206331930","timestamp":"2026-11-14T11:30:48.479Z","session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i-followup/site","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/agent-ready-followup","slug":"i-just-came-across-imperative-newell"}
{"parentUuid":"98751324-9e07-4c83-963b-0c16e6f131e6","isSidechain":false,"promptId":"963fd02e-7472-423f-a255-4540e191abc2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gk8PaS7c7Ji7ufmEgRsqm9","type":"tool_result","content":"src/lib/developers.ts:13:  MCP_TOOLS,\nsrc/lib/developers.ts:202:  return `The server has ${MCP_TOOLS.length} tools, all read-only: one searches, the others each read a capability, a workflow or a page.`;\nsrc/lib/developers.ts:211:export const WEBMCP_TOOLS: readonly string[] = ['search_standard', 'read_capability', 'read_workflow', 'read_page'];\nsrc/lib/developers.ts:215:  `The tools are ${WEBMCP_TOOLS.slice(0, -1).join(', ')} and ${WEBMCP_TOOLS[WEBMCP_TOOLS.length - 1]}, with the names and arguments of the MCP server's tools. They search the site and read a capability, a workflow or a page's Markdown copy, through the same JSON files and copies described here. One difference: search_standard in the page searches the full text of every page with the site's search index. They change nothing and send nothing anywhere but this site.`,\nsrc/lib/developers.ts:218:export { DEVELOPERS_URL, MCP_TOOLS, MCP_URL };\nexport const MCP_CLAUDE_CODE = `claude mcp add --transport http agent-capability-standard ${MCP_URL}`;\nexport function mcpConfig(): string {\n  return JSON.stringify({ mcpServers: { 'agent-capability-standard': { type: 'http', url: MCP_URL } } }, null, 2);\n}\n\n/** The WebMCP tools each page registers, by name, as src/lib/webmcp.ts defines them. */\nexport const WEBMCP_TOOLS: readonly string[] = ['search_standard', 'read_capability', 'read_workflow', 'read_page'];\n\nexport const WEBMCP_LINES: readonly string[] = [\n  'Each page registers read-only tools with the browser\\'s WebMCP interface (document.modelContext, or navigator.modelContext in earlier drafts) when the browser has it. An agent that runs in the browser can call them without leaving the page.',\n  `The tools are ${WEBMCP_TOOLS.slice(0, -1).join(', ')} and ${WEBMCP_TOOLS[WEBMCP_TOOLS.length - 1]}, with the names and arguments of the MCP server's tools. They search the site and read a capability, a workflow or a page's Markdown copy, through the same JSON files and copies described here. One difference: search_standard in the page searches the full text of every page with the site's search index. They change nothing and send nothing anywhere but this site.`,\n];\n\nexport { DEVELOPERS_URL, MCP_TOOLS, MCP_URL };\n  }\n  const tool = (name: string) => {\n    const t = registered.find((r) => r.name === name);\n    if (!t) throw new Error(`${name} is not registered`);\n    return t;\n  };\n  return { registered, tool, fetched, searched };\n}\n\ndescribe('WebMCP tool registration', () => {\n  it('registers the four read-only tools by name', () => {\n    expect(setup().registered.map((t) => t.name)).toEqual(['search_standard', 'read_capability', 'read_workflow', 'read_page']);\n  });\n\n  it('gives every tool a name the draft accepts, verb-led in snake_case', () => {\n    for (const t of setup().registered) {\n      expect(t.name, t.name).toMatch(/^[A-Za-z0-9_.-]{1,128}$/);\n      expect(t.name, t.name).toMatch(/^(search|read)_[a-z]+(_[a-z]+)*$/);\n    }\n  });\n\n  it('describes every tool and parameter, within the size an agent reads', () => {\n    for (const t of setup().registered) {\n      expect(t.description.length, t.name).toBeGreaterThanOrEqual(20);\n      expect(t.description.length, t.name).toBeLessThanOrEqual(500);\n      for (const [k, p] of Object.entries(t.inputSchema.properties)) {\n        expect(typeof p.description, `${t.name}.${k}`).toBe('string');\n        expect((p.description as string).length, `${t.name}.${k}`).toBeGreaterThanOrEqual(10);\n        expect((p.description as string).length, `${t.name}.${k}`).toBeLessThanOrEqual(200);\n      }\n    }\n  });\n\n  it('gives every tool a JSON Schema object input with typed properties and required ones that exist', () => {\n    for (const t of setup().registered) {\n      const s = t.inputSchema;\n      expect(s.type, t.name).toBe('object');\n      expect(s.additionalProperties, t.name).toBe(false);\n      expect(s.required.length, t.name).toBeGreaterThan(0);\n      for (const r of s.required) expect(Object.keys(s.properties), t.name).toContain(r);\n      for (const p of Object.values(s.properties)) {\n        expect(['string', 'integer'], t.name).toContain(p.type);\n        if (typeof p.pattern === 'string') expect(() => new RegExp(p.pattern as string)).not.toThrow();\n      }\n      // The schema survives JSON, as a browser passes it on to an agent.\n      expect(JSON.parse(JSON.stringify(s))).toEqual(s);\n    }\n    const required = Object.fromEntries(setup().registered.map((t) => [t.name, t.inputSchema.required]));\n    expect(required).toEqual({ search_standard: ['query'], read_capability: ['id'], read_workflow: ['id'], read_page: ['path'] });\n  });\n\n  it('turns a Pagefind excerpt into plain text', () => {\n    expect(excerptText('a <mark>b</mark> &amp;&lt;c&gt; &quot;d&quot; &#39;e&#39;')).toBe('a b &<c> \"d\" \\'e\\'');\n  });\n});\n\ndescribe('one set of tool names and id patterns for the MCP server and WebMCP', () => {\n  // An agent that meets both (the MCP server at /mcp and the tools a page\n  // registers) should find the same tool under the same name, taking the\n  // same arguments (review of c24b7af).\n  const web = () => webMcpTools({ origin: ORIGIN, fetch: async () => ({ ok: false, status: 404, text: async () => '' }), loadPagefind: async () => null });\n\n  it('uses the MCP server\\'s tool names', () => {\n    expect(web().map((t) => t.name).sort()).toEqual(TOOLS.map((t) => t.name).sort());\n  });\n\n  it('gives each tool the same argument names, and the id arguments the same patterns', () => {\n    for (const t of web()) {\n      const m = TOOLS.find((x) => x.name === t.name)!;\n      expect(Object.keys(t.inputSchema.properties).sort(), t.name).toEqual(Object.keys(m.inputSchema.properties).sort());\n      for (const k of ['id']) {\n        const a = (t.inputSchema.properties as Record<string, any>)[k];\n        if (a) expect(a.pattern, `${t.name}.${k}`).toBe((m.inputSchema.properties as Record<string, any>)[k].pattern);\n      }\n    }\n  });\n\n  it('takes no upper-case id: every capability and workflow id is lower case', () => {\n    const cap = new RegExp(TOOLS.find((t) => t.name === 'read_capability')!.inputSchema.properties.id.pattern);\n    expect(cap.test('mutate')).toBe(true);\n    expect(cap.test('MUTATE')).toBe(false);\n  });\n});\n\ndescribe('WebMCP search failures', () => {\n  it('rejects an out-of-range limit instead of clamping it, as the MCP tool does', async () => {\n    const { tool } = setup();\n    await expect(tool('search_standard').execute({ query: 'checkpoint', limit: 50 })).rejects.toThrow(/\"limit\" must be an integer from 1 to 25/);\n    await expect(tool('search_standard').execute({ query: 'checkpoint', limit: 0 })).rejects.toThrow(/\"limit\" must be an integer from 1 to 25/);\n  });\n\n  it('drops a result whose fragment fails to load and keeps the others', async () => {\n7:import * as contract from '../src/lib/agent-contract';\n10:import { WEBMCP_TOOLS } from '../src/lib/developers';\n28:    expect([...WEBMCP_TOOLS]).toEqual(webMcpTools(stubDeps).map((t) => t.name));","is_error":false}]},"uuid":"4dffc3e8-5edd-48fc-8540-50d7aa767c67","timestamp":"2026-11-14T11:30:48.805Z","toolUseResult":{"stdout":"src/lib/developers.ts:13:  MCP_TOOLS,\nsrc/lib/developers.ts:202:  return `The server has ${MCP_TOOLS.length} tools, all read-only: one searches, the others each read a capability, a workflow or a page.`;\nsrc/lib/developers.ts:211:export const WEBMCP_TOOLS: readonly string[] = ['search_standard', 'read_capability', 'read_workflow', 'read_page'];\nsrc/lib/developers.ts:215:  `The tools are ${WEBMCP_TOOLS.slice(0, -1).join(', ')} and ${WEBMCP_TOOLS[WEBMCP_TOOLS.length - 1]}, with the names and arguments of the MCP server's tools. 