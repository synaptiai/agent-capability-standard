;\n    if (!p) {\n      p = this.json(`/api/v1/${name}.json`).then((j) => {\n        if (j === null) return null;\n        return listOf(j, [name, 'items', 'data'])\n          .map((r) => toRecordEntry(r, this.origin))\n          .filter((r): r is RecordEntry => r !== null);\n      });\n      this.records.set(name, p);\n    }\n    return p;\n  }\n}\nsrc/worker/tools.ts:291:  const j = (await data.json('/api/v1/diagnostics.json')) as { diagnostics?: unknown } | null;\nsrc/worker/tools.ts:312:  const pages = await data.pages();\nsrc/worker/tools.ts:348:  const record = unwrap(await data.json(apiPath), 'capability');\nsrc/worker/tools.ts:361:  const record = unwrap(await data.json(apiPath), 'workflow');\nsrc/worker/tools.ts:399:  const pages = await data.pages();\n  const modern = method !== 'initialize' && (metaVersion !== undefined || (header !== null && !(LEGACY_VERSIONS as readonly string[]).includes(header)));\n  // server/discover is the probe a client sends before it knows the era; answer it either way.\n  const strict = modern && !(method === 'server/discover' && metaVersion === undefined && header === null);\n\n  try {\n    if (strict) checkModern(request, msg, params, metaVersion);\n    const result = await dispatch(method, params, { modern, data: new SiteData(env.ASSETS, request.url, cfg.origin), cfg });\n    const out =\n      modern || method === 'server/discover'\n        ? { ...result, resultType: 'complete', _meta: { [META_SERVER]: serverInfo(cfg) } }\n        : result;\n    return json({ jsonrpc: '2.0', id, result: out });\n  } catch (e) {\n    if (e instanceof RpcError) return rpcError(id, e);\n    return rpcError(id, new RpcError(-32603, 'Internal error', 500));\n  }\n}","is_error":false}]},"uuid":"d3009359-a75b-4a90-8396-681671f8f848","timestamp":"2026-11-13T15:47:31.664Z","toolUseResult":{"stdout":"  private readonly records = new Map<string, Promise<RecordEntry[] | null>>();\n\n  constructor(\n    private readonly assets: Assets,\n    /** The orig