Of('-->', i + 4);\n    s = end === -1 ? s.slice(0, i) : s.slice(0, i) + s.slice(end + 3);\n  }\n  return s;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":24,"newStart":1,"newLines":37,"lines":["-// Text taken out of HTML or Markdown by removing tags and comments. Each","-// removal repeats until nothing changes, so a removal cannot join two","-// fragments into a new tag or comment (\"<scr<b>ipt>\" leaves no \"<script>\").","+// Text taken out of HTML or Markdown by removing tags and comments. Both are","+// character scans rather than regex replacements, so removing one piece can","+// never join two fragments into a new tag or comment (\"<scr<b>ipt>\" leaves no","+// \"<script>\"; CodeQL js/incomplete-multi-character-sanitization)."," // The results are compared or counted, never written back into a page."," // No imports, so the check scripts can load this with plain Node."," ","-function untilStable(s: string, step: (s: string) => string): string {","-  let prev: string;","-  do {","-    prev = s;","-    s = step(s);","-  } while (s !== prev);","-  return s;","-}","-","-/** `html` with every tag replaced by `replacement` (default: removed). */","+/**","+ * `html` with every tag replaced by `replacement` (default: removed). A \"<\"","+ * opens a tag and nests; text resumes only once every open \"<\" has its \">\".","+ * An unclosed \"<\" drops the rest of the string.","+ */"," export function stripTags(html: string, replacement = ''): string {","-  return untilStable(html, (s) => s.replace(/<[^<>]*>/g, replacement));","+  let out = '';","+  let depth = 0;","+  for (const ch of html) {","+    if (ch === '<') {","+      depth += 1;","+    } else if (ch === '>' && depth > 0) {","+      depth -= 1;","+      if (depth === 0) out += replacement;","+    } else if (depth === 0) {","+      out += ch;","+    }","+  }","+  return out;"," }"," ","-/** `text` with every HTML comment removed. */","+/** `text` with every HTML comment removed; an unclosed \"<!--\" drops the rest. */"," export function stripComments(text: string): string {","-  return untilStable(text, (s) => s.replace(/<!--[\\s\\S]*?-->/g, ''));","+  let s = text;","+  for (let i = s.indexOf('<!--'); i !== -1; i = s.indexOf('<!--')) {","+    const end = s.indexOf('-->', i + 4);","+    s = end === -1 ? s.slice(0, i) : s.slice(0, i) + s.slice(end + 3);","+  }","+  return s;"," }"]}],"originalFile":"// Text taken out of HTML or Markdown by removing tags and comments. Each\n// removal repeats until nothing changes, so a removal cannot join two\n// fragments into a new tag or comment (\"<scr<b>ipt>\" leaves no \"<script>\").\n// The results are compared or counted, never written back into a page.\n// No imports, so the check scripts can load this with plain Node.\n\nfunction untilStable(s: string, step: (s: string) => string): string {\n  let prev: string;\n  do {\n    prev = s;\n    s = step(s);\n  } while (s !== prev);\n  return s;\n}\n\n/** `html` with every tag replaced by `replacement` (default: removed). */\nexport function stripTags(html: string, replacement = ''): string {\n  return untilStable(html, (s) => s.replace(/<[^<>]*>/g, replacement));\n}\n\n/** `text` with every HTML comment removed. */\nexport function stripComments(text: string): string {\n  return untilStable(text, (s) => s.replace(/<!--[\\s\\S]*?-->/g, ''));\n}\n","userModified":false},"sourceToolAssistantUUID":"11e0a4fe-7804-493a-9243-0722a17bec39","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","userType":"external","entrypoint":"cli","cwd":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/wf_08f3cd25-fc3-8","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","version":"2.1.322","gitBranch":"feature/issue-125-site-visuals","slug":"i-just-came-across-imperative-newell"}
