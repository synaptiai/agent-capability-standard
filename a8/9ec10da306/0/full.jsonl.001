{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"0c756982b7572c387b43a8b0cce238a056f9814181481dfc5952cd5eb030e088","message":{"role":"user","content":[{"tool_use_id":"toolu_013Me3juWAYAJVsLT2WszjGE","type":"tool_result","content":"28:export function glyphElement(\n56:export function miniTileElement(id: string, { size = 24, relation, link = true }: { size?: 24 | 32 | 48; relation?: string; link?: boolean } = {}): Element {\n80:export function pixelBarElement(\n(eval):1: no matches found: --include=*.ts\nsrc/pixel/glyphs-pages.ts:49:  // A wrench: open jaw and a handle with a hole.\nsrc/pixel/glyphs-pages.ts:136:  'page:release-notes': ['....#....', '...###...', '...#.#...', '...###...', '...###...', '..#####..', '.##.#.##.', '.#..#..#.', '....#....'],\nsrc/pixel/glyphs-pages.ts:223:  '/community/release-notes/': 'page:release-notes',\nsrc/pixel/glyphs-prose.ts:26:  'lifecycle:draft': 'pencil',\nsrc/pixel/glyphs.ts:222:  // general-purpose: a wrench, its open jaw at the top left and a handle\nsrc/pixel/glyphs.ts:406:  'role:mutating': 'pencil',\nsrc/styles/figures-capability.css:744:    .llinks__row > .pixel-bar,\nsrc/styles/figures-capability.css:949:    .ubars__row > .pixel-bar {\nsrc/styles/figures-domain.css:118:  .meter-row__bar .pixel-bar__track {","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"73bf2cb8761a489dad8004feaa0e3c662b733867bae5cae17ee919f023d9fb3c","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"I'm adding the release timeline. So far I've worked out how the site draws figures on prose pages, and I'm now wiring a release figure into that."},{"type":"tool_use","id":"toolu_014XuwPKGU94uR9KcEgP87cP","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site && sed -n 20,110p src/pixel/hast.ts; grep -rn \"proseFigureEdits\" src | grep -v \"src/twins/prose-blocks.ts:\"; grep -n \"^  '[a-z:-]*'\" src/pixel/glyphs.ts | grep -E \"'(plus|check|close|pencil|wrench|tool|star|bug|arrow|undo|note|stamp|tag|code|diamond|warning|calendar|clock)'\" | head","description":"Read hast helpers and twin wiring, check glyph names"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"8ad6b8b2d203f42d5847647497b3afe48e8234b001c38e81efea56b1f00cc935","message":{"role":"user","content":[{"tool_use_id":"toolu_014XuwPKGU94uR9KcEgP87cP","type":"tool_result","content":"const el = (tagName: string, properties: Element['properties'], children: ElementContent[] = []): Element => ({\n  type: 'element',\n  tagName,\n  properties,\n  children,\n});\nconst text = (value: string): ElementContent => ({ type: 'text', value });\n\nexport function glyphElement(\n  name: string,\n  { scale = 2, label, layer, className }: { scale?: number; label?: string; layer?: string; className?: string } = {},\n): Element {\n  if (!Number.isInteger(scale) || scale < 1) throw new Error(`glyphElement: scale must be a whole number, got ${scale}`);\n  const g = glyph(name);\n  return el(\n    'svg',\n    {\n      className: ['pg', ...(layer ? ['has-layer', 'pg--layer'] : []), ...(className ? [className] : [])],\n      style: layer ? `--layer: var(--layer-${layer}); color: var(--layer)` : undefined,\n      viewBox: `0 0 ${g.w} ${g.h}`,\n      width: g.w * scale,\n      height: g.h * scale,\n      shapeRendering: 'crispEdges',\n      focusable: 'false',\n      role: label ? 'img' : undefined,\n      ariaLabel: label,\n      ariaHidden: label ? undefined : 'true',\n      dataGlyph: name,\n    },\n    placedRects(g).map((r) => {\n      const props: Element['properties'] = { x: String(r.x), y: String(r.y), width: r.w, height: r.h };\n      return el('rect', Object.assign(props, r.attrs));\n    }),\n  );\n}\n\nexport function miniTileElement(id: string, { size = 24, relation, link = true }: { size?: 24 | 32 | 48; relation?: string; link?: boolean } = {}): Element {\n  const cap = loadOntology().capabilities.find((c) => c.id === id);\n  if (!cap) throw new Error(`miniTileElement: ${id} is not a capability in the ontology`);\n  const name = `${id}, ${cap.layer} layer${relation ? `: ${relation}` : ''}`;\n  // As in MiniTile.astro: a linked tile is named by hidden text, not an\n  // aria-label that would leave out the visible symbol (WCAG 2.5.3).\n  const children: ElementContent[] = [el('span', { className: ['mini-tile__symbol'], ariaHidden: 'true', dataPagefindIgnore: '' }, [text(capabilitySymbol(id))])];\n  if (link) children.push(el('span', { className: ['visually-hidden'], dataPagefindIgnore: '' }, [text(name)]));\n  if (size >= 32) children.push(glyphElement(cap.layer, { scale: size === 48 ? 2 : 1, className: 'mini-tile__glyph' }));\n  return el(\n    link ? 'a' : 'span',\n    {\n      className: ['mini-tile', `mini-tile--${size}`, 'has-layer'],\n      href: link ? capabilityHref(id) : undefined,\n      role: link ? undefined : 'img',\n      ariaLabel: link ? undefined : name,\n      style: `--layer: var(--layer-${cap.layer})`,\n      dataCapability: id,\n      dataLayer: cap.layer,\n    },\n    children,\n  );\n}\n\nexport function pixelBarElement(\n  value: number,\n  max: number,\n  { min = 0, digits = 0, label, hideValue = false }: { min?: number; digits?: number; label?: string; hideValue?: boolean } = {},\n): Element {\n  if (!(max > min)) throw new Error(`pixelBarElement: max (${max}) must be above min (${min})`);\n  if (value < min || value > max) throw new Error(`pixelBarElement: ${value} is outside ${min} to ${max}`);\n  const pct = `${(((value - min) / (max - min)) * 100).toFixed(3)}%`;\n  const children: ElementContent[] = [\n    el('span', { className: ['pixel-bar__track'], ariaHidden: 'true' }, [el('span', { className: ['pixel-bar__fill'], style: `width: ${pct}` })]),\n  ];\n  if (!hideValue) children.push(el('span', { className: ['pixel-bar__value'] }, [text(label ?? value.toFixed(digits))]));\n  return el('span', { className: ['pixel-bar'], dataValue: value }, children);\n}\nsrc/twins/index.ts:21:import { proseFigureEdits } from './prose-blocks';\nsrc/twins/index.ts:61:            ...proseFigureEdits(tree, { foldBoxAfter: source === OVERVIEW_SOURCE ? PERIODIC_ANCHOR : undefined }),\n394:  'severity:warning': 'warning',\n396:  'gate:warn': 'warning',\n397:  'gate:rollback': 'undo',\n399:  'fail:rollback': 'undo',\n400:  'approve:auto': 'check',\n404:  'role:verify': 'check',\n405:  'role:rollback': 'undo',\n406:  'role:mutating': 'pencil',","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"796a6e2f8711e145472117fd04324dc758e1b01f6a47045d63f8f3018433b7ca","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01SuhSmzfN24F98WakcTSyaQ","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site && sed -n 30,80p src/twins/index.ts; grep -n \"^  [a-z-]*: \\[\\|^  '[a-z-]*': \\[\" src/pixel/glyphs.ts | sed 's/: \\[.*//' | tr -d \" '\" | tr '\\n' ' ' | head -c 2500","description":"Read twin wiring and list base glyph names"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"3c49af787fb002089333894edd4fb63bb349b383017bbcd75fe935a6044161a9","message":{"role":"user","content":[{"tool_use_id":"toolu_01SuhSmzfN24F98WakcTSyaQ","type":"tool_result","content":"export type { Twin };\n\nconst cache = new Map<string, Promise<Twin>>();\n\n/** The Markdown copy of a route's page, built once per build. */\nexport function twinFor(route: Route): Promise<Twin> {\n  let t = cache.get(route.url);\n  if (!t) {\n    t = buildTwin(route);\n    cache.set(route.url, t);\n  }\n  return t;\n}\n\nasync function buildTwin(route: Route): Promise<Twin> {\n  switch (route.template) {\n    case 'prose':\n    case 'spec':\n    case 'rfc':\n    case 'skill':\n    case 'raw': {\n      const source = route.source!;\n      const meta = await sourceMeta(route);\n      const title = route.template === 'spec' ? route.title : meta.title;\n      // Prose, RFC and skill pages draw figures from their own fences; each gets its block before the fence.\n      // A composed skill's page also draws figures from data under its H2s; each gets its block there.\n      const skillDir = route.template === 'skill' ? source.split('/')[1] : undefined;\n      const skillEdits = skillDir !== undefined && skillDir in COMPOSED_SKILLS ? skillFigureEdits(skillDir, source) : undefined;\n      const extraEdits = PROSE_TEMPLATES.has(route.template)\n        ? (tree: Root) => [\n            ...proseFigureEdits(tree, { foldBoxAfter: source === OVERVIEW_SOURCE ? PERIODIC_ANCHOR : undefined }),\n            ...(skillEdits ? skillEdits(tree) : []),\n          ]\n        : undefined;\n      const copy = markdownCopy(source, readRepoFile(source), { sourceNote: true, title: meta.title, extraEdits });\n      // The Standard's site-drawn figures add their text equivalents (visual spec 3.9),\n      // and so do the prose and RFC figures whose words are not in the source (3.10).\n      const older = loadVersions().standard.previous.find((v) => v.source === source);\n      const figures =\n        route.template !== 'spec'\n          ? await proseFigureBlocks(route)\n          : source === loadVersions().standard.current.source\n            ? specFigureBlocks()\n            : older && SLOTS_BY_VERSION[older.version]\n              ? specOlderBlocks(source, SLOTS_BY_VERSION[older.version]!)\n              : [];\n      return { title, description: meta.description, markdown: figures.length > 0 ? blocks(copy, ...figures) : copy };\n    }\n    case 'home':\n      return homeTwin();\n123:flag 124:pencil 125:stamp 126:undo 127:diamond 128:fork 129:nested 130:check 131:eye 132:search 133:menu 134:close 135:sun 136:moon 137:half 138:chevron-left 139:chevron-right 140:copy 141:external 142:hash 144:code 146:note 147:warning 149:caution 164:stop 227:folder 229:group 233:empty 263:pip","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"5571e480fcf19c549044e49ce996366d6655acb25e9015837f936ff4f8370072","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_018CjHp43T1S3DKxbRmg3F27","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site && grep -n \"export function skillFigureEdits\" -A40 src/twins/skills.ts | head -50; grep -n \"skillFigureEdits\\|skill-figures\\|skillFigures\" src/plugins/*.ts | head","description":"Read the skill figure edits pattern"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"1b64aaa28db927f305bff42e3d7cf34ed6e61ac1ac21df193ff834bbdca8b90a","message":{"role":"user","content":[{"tool_use_id":"toolu_018CjHp43T1S3DKxbRmg3F27","type":"tool_result","content":"103:export function skillFigureEdits(dir: string, source: string): (tree: Root) => { start: number; end: number; text: string }[] {\n104-  const figs = composedSkillFigures(dir, readRepoFile(source), source);\n105-  return (tree) =>\n106-    Object.entries(figs).map(([key, list]) => {\n107-      const want = SKILL_HEADINGS[key];\n108-      if (!want) throw new Error(`twins: no heading text for the skill figure key ${key}`);\n109-      const h = tree.children.find((n): n is Heading => n.type === 'heading' && n.depth === 2 && headingText(n).trim() === want);\n110-      const end = h?.position?.end.offset;\n111-      if (end === undefined) throw new Error(`twins: ${source} has no \"## ${want}\" for its figures`);\n112-      return { start: end, end, text: `\\n\\n${list.map((f) => skillFigureBlock(dir, f)).join('\\n\\n')}` };\n113-    });\n114-}","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"aa8704dfdd8d099361ef2805f15ad343bbed86a2d1663254dc0829f64b11928f","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_017towYCWKg7fgtoqQiXbFte","name":"Bash","input":{"command":"cd /Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site && sed -n 1,72p src/plugins/rehype-prose-figures.ts; grep -n \"^async function proseFigureBlocks\\|export async function proseFigureBlocks\" -A30 src/twins/*.ts | head -40","description":"Read plugin imports and prose figure block builder"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"2078f7c30b4a04b3203dbc7121d9d338ffda914791049da81f1d2bb005804006","message":{"role":"user","content":[{"tool_use_id":"toolu_017towYCWKg7fgtoqQiXbFte","type":"tool_result","content":"// Figures drawn into prose pages, RFCs and skill pages from what the Markdown\n// already holds (visual spec 3.10). Nothing here changes the source text: each\n// mark sits beside the words it is drawn from, and the words stay.\n//\n// - Box diagrams (3.10.4): a plain or `text` fence with at least two lines of\n//   box-drawing characters or tree connectors is framed as a figure with the\n//   eyebrow \"Diagram\" and the name \"Diagram: {heading}\". The text is its own\n//   text equivalent.\n// - Pattern fences (3.10.9): a YAML fence with a `capabilities:` list gets a\n//   chain of capability tiles above it, in the order of its `flow:` lines\n//   (`N. cap(args) → out`) when it has them, each arrow named by the output it\n//   passes on. A fence that a mermaid figure already draws (the next block) is\n//   left alone, and a fence naming an id the ontology lacks is skipped and\n//   reported on the console, not failed.\n// - Enriched tables (3.10.11): a number column gets a pixel bar per row on one\n//   scale; a yes/no or ✓/— column gets check and cross glyphs; a Risk column\n//   gets pips; a capability column (an id, or an id and its parameters in\n//   parentheses) gets a 24px tile; a coverage grid whose\n//   cells list `domain:` values gets a count badge per cell. The cell text\n//   stays; the marks are aria-hidden or carry their own words.\n// - Workflow cells (3.10.10): a cell holding only a backticked workflow id gets\n//   a 10px step strip after it.\n// - Capability chains (3.10.8): a cell made only of capability ids joined by →\n//   becomes a row of tiles, the text kept as visually hidden words.\n// - RFC pages (3.10.12): the \"Goals\" and \"Non-goals\" H2s start with a check\n//   and a cross glyph, aria-hidden, so the headings and their ids read as before.\n// - F-O1 (3.10.14): on the OASF safety proposal, under \"4.1\", the OASF\n//   categories and the capabilities each maps to, from the mapping file.\n// - Figures are numbered \"Fig n\" in page order, mermaid figures included.\n//\n// It runs on prose, RFC and skill pages only; the Standard and the generated\n// pages draw their own figures.\nimport type { Element, ElementContent, Root, RootContent } from 'hast';\nimport type { VFile } from 'vfile';\nimport { loadOasfMapping, OASF_MAPPING_TYPES, type OasfMappingType } from '../data/oasf';\nimport { loadOntology } from '../data/ontology';\nimport { loadWorkflows } from '../data/workflows';\nimport { workflowHref } from '../lib/generated';\nimport { routeForSource } from '../lib/routes';\nimport { diagramSteps } from '../lib/views';\nimport { glyphElement, miniTileElement, pixelBarElement } from '../pixel/hast';\nimport { sourceOf } from './source';\n\nconst PLUGIN = 'rehype-prose-figures';\n\n/** Templates whose Markdown this plugin draws into. */\nexport const PROSE_TEMPLATES: ReadonlySet<string> = new Set(['prose', 'rfc', 'skill']);\n\n/** The source whose section \"4.1\" gets figure F-O1. */\nexport const OASF_PROPOSAL = 'docs/proposals/OASF_SAFETY_EXTENSIONS.md';\n/** The heading F-O1 is placed under, by the start of its text. */\nexport const OASF_ANCHOR = '4.1 ';\n\n// ---------- small hast helpers ----------\n\nconst el = (tagName: string, properties: Element['properties'], children: ElementContent[] = []): Element => ({\n  type: 'element',\n  tagName,\n  properties,\n  children,\n});\nconst text = (value: string): ElementContent => ({ type: 'text', value });\n\nconst isEl = (n: unknown, tag?: string): n is Element =>\n  typeof n === 'object' && n !== null && (n as Element).type === 'element' && (tag === undefined || (n as Element).tagName === tag);\n\nconst classes = (e: Element): string[] => {\n  const c = e.properties?.className;\n  return Array.isArray(c) ? c.map(String) : [];\n};\n\n/** All text of a node, aria-hidden parts included. */\nsrc/twins/prose.ts:19:export async function proseFigureBlocks(route: Route): Promise<string[]> {\nsrc/twins/prose.ts-20-  const out: string[] = [];\nsrc/twins/prose.ts-21-  if (route.template === 'rfc' && isNumberedRfc(route.source)) {\nsrc/twins/prose.ts-22-    const entry = await getEntry('docs', route.source!);\nsrc/twins/prose.ts-23-    const page = entry ? ((await render(entry)).remarkPluginFrontmatter.page as PageMeta | undefined) : undefined;\nsrc/twins/prose.ts-24-    if (page?.status) out.push(`**Lifecycle.** ${lifecycleSentence(rfcLifecycle(page.status, allowedRfcStatuses(), route.source!), page.date)}`);\nsrc/twins/prose.ts-25-  }\nsrc/twins/prose.ts-26-  if (route.source === OASF_PROPOSAL) out.push(oasfMapTwin());\nsrc/twins/prose.ts-27-  if (route.source === OVERVIEW_SOURCE) {\nsrc/twins/prose.ts-28-    const o = loadOntology();\nsrc/twins/prose.ts-29-    out.push(figure('The periodic table of agent capabilities', periodicCaption(o), table(['Layer', 'Capabilities'], o.layers.map((l) => [l.id, l.capabilities.map(code).join(', ')]))));\nsrc/twins/prose.ts-30-  }\nsrc/twins/prose.ts-31-  return out;\nsrc/twins/prose.ts-32-}","is_error":false}]}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"4a45e708a99762612398016136a3ab87150835084325bfc69f20f6789d38b234","message":{"role":"system","content":"<new-diagnostics>The following new diagnostic issues were detected:\n\nskills.ts:\n  ✘ [Line 85:56] Parameter 'f' implicitly has an 'any' type. [7006] (typescript)\n\nskill-figures.test.ts:\n  ✘ [Line 7:31] Cannot find module '../src/data/workflows' or its corresponding type declarations. [2307] (typescript)\n  ✘ [Line 16:8] Cannot find module '../src/lib/skill-figures' or its corresponding type declarations. [2307] (typescript)\n  ✘ [Line 17:40] Cannot find module './independent' or its corresponding type declarations. [2307] (typescript)\n  ✘ [Line 26:15] Parameter 'l' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 27:11] Parameter 'h' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 50:29] Parameter 's' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 61:36] Parameter 'l' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 62:34] Parameter 'l' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 62:37] Parameter 'i' implicitly has an 'any' type. [7006] (typescript)\n  ✘ [Line 69:22] Parameter 's' implicitly has an 'any' type. [7006] (typescript)</new-diagnostics>"}}
{"type":"api-request-blob","sessionId":"ef9f3fc8-12b6-4fe4-9f49-aaeedec05648","hash":"a30008f39af14d57fa8f36ad74d4a46448d197dfceb669f0857acfa54e2fe1f9","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Now writing the parser and the figures:"},{"type":"tool_use","id":"toolu_015eXkkiPNvZvxVcPeP9AtUA","name":"Write","input":{"file_path":"/Users/danielbentes/agent-capability-standard/.claude/worktrees/i125-relnotes/site/src/lib/release-figures.ts","content":"// The release notes page's figures (issue #125), drawn from CHANGELOG.md's own\n// structure: no diagram is written into the changelog, because each version's\n// section becomes its GitHub Release notes.\n//\n// - The release timeline: one row per section (\"## [Unreleased]\" and each\n//   \"## [vX.Y.Z] — date\"), with a bar per change kind (\"### Added\", …)\n//   counting the top-level list entries under it.\n// - Under a long kind section (LONG_SECTION entries or more): which parts of\n//   the repository its entries name, by the first segment of each backticked\n//   path, and the diagnostic codes they name. The page then shows the first\n//   SHOWN_ENTRIES entries and folds the rest; the Markdown copy keeps them all.\n\n/** A kind section with this many entries or more gets its own figure and folds. */\nexport const LONG_SECTION = 8;\n/** How many entries of a long kind section stay open on the page. */\nexport const SHOWN_ENTRIES = 5;\n\n/** The repository areas an entry can name, by the first path segment. */\nexport const AREAS: readonly string[] = [\n  'core', 'grounded_agency', 'spec', 'schemas', 'skills', 'hooks', 'tools', 'scripts',\n  'tests', 'benchmarks', 'examples', 'templates', 'docs', 'site', '.github',\n];\n\nexport interface ReleaseEntry {\n  text: string;\n  areas: string[];\n  codes: string[];\n}\n\nexport interface KindSection {\n  kind: string;\n  entries: ReleaseEntry[];\n}\n\nexport interface Release {\n  /** \"Unreleased\" or the version as the heading writes it, e.g. \"v2.0.0\". */\n  version: string;\n  date: string | null;\n  /** The heading text as written, e.g. \"[v2.0.0] — 2026-10-29\". */\n  heading: string;\n  kinds: KindSection[];\n}\n\nconst RELEASE = /^## \\[([^\\]]+)\\](?:\\s+—\\s+(\\d{4}-\\d{2}-\\d{2}))?\\s*$/;\nconst KIND = /^### (.+?)\\s*$/;\nconst CODE = /\\b[VWFSRB]\\d{3}\\b/g;\n\n/** The areas an entry names: the first segment of each backticked path. */\nexport function entryAreas(entry: string): string[] {\n  const found = new Set<string>();\n  for (const m of entry.matchAll(/`([^`\\s]+)`/g)) {\n    const first = m[1]!.replace(/^\\.\\//, '').split('/')[0]!;\n    if (m[1]!.includes('/') && AREAS.includes(first)) found.add(first);\n  }\n  return AREAS.filter((a) => found.has(a));\n}\n\n/** The diagnostic codes an entry names, in first-seen order. */\nexport function entryCodes(entry: string): string[] {\n  return [...new Set(entry.match(CODE) ?? [])];\n}\n\n/** The changelog's release sections, in file order (newest first). */\nexport function parseReleases(changelog: string): Release[] {\n  const out: Release[] = [];\n  let rel: Release | null = null;\n  let kind: KindSection | null = null;\n  let entry: string[] | null = null;\n  const closeEntry = () => {\n    if (entry && kind) {\n      const t = entry.join('\\n');\n      kind.entries.push({ text: t, areas: entryAreas(t), codes: entryCodes(t) });\n    }\n    entry = null;\n  };\n  for (const line of changelog.split('\\n')) {\n    const r = RELEASE.exec(line);\n    if (r) {\n      closeEntry();\n      rel = { version: r[1]!, date: r[2] ?? null, heading: line.slice(3).trim(), kinds: [] };\n      out.push(rel);\n      kind = null;\n      continue;\n    }\n    if (/^## /.test(line) || /^# /.test(line)) {\n      closeEntry();\n      rel = null;\n      kind = null;\n      continue;\n    }\n    const k = KIND.exec(line);\n    if (k && rel) {\n      closeEntry();\n      kind = { kind: k[1]!, entries: [] };\n      rel.kinds.push(kind);\n      continue;\n    }\n    if (!kind) continue;\n    if (/^- /.test(line)) {\n      closeEntry();\n      entry = [line.slice(2)];\n    } else if (entry && /^\\s+\\S/.test(line)) {\n      entry.push(line.trim());\n    } else if (entry && line.trim() !== '') {\n      closeEntry();\n    }\n  }\n  closeEntry();\n  if (out.length === 0) throw new Error('CHANGELOG.md: no \"## [version]\" section');\n  return out;\n}\n\n/** The change kinds in the order the changelog first uses them. */\nexport function kindsInUse(releases: Release[]): string[] {\n  const seen: string[] = [];\n  for (const r of releases) for (const k of r.kinds) if (!seen.includes(k.kind)) seen.push(k.kind);\n  return seen;\n}\n\n/** Entries of one kind in one release (0 when the release has no such section). */\nexport function kindCount(r: Release, kind: string): number {\n  return r.kinds.filter((k) => k.kind === kind).reduce((n, k) => n + k.entries.length, 0);\n}\n\nconst plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;\n\nexport const TIMELINE_TITLE = 'Releases and the entries under each kind of change, newest first';\n\nexport function timelineCaption(releases: Release[]): string {\n  const kinds = kindsInUse(releases);\n  const total = releases.reduce((n, r) => n + r.kinds.reduce((m, k) => m + k.entries.length, 0), 0);\n  const top = [...releases].sort((a, b) => kindTotal(b) - kindTotal(a))[0]!;\n  const dated = releases.filter((r) => r.date);\n  const span = dated.length > 0 ? ` from ${dated.at(-1)!.date} to ${dated[0]!.date}` : '';\n  return `${plural(releases.length, 'section', 'sections')}${span}, ${plural(total, 'entry', 'entries')} under ${kinds.join(', ')}; ${top.version} has the most (${kindTotal(top)}). Each bar counts the top-level list entries under that heading.`;\n}\n\nexport function kindTotal(r: Release): number {\n  return r.kinds.reduce((n, k) => n + k.entries.length, 0);\n}\n\nexport function sectionTitle(r: Release, k: KindSection): string {\n  return `What the ${k.entries.length} ${k.kind.toLowerCase()} entries of ${r.version} name`;\n}\n\n/** Areas with the number of entries naming each, most first; entries naming none counted apart. */\nexport function areaCounts(k: KindSection): { rows: { area: string; count: number }[]; none: number } {\n  const rows = AREAS.map((area) => ({ area, count: k.entries.filter((e) => e.areas.includes(area)).length }))\n    .filter((r) => r.count > 0)\n    .sort((a, b) => b.count - a.count || AREAS.indexOf(a.area) - AREAS.indexOf(b.area));\n  return { rows, none: k.entries.filter((e) => e.areas.length === 0).length };\n}\n\n/** The diagnostic codes a section's entries name, sorted. */\nexport function sectionCodes(k: KindSection): string[] {\n  return [...new Set(k.entries.flatMap((e) => e.codes))].sort();\n}\n\nexport function sectionCaption(r: Release, k: KindSection): string {\n  const { rows, none } = areaCounts(k);\n  const codes = sectionCodes(k);\n  const areas = rows.length > 0 ? `the most name ${rows[0]!.area}/ (${rows[0]!.count})` : 'none names a repository path';\n  return `${plural(k.entries.length, 'entry', 'entries')}: ${areas}; ${plural(none, 'entry names', 'entries name')} no path; ${codes.length === 0 ? 'no diagnostic code is named' : `${plural(codes.length, 'diagnostic code is', 'diagnostic codes are')} named`}. An area counts an entry when the entry names a path in it in code formatting.`;\n}\n\n/** The long kind sections: those that get a figure and fold. */\nexport function longSections(releases: Release[]): { release: Release; section: KindSection }[] {\n  return releases.flatMap((release) => release.kinds.filter((k) => k.entries.length >= LONG_SECTION).map((section) => ({ release, section })));\n}\n"},"caller":{"type":"direct"}}]}}
