{
  "name": "acs-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-contrast.mjs && node scripts/check-design-data.mjs && astro build --force && pagefind --site dist --exclude-selectors \".page-actions, .toc, .heading-anchor\" && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-contrast.mjs && node scripts/check-design-data.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "astro": "7.4.5",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-autolink-headings": "7.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "unist-util-visit-parents": "6.1.0",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "pagefind": "1.6.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
