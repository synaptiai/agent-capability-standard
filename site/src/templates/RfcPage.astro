---
// An RFC or proposal. Its `**Status:**` line (Draft, Accepted, Draft Proposal)
// is exposed for the status badge.
import type { Route } from '../lib/routes';
import type { PageMeta } from '../plugins/remark-page-meta';

interface Props {
  route: Route;
  page: PageMeta;
}

const { page } = Astro.props;
---
<article class="doc doc--rfc" data-status={page.status ?? undefined} data-pagefind-body>
  <slot />
</article>
