---
// The domains overview: docs/domains/README.md as written (its H1 is the page
// H1). Before its "Choosing a Domain" section come the profile cards (F-DI1,
// visual spec 3.6), one per domain profile: its glyph, its trust weights as a
// dot strip on one scale shared by every card, and its minimum confidence,
// then one computed sentence grouping the profiles by what happens at low,
// medium and high risk. Without that heading they follow the README. Under
// each H3 of "Choosing a Domain" that names a profile goes what that profile
// sets, and under "How Domains Demonstrate Domain-Agnostic Capabilities" the
// domain parameter the capability it names takes in each catalog.
import { getEntry, render } from 'astro:content';
import Figure from '../../components/fig/Figure.astro';
import DomainGlance from '../../components/fig/DomainGlance.astro';
import DomainParameter from '../../components/fig/DomainParameter.astro';
import { AGNOSTIC_ANCHOR, headingProfileKey, parameterAcross } from '../../lib/domain-index';
import { cutAfter } from '../../lib/domain-usage';
import { readRepoFile } from '../../lib/repo';
import { loadProfiles } from '../../data/profiles';
import DocLayout from '../../layouts/DocLayout.astro';
import { domainGlyph, evidencePolicy, h2Section, profilesCaption, thresholdsSentence, trustAxis } from '../../lib/domain-figures';
import { domainHref, refSlugger, routeByUrl } from '../../lib/generated';
import { sortedTrustWeights } from '../../lib/views';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import type { PageMeta } from '../../plugins/remark-page-meta';
import '../../styles/figures-domain.css';

/** The README heading the cards and the sentence go before. */
const CHOOSING_ANCHOR = 'choosing-a-domain';

const route = routeByUrl('/domains/');
const entry = await getEntry('docs', route.source!);
if (!entry) throw new Error(`domains: no docs entry for ${route.source}`);
const { remarkPluginFrontmatter } = await render(entry);
if (typeof entry.rendered?.html !== 'string') throw new Error(`domains: ${route.source} has no rendered HTML`);
const html = entry.rendered.html;
const at = h2Section(html, CHOOSING_ANCHOR)?.start ?? html.length;
if (at === html.length) console.warn(`domains: ${route.source} has no #${CHOOSING_ANCHOR}; the profile cards follow the README`);
const page = remarkPluginFrontmatter.page as PageMeta | undefined;
const profiles = loadProfiles();
const id = refSlugger();
const axis = trustAxis(profiles);
const keys = profiles.map((p) => p.key);
const param = parameterAcross(readRepoFile(route.source!));
// The README after the profile cards, cut after each H3 of "Choosing a
// Domain" that names a profile and after the domain-agnostic H2.
const choosing = h2Section(html, CHOOSING_ANCHOR);
const pieces = cutAfter(html.slice(at), (h) => {
  if (h.level === 2 && h.id === AGNOSTIC_ANCHOR && param) return 'param';
  if (h.level !== 3 || !choosing) return null;
  return headingProfileKey(h.text, keys);
});
let figN = 1;
const pct = (v: number) => `${(((v - axis.min) / (axis.max - axis.min)) * 100).toFixed(3)}%`;
---
<DocLayout route={route} title={page?.title ?? route.title} description={route.description ?? page?.description}>
  <article class="doc doc--domains" data-pagefind-body>
    <div class="doc__body" set:html={html.slice(0, at)} />
    <section class="domain-profiles">
      <h2 id={id('Domain profiles')}>Domain profiles</h2>
      <Figure id={id('Figure profile cards')} n={1} title="Trust weights of each profile" caption={profilesCaption(profiles)} kind="profile-cards">
        <ul class="profile-cards">
          {profiles.map((d) => {
            const w = sortedTrustWeights(d.profile);
            const conf = evidencePolicy(d.profile)?.minimumConfidence ?? null;
            return (
              <li data-domain={d.key}>
                <a class="profile-card" href={domainHref(d.key)}>
                  <span class="profile-card__head"><PixelGlyph name={domainGlyph(d.key)} scale={3} />{d.key}</span>
                  {w.length > 0 && (
                    <>
                      <span class="profile-card__strip" aria-hidden="true">
                        {w.map((x) => <span class="profile-card__tick" style={`left: ${pct(x.weight)}`}></span>)}
                      </span>
                      <span class="profile-card__axis" aria-hidden="true"><span>{axis.min.toFixed(2)}</span><span>{axis.max.toFixed(2)}</span></span>
                      <span class="profile-card__facts profile-card__facts--range">{w.length} trust weights, {w.at(-1)!.weight.toFixed(2)} to {w[0]!.weight.toFixed(2)}</span>
                    </>
                  )}
                  {conf !== null && (
                    <span class="profile-card__facts profile-card__facts--conf">Minimum confidence <span class="profile-card__number">{conf.toFixed(2)}</span></span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </Figure>
      <p class="domain-thresholds">{thresholdsSentence(profiles)}</p>
    </section>
    {pieces.map((piece) => (
      <>
        <div class="doc__body" set:html={piece.html} />
        {piece.after === 'param' && param && <DomainParameter data={param} n={++figN} id={id('Figure domain parameter')} />}
        {piece.after && piece.after !== 'param' && (
          <DomainGlance profile={profiles.find((p) => p.key === piece.after)!} n={++figN} id={id(`Figure profile ${piece.after}`)} />
        )}
      </>
    ))}
  </article>
</DocLayout>
