---
// One page per domain profile (design notes, ia-home 6.6; visual spec 3.5):
// the domain README's H1 (with the id GitHub gives it) and lead, its sections
// up to "Domain Profile", then under that H2 the profile values from
// schemas/profiles/<domain>.yaml drawn as figures (F-D1 to F-D5 and F-D7),
// which are authoritative where the README repeats them, with the README's
// own text of that section in a <details> under them (a README with no such
// section gets a "Profile values" H2 after its lead), then the rest of the
// README with a card (F-D6) under the H3 of each
// workflow the profile lists. A workflow no H3 matches gets its card in a
// "Workflows in this profile" section at the end. A listed id that no
// catalog defines is shown as proposed.
import { getEntry, render } from 'astro:content';
import ValueList from '../../components/ValueList.astro';
import ApprovalLadder from '../../components/fig/DomainApprovalLadder.astro';
import CheckpointPolicy from '../../components/fig/DomainCheckpointPolicy.astro';
import CompliancePanel from '../../components/fig/DomainCompliancePanel.astro';
import DomainSources from '../../components/fig/DomainSources.astro';
import EvidencePolicy from '../../components/fig/DomainEvidencePolicy.astro';
import TrustWeights from '../../components/fig/DomainTrustWeights.astro';
import WorkflowCard from '../../components/fig/DomainWorkflowCard.astro';
import DomainUsage from '../../components/fig/DomainUsage.astro';
import { capabilityUsage, COMPLIANCE_ANCHOR, cutAfter, listedCapabilities, type UsageExample } from '../../lib/domain-usage';
import { readRepoFile } from '../../lib/repo';
import { loadWorkflows } from '../../data/workflows';
import { loadProfiles } from '../../data/profiles';
import DocLayout from '../../layouts/DocLayout.astro';
import { approvalLadder, domainGlyph, foldCapabilityList, splitReadme, type ReadmeParts } from '../../lib/domain-figures';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import { refSlugger, routesByTemplate } from '../../lib/generated';
import { githubBlobUrl } from '../../lib/repo';
import type { Route } from '../../lib/routes';
import { PROFILE_SECTION_KEYS, sortedTrustWeights, splitAtFirstH2 } from '../../lib/views';
import type { PageMeta } from '../../plugins/remark-page-meta';
import '../../styles/figures-domain.css';

export function getStaticPaths() {
  const profiles = loadProfiles();
  return routesByTemplate('domain').map((route) => {
    const d = profiles.find((p) => `/domains/${p.key}/` === route.url);
    if (!d) throw new Error(`domains: no profile for ${route.url}`);
    return { params: { domain: d.key }, props: { route, key: d.key } };
  });
}

interface Props {
  route: Route;
  key: string;
}

type Obj = Record<string, unknown>;
const isObj = (v: unknown): v is Obj => typeof v === 'object' && v !== null && !Array.isArray(v);

const { route, key } = Astro.props;
const d = loadProfiles().find((p) => p.key === key)!;
const p = d.profile;
const id = refSlugger();
const weights = sortedTrustWeights(p);
const thresholds = isObj(p.risk_thresholds) ? p.risk_thresholds : null;
const checkpointPolicy = isObj(p.checkpoint_policy) ? p.checkpoint_policy : null;
const evidence = isObj(p.evidence_policy) ? p.evidence_policy : null;
const sources = Array.isArray(p.domain_sources) ? p.domain_sources.filter(isObj) : [];
const compliance = isObj(p.compliance) ? p.compliance : null;
const other = Object.fromEntries(Object.entries(p).filter(([k]) => !PROFILE_SECTION_KEYS.has(k)));
// Figures are numbered in page order.
let figures = 0;
const fig = () => ++figures;

// The README's rendered HTML is split before its first H2 so the generated
// sections can sit between its lead and its sections.
let readme: { head: string; rest: string } | null = null;
let parts: ReadmeParts | null = null;
let page: PageMeta | undefined;
if (d.readme) {
  const entry = await getEntry('docs', d.readme);
  if (!entry) throw new Error(`domains: no docs entry for ${d.readme}`);
  const r = await render(entry);
  if (typeof entry.rendered?.html !== 'string') throw new Error(`domains: ${d.readme} has no rendered HTML`);
  readme = splitAtFirstH2(entry.rendered.html);
  parts = splitReadme(readme.rest, d.workflows.map((w) => w.id));
  page = r.remarkPluginFrontmatter.page as PageMeta | undefined;
}
// The README's own blocks drawn as figures: each "Capability Usage" example
// after its H3, and the capability list of a proposed workflow on its card.
const readmeText = d.readme ? readRepoFile(d.readme) : '';
const usage = d.readme ? capabilityUsage(readmeText, d.readme) : [];
const usageByHeading = new Map<string, UsageExample>(usage.map((u) => [u.heading, u]));
const defined = loadWorkflows().byId;
const listed = (wid: string) => (defined.has(wid) || !d.readme ? null : listedCapabilities(readmeText, wid));
/** Whether a workflow's card draws its steps or listed capabilities, so the README list under it can fold. */
const cardDraws = (wid: string | null) => wid !== null && (defined.has(wid) || listed(wid) !== null);
// The compliance panel goes under the README's own "Regulatory Compliance"
// H2 when it has one, where the text discusses the same standards.
const complianceInReadme = compliance !== null && parts !== null && parts.segments.some((sg) => sg.html.includes(`id="${COMPLIANCE_ANCHOR}"`));
const pickHeading = (h: { level: number; id: string; text: string }) =>
  h.level === 3 && usageByHeading.has(h.text) ? `usage:${h.text}` : complianceInReadme && h.level === 2 && h.id === COMPLIANCE_ANCHOR ? 'compliance' : null;
const unplaced = parts ? parts.unplaced : d.workflows.map((w) => w.id);
if (parts && unplaced.length > 0) console.warn(`domains: ${d.key}: no README heading for ${unplaced.join(', ')}; their cards go at the end`);
const title = page?.title ?? `${d.key} domain`;
// The hero under the title: the domain's glyph and four facts from the profile.
const ladder = approvalLadder(p);
const blockedCount = ladder?.blocked.length ?? 0;
const facts = [
  { term: 'Trust sources', value: String(weights.length) },
  { term: 'Domain sources', value: String(sources.length) },
  { term: 'Workflows', value: String(d.workflows.length) },
  ...(ladder ? [{ term: 'Never run on their own', value: String(blockedCount) }] : []),
];
---
<DocLayout route={route} title={title} description={d.description || page?.description}>
  <article class="doc doc--domain" data-domain={d.key} data-pagefind-body>
    {readme ? (
      <div class="doc__body" set:html={readme.head} />
    ) : (
      <h1 id={id(title)}>{title}</h1>
    )}
    <div class="domain-hero">
      <PixelGlyph name={domainGlyph(d.key)} scale={6} class="domain-hero__glyph" />
      <dl class="domain-hero__facts">
        {facts.map((f) => <div><dt>{f.term}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
    {parts && parts.before !== '' && <div class="doc__body" set:html={parts.before} />}

    <section class="profile-values" data-profile={d.profileFile}>
      {parts?.profileHeading ? (
        <div class="doc__body" set:html={parts.profileHeading} />
      ) : (
        <h2 id={id('Profile values')}>Profile values</h2>
      )}
      <p>
        These values are read from <a href={githubBlobUrl(d.profileFile)}><code>{d.profileFile}</code></a>, profile
        version {d.version}. Where the text on this page repeats them, these values are the ones that apply.
        {p.trust_model_reviewed === true && typeof p.trust_model_reviewed_at === 'string' && (
          <> The trust model was reviewed on {p.trust_model_reviewed_at}.</>
        )}
      </p>
      {d.description && <p class="profile-values__description">{d.description}</p>}

      {weights.length > 0 && (
        <>
          <h3 id={id('Trust weights')}>Trust weights</h3>
          <p>Higher weights mean the source is trusted more.</p>
          <TrustWeights profile={p} n={fig()} id={id('Figure trust weights')} />
        </>
      )}

      {thresholds && (
        <>
          <h3 id={id('Risk thresholds')}>Risk thresholds</h3>
          <ApprovalLadder profile={p} n={fig()} id={id('Figure approval ladder')} />
        </>
      )}

      {checkpointPolicy && (
        <>
          <h3 id={id('Checkpoint policy')}>Checkpoint policy</h3>
          <CheckpointPolicy profile={p} n={fig()} id={id('Figure checkpoint policy')} />
        </>
      )}

      {evidence && (
        <>
          <h3 id={id('Evidence policy')}>Evidence policy</h3>
          <EvidencePolicy profile={p} n={fig()} id={id('Figure evidence policy')} />
        </>
      )}

      {sources.length > 0 && (
        <>
          <h3 id={id('Domain sources')}>Domain sources</h3>
          <DomainSources profile={p} n={fig()} id={id('Figure domain sources')} />
        </>
      )}

      {compliance && !complianceInReadme && (
        <>
          <h3 id={id('Compliance')}>Compliance</h3>
          <CompliancePanel profile={p} n={fig()} id={id('Figure compliance')} />
        </>
      )}

      {Object.keys(other).length > 0 && (
        <>
          <h3 id={id('Other profile fields')}>Other profile fields</h3>
          <ValueList value={other} />
        </>
      )}
      {parts?.profileBody && (
        <details class="domain-guide">
          <summary>As written in the domain guide</summary>
          <div class="doc__body" set:html={parts.profileBody} />
        </details>
      )}
    </section>

    {parts && parts.segments.map((seg, i) => (
      <>
        {cutAfter(i > 0 && cardDraws(parts!.segments[i - 1]!.after) ? foldCapabilityList(seg.html) : seg.html, pickHeading).map((piece) => (
          <>
            <div class="doc__body" set:html={piece.html} />
            {piece.after?.startsWith('usage:') && (
              <DomainUsage usage={usageByHeading.get(piece.after.slice('usage:'.length))!} profile={p} domain={d.key} n={fig()} id={id(`Figure usage ${piece.after}`)} />
            )}
            {piece.after === 'compliance' && <CompliancePanel profile={p} n={fig()} id={id('Figure compliance')} />}
          </>
        ))}
        {seg.after && <WorkflowCard id={seg.after} n={fig()} figId={id(`Figure workflow ${seg.after}`)} listed={listed(seg.after)} />}
      </>
    ))}

    {unplaced.length > 0 && (
      <section class="profile-workflows">
        <h2 id={id('Workflows in this profile')}>Workflows in this profile</h2>
        {unplaced.map((w) => <WorkflowCard id={w} n={fig()} figId={id(`Figure workflow ${w}`)} listed={listed(w)} />)}
      </section>
    )}
  </article>
</DocLayout>
