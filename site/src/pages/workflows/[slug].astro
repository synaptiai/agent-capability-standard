---
// One page per workflow in the core and domain catalogs: goal, the step map,
// inputs, the steps (each a closed card with the step's role, purpose,
// effective safety flags per Standard §5.2.1, branches, failure handling,
// bindings and other fields), risk, the data flow between steps, and the
// workflow's other sections. Every heading the page adds has a `ref-` id.
import ContractTable from '../../components/ContractTable.astro';
import FlagBadge from '../../components/FlagBadge.astro';
import RiskBadge from '../../components/RiskBadge.astro';
import WorkflowDiagram from '../../components/WorkflowDiagram.astro';
import YamlBlock from '../../components/YamlBlock.astro';
import { loadOntology } from '../../data/ontology';
import { loadWorkflows } from '../../data/workflows';
import DocLayout from '../../layouts/DocLayout.astro';
import {
  capabilityHref,
  domainHref,
  pageHref,
  refSlugger,
  repoPathHref,
  routesByTemplate,
  specSectionHref,
  workflowHref,
} from '../../lib/generated';
import { githubBlobUrl } from '../../lib/repo';
import type { Route } from '../../lib/routes';
import {
  capabilitiesUsed,
  composedSkillsFor,
  profilesListing,
  schemaRows,
} from '../../lib/views';
import DataFlowGrid from '../../components/fig/DataFlowGrid.astro';
import Figure from '../../components/fig/Figure.astro';
import Port from '../../components/fig/Port.astro';
import RiskStrip from '../../components/fig/RiskStrip.astro';
import WorkflowSpine from '../../components/fig/WorkflowSpine.astro';
import { inputsCaption, stepList } from '../../lib/workflow-figures';

export function getStaticPaths() {
  const { all } = loadWorkflows();
  return routesByTemplate('workflow').map((route) => {
    const wf = all.find((w) => `/workflows/${w.slug}/` === route.url);
    if (!wf) throw new Error(`workflows: no workflow for ${route.url}`);
    return { params: { slug: wf.slug }, props: { route, workflowId: wf.id } };
  });
}

interface Props {
  route: Route;
  workflowId: string;
}

const { route, workflowId } = Astro.props;
const wf = loadWorkflows().byId.get(workflowId)!;
const ontology = loadOntology();
const id = refSlugger();
const profiles = profilesListing(wf.id);
const skills = composedSkillsFor(wf.id);
const checkpoints = wf.steps.filter((s) => s.capability === 'checkpoint').length;
const changing = wf.steps.filter((s) => s.effective.mutation).map((s) => s.index);
const validateCmd = `python tools/validate_workflows.py --catalog ${wf.source}`;
const inputRows = schemaRows(wf.inputs);
// Figures are numbered in page order: the step map, the inputs (when there
// are any), the risk, then the data flow.
const figN = { spine: 1, inputs: 2, risk: inputRows.length > 0 ? 3 : 2, flow: inputRows.length > 0 ? 4 : 3 };
const topInputs = inputRows.filter((r) => r.depth === 0).length;
---
<DocLayout route={route} title={wf.id} description={wf.goal}>
  <article class="doc doc--workflow" data-workflow={wf.id} data-catalog={wf.catalog} data-pagefind-body>
    <header class="workflow-header">
      <p class="workflow-header__id"><code>{wf.id}</code></p>
      <h1 id={id(wf.goal)}>{wf.goal}</h1>
      <ul class="workflow-header__badges">
        <li><RiskBadge risk={wf.risk} /></li>
        <li>
          {wf.catalog === 'core' ? (
            <FlagBadge kind="catalog-core" label="Reference workflow" />
          ) : (
            <FlagBadge kind="catalog-domain" label={`Domain: ${wf.domain ?? 'none'}`} href={wf.domain ? domainHref(wf.domain) : undefined} />
          )}
        </li>
      </ul>
      <dl class="workflow-meta">
        {wf.standardVersion && (
          <div><dt>Declares</dt><dd>Standard {wf.standardVersion}</dd></div>
        )}
        <div><dt>Steps</dt><dd>{wf.steps.length}</dd></div>
        <div><dt>Checkpoint steps</dt><dd>{checkpoints}</dd></div>
        <div><dt>Steps that change state</dt><dd>{changing.length}{changing.length > 0 && ` (${stepList(changing)})`}</dd></div>
        <div><dt>Source</dt><dd><a href={githubBlobUrl(wf.source)}><code>{wf.source}</code></a></dd></div>
        {wf.profile && (
          <div><dt>Profile</dt><dd><a href={repoPathHref(wf.profile, wf.source)}><code>{wf.profile}</code></a></dd></div>
        )}
      </dl>
    </header>

    {wf.description && <p class="workflow-description">{wf.description}</p>}

    <WorkflowSpine wf={wf} n={figN.spine} id="ref-fig-step-map" />

    <section class="workflow-inputs">
      <h2 id={id('Inputs')}>Inputs</h2>
      {inputRows.length === 0 ? (
        <ContractTable rows={inputRows} caption={`Inputs of ${wf.id}`} from={wf.source} />
      ) : (
        <>
          <Figure id="ref-fig-inputs" n={figN.inputs} title={`Inputs of ${wf.id}`} caption={inputsCaption(wf)} kind="workflow-inputs" class={topInputs > 4 ? 'wf-inputs wf-inputs--two' : 'wf-inputs'}>
            <ul class="ports ports--out">
              {inputRows.map((r) => (
                <Port name={r.path} type={r.type} required={r.required} description={r.description} depth={r.depth > 0 ? 1 : 0} />
              ))}
            </ul>
          </Figure>
          <details class="workflow-details">
            <summary>Inputs as a table, with constraints</summary>
            <ContractTable rows={inputRows} caption={`Inputs of ${wf.id}`} from={wf.source} />
          </details>
        </>
      )}
    </section>

    <section class="workflow-steps">
      <h2 id={id('Steps')}>Steps</h2>
      <WorkflowDiagram workflow={wf} />
    </section>

    <section class="workflow-risk">
      <h2 id={id('Risk')}>Risk</h2>
      <RiskStrip wf={wf} n={figN.risk} id="ref-fig-risk" />
      {wf.risk_propagation !== undefined && (
        <details class="workflow-details">
          <summary>Risk propagation as written in the catalog</summary>
          <YamlBlock value={wf.risk_propagation} />
        </details>
      )}
    </section>

    <section class="workflow-data-flow">
      <h2 id={id('Data flow')}>Data flow</h2>
      <DataFlowGrid wf={wf} n={figN.flow} id="ref-fig-data-flow" />
      {wf.data_flow !== undefined && (
        <details class="workflow-details">
          <summary>Data flow as written in the catalog</summary>
          <YamlBlock value={wf.data_flow} />
        </details>
      )}
    </section>

    {wf.success.length > 0 && (
      <section class="workflow-success">
        <h2 id={id('Success criteria')}>Success criteria</h2>
        <ul>{wf.success.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}
    {wf.workflow_extensions !== undefined && (
      <section class="workflow-extensions">
        <h2 id={id('Workflow extensions')}>Workflow extensions</h2>
        <p>See <a href={specSectionHref('5.9')}>Standard §5.9</a>.</p>
        <YamlBlock value={wf.workflow_extensions} />
      </section>
    )}
    {wf.triggers !== undefined && (
      <section class="workflow-triggers">
        <h2 id={id('Triggers')}>Triggers</h2>
        <YamlBlock value={wf.triggers} />
      </section>
    )}
    {Object.keys(wf.extra).length > 0 && (
      <section class="workflow-extra">
        <h2 id={id('Other fields')}>Other fields</h2>
        <YamlBlock value={wf.extra} />
      </section>
    )}

    <section class="workflow-related">
      <h2 id={id('Related')}>Related</h2>
      <dl>
        {skills.length > 0 && (
          <div>
            <dt>Claude Code skill</dt>
            <dd>{skills.map((s, i) => <>{i > 0 && ', '}<a href={pageHref(`/guides/skills/${s}/`)}><code>{s}</code></a></>)}</dd>
          </div>
        )}
        {profiles.length > 0 && (
          <div>
            <dt>Listed by the domain profiles</dt>
            <dd>{profiles.map((p, i) => <>{i > 0 && ', '}<a href={domainHref(p.key)}>{p.key}</a></>)}</dd>
          </div>
        )}
        {wf.invokedBy.length > 0 && (
          <div>
            <dt>Run by the workflows</dt>
            <dd>{wf.invokedBy.map((w, i) => <>{i > 0 && ', '}<a href={workflowHref(w)}><code>{w}</code></a></>)}</dd>
          </div>
        )}
        <div>
          <dt>Capabilities used</dt>
          <dd>
            <ul class="capability-chips">
              {capabilitiesUsed(wf).map((c) => (
                <li data-layer={ontology.byId.get(c)!.layer.toLowerCase()}><a href={capabilityHref(c)}><code>{c}</code></a></li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </section>

    <section class="workflow-validate">
      <h2 id={id('Validate it')}>Validate it</h2>
      <p>Run the reference validator on this workflow's catalog from the repository root:</p>
      <pre class="code-block code-block--shell" tabindex="0"><code>{validateCmd}</code></pre>
    </section>
  </article>
</DocLayout>
