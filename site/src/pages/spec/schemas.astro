---
// The schema files under schemas/, each linked to GitHub. The files the
// current Standard requires, and the supporting ones it names, are read from
// its §6.1; the rest are grouped by folder. Workflow catalogs and domain
// profiles have their own pages and are not listed here.
import DocLayout from '../../layouts/DocLayout.astro';
import { GENERATED_DESCRIPTIONS, currentStandard, pageHref, refSlugger, routeByUrl, specSectionHref } from '../../lib/generated';
import { githubBlobUrl, readRepoFile } from '../../lib/repo';
import { schemaGroups, schemaListing } from '../../lib/views';
import TableWrap from '../../components/TableWrap.astro';
import Figure from '../../components/fig/Figure.astro';
import PixelBar from '../../components/fig/PixelBar.astro';
import { SHELF_MIN_ROWS, schemaShelves, shelfCaption, shelfMax, shelfTitle } from '../../lib/index-figures';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import '../../styles/figures-indexes.css';

const route = routeByUrl('/spec/schemas/');
const std = currentStandard();
const entries = schemaListing(readRepoFile(std.source));
const id = refSlugger();
const GROUPS = schemaGroups(std.version);
const shelves = schemaShelves(entries, GROUPS);
let fig = 0;
const description = GENERATED_DESCRIPTIONS['/spec/schemas/']!();
---
<DocLayout route={route} title="Schemas" description={description}>
  <article class="doc doc--schemas" data-pagefind-body>
    <h1 id={id('Schemas')}>Schemas</h1>
    <p class="lead">
      These are the schema files in the repository. Each links to the file on GitHub. See
      {' '}<a href={specSectionHref('6.1')}>section 6.1 of the Standard</a> for what each required schema must hold.
      Workflow catalogs are listed on the <a href={pageHref('/workflows/')}>workflows page</a> and domain profiles on
      the <a href={pageHref('/domains/')}>domains page</a>.
    </p>
    {shelves.map((sh) => {
      const g = GROUPS.find((x) => x.key === sh.key)!;
      const table = (
        <TableWrap label={g.label}>
          <table class="schema-table">
            <caption class="fig-sr">{g.label}</caption>
            <thead>
              <tr><th scope="col" class="schema-table__col-file">File and length</th><th scope="col">What it holds</th></tr>
            </thead>
            <tbody>
              {sh.tiles.map((t) => (
                <tr data-schema={t.entry.name}>
                  <th scope="row" class="schema-table__file">
                    <PixelGlyph name="chapter:canonical-schemas" scale={2} />
                    <a href={githubBlobUrl(t.entry.source)}><code>{t.file}</code></a>
                    <span class="schema-table__meta">
                      {t.format}
                      {sh.key === 'required' && <span class="schema-table__stamp"><PixelGlyph name="mark:required" />Required</span>}
                    </span>
                    <span class="schema-table__length"><PixelBar value={t.lines} max={shelfMax(sh)} label={`${t.lines} lines`} /></span>
                  </th>
                  <td>
                    {t.entry.purpose && <p class="schema-table__purpose">{t.entry.purpose}.</p>}
                    {t.entry.description && <p>{t.entry.description}</p>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
      );
      return (
        <section class="schema-group" data-group={sh.key}>
          <h2 id={id(g.label)}>{g.label}</h2>
          <p>{g.intro}{sh.tiles[0]!.entry.source.includes('/', 'schemas/'.length) && <> In <code>{sh.tiles[0]!.entry.source.split('/').slice(0, -1).join('/')}/</code>.</>}</p>
          {sh.tiles.length >= SHELF_MIN_ROWS ? (
            <Figure id={id(`fig-${g.label}`)} n={++fig} title={shelfTitle(sh)} caption={shelfCaption(sh)} kind="schema-shelf">{table}</Figure>
          ) : table}
        </section>
      );
    })}
  </article>
</DocLayout>
