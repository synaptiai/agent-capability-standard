---
// One page per capability, from its ontology node: the safety panel (F-C3),
// its relationships drawn one tile per neighbour (F-C1) over the edge table,
// the contract figure (F-C2) with the contract tables folded under it, the
// workflows that run it as step strips (F-C4), and the skill that implements
// it (skills/<id>/SKILL.md, rendered through the Markdown pipeline), with a
// tile chain under Composition Patterns (visual spec 3.1). The layer always comes from
// the ontology. Headings the page adds have `ref-` ids; the skill's own
// headings keep the ids GitHub gives them.
import { getEntry, render } from 'astro:content';
import CompositionChain from '../../components/fig/CompositionChain.astro';
import ContractDiagram from '../../components/fig/ContractDiagram.astro';
import Neighbourhood from '../../components/fig/Neighbourhood.astro';
import WhereItRuns from '../../components/fig/WhereItRuns.astro';
import SafetyPanel from '../../components/fig/SafetyPanel.astro';
import OutputFields from '../../components/fig/OutputFields.astro';
import ProcedureMap from '../../components/fig/ProcedureMap.astro';
import SafetySequence from '../../components/fig/SafetySequence.astro';
import {
  compositionChain,
  edgeRules,
  neighbours,
  outputFields,
  outputFieldsCaption,
  outputFieldsIsFigure,
  procedureMap,
  procedureMapIsFigure,
  safetySequence,
  sequenceCaption,
  sequenceIsFigure,
  splitAtH2s,
} from '../../lib/capability-figures';
import { currentStandardText } from '../../lib/spec-figures';
import '../../styles/figures-capability.css';
import '../../styles/figures-capability-skill.css';
import ContractTable from '../../components/ContractTable.astro';
import LayerBadge from '../../components/LayerBadge.astro';
import { loadOntology, ONTOLOGY_SOURCE } from '../../data/ontology';
import { loadVersions } from '../../data/versions';
import { capabilityUsage } from '../../data/workflows';
import DocLayout from '../../layouts/DocLayout.astro';
import { capabilityHref, refSlugger, routesByTemplate, specSectionHref } from '../../lib/generated';
import { COMMIT_SHA, githubBlobUrl, readRepoFile } from '../../lib/repo';
import type { Route } from '../../lib/routes';
import { contractRows, EDGE_LABELS, edgeGroups } from '../../lib/views';
import TableWrap from '../../components/TableWrap.astro';

export function getStaticPaths() {
  const ontology = loadOntology();
  return routesByTemplate('capability').map((route) => {
    const cap = ontology.capabilities.find((c) => route.source === `skills/${c.id}/SKILL.md`);
    if (!cap) throw new Error(`capabilities: no capability for ${route.url}`);
    return { params: { id: route.url.split('/')[2]! }, props: { route, capId: cap.id } };
  });
}

interface Props {
  route: Route;
  capId: string;
}

const { route, capId } = Astro.props;
const ontology = loadOntology();
const cap = ontology.byId.get(capId)!;
const usage = capabilityUsage(cap.id);
const groups = edgeGroups(cap, ontology);
const versions = loadVersions();
const id = refSlugger();

const entry = await getEntry('docs', route.source!);
if (!entry) throw new Error(`capabilities: no docs entry for ${route.source}`);
await render(entry);
if (typeof entry.rendered?.html !== 'string') throw new Error(`capabilities: ${route.source} has no rendered HTML`);
const skill = splitAtH2s(entry.rendered.html);
const fm = entry.data;
const skillText = readRepoFile(route.source!);
const chain = compositionChain(skillText);
const chainLength = chain.follows.length + chain.precedes.length + 1;
const fields = outputFields(cap, skillText, route.source!);
const sequence = safetySequence(cap, ontology);
const procedure = procedureMap(skillText, route.source!);
const std = currentStandardText();

// Figures are numbered in page order; a figure that falls back to a sentence takes no number.
let figN = 0;
const next = () => ++figN;
const nRelations = groups.length > 0 && neighbours(cap, ontology).length > 0 ? next() : 0;
const nContract = next();
const nUsage = usage.length > 0 ? next() : 0;
// The skill's Inputs section gets no port figure: the contract figure above
// already draws the same ports, and the skill's own table follows the
// heading (the review counted each input four times). Under Output Contract
// the page draws what the contract figure does not: which of the skill's
// output fields the contract declares (F-C6). Under Safety Constraints it
// draws where the capability may run in a step list (F-C5). Under Procedure
// it draws which inputs and output fields each step names (F-C7).
type After = { kind: 'chain' | 'output' | 'sequence' | 'procedure'; n: number } | { kind: 'sentence'; text: string };
const after: Record<string, After> = {};
for (const part of skill.parts) {
  // F-C7 only where two or more steps use a field's name; elsewhere nothing, since a count of one word match says little.
  if (part.id === 'procedure' && procedureMapIsFigure(procedure)) after[part.id] = { kind: 'procedure', n: next() };
  if (part.id === 'output-contract') after[part.id] = outputFieldsIsFigure(fields) ? { kind: 'output', n: next() } : { kind: 'sentence', text: outputFieldsCaption(cap, fields) };
  if (part.id === 'safety-constraints')
    after[part.id] = sequenceIsFigure(sequence) ? { kind: 'sequence', n: next() } : { kind: 'sentence', text: sequenceCaption(cap, sequence, edgeRules(std.text, std.source)) };
  if (part.id === 'composition-patterns' && chainLength >= 2) after[part.id] = { kind: 'chain', n: next() };
}
const skillFacts = (
  [
    ['argument-hint', 'Arguments'],
    ['allowed-tools', 'Allowed tools'],
    ['agent', 'Agent'],
    ['context', 'Context'],
  ] as const
).flatMap(([key, label]) => {
  const v = fm[key];
  return typeof v === 'string' && v.trim() !== '' ? [{ label, value: v }] : [];
});
---
<DocLayout route={route} title={cap.id} description={cap.description}>
  <article class="doc doc--capability" data-capability={cap.id} data-layer={cap.layer.toLowerCase()} data-pagefind-body>
    <header class="capability-header capability-header--panel">
      <div class="capability-header__text">
        <LayerBadge layer={cap.layer} />
        <h1 id={id(cap.id)}><code>{cap.id}</code></h1>
        <p class="lead">{cap.description}</p>
      </div>
      <div class="capability-header__safety">
        <SafetyPanel cap={cap} id="ref-safety" />
        <p class="capability-header__defs">
          Defined in the Standard: <a href={specSectionHref('4.1')}>risk and state</a>, <a href={specSectionHref('4.4')}>checkpoints</a>, <a href={specSectionHref('5.2.1')}>approval</a>.
        </p>
      </div>
    </header>

    <section class="capability-relationships">
      <h2 id={id('Relationships')}>Relationships</h2>
      {groups.length === 0 ? (
        <p>No edge in the ontology starts or ends at this capability.</p>
      ) : (
        <>
        <Neighbourhood cap={cap} n={nRelations} describedby="ref-relationships-table" />
        <details class="fig-details" id="ref-relationships-table">
        <summary>The same edges as a table, by type</summary>
        <TableWrap label={`Edges of ${cap.id} in the ontology, by type`}>
          <table class="edge-table">
            <caption>Edges of {cap.id} in the ontology, by type</caption>
            <thead>
              <tr>
                <th scope="col">Edge type</th>
                <th scope="col">From this capability</th>
                <th scope="col">To this capability</th>
              </tr>
            </thead>
            <tbody>
              {groups.map((g) => (
                <tr data-edge-type={g.type}>
                  <th scope="row"><code>{g.type}</code></th>
                  {g.symmetric ? (
                    <td colspan="2">
                      <span class="edge-table__label">{EDGE_LABELS[g.type].out}</span>{' '}
                      <ul class="edge-table__list">
                        {g.related.map((c) => <li><a href={capabilityHref(c)}><code>{c}</code></a></li>)}
                      </ul>
                    </td>
                  ) : (
                    <>
                      <td>
                        {g.outgoing.length > 0 && (
                          <>
                            <span class="edge-table__label">{EDGE_LABELS[g.type].out}</span>{' '}
                            <ul class="edge-table__list">
                              {g.outgoing.map((c) => <li><a href={capabilityHref(c)}><code>{c}</code></a></li>)}
                            </ul>
                          </>
                        )}
                      </td>
                      <td>
                        {g.incoming.length > 0 && (
                          <>
                            <span class="edge-table__label">{EDGE_LABELS[g.type].in}</span>{' '}
                            <ul class="edge-table__list">
                              {g.incoming.map((c) => <li><a href={capabilityHref(c)}><code>{c}</code></a></li>)}
                            </ul>
                          </>
                        )}
                      </td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
        </details>
        </>
      )}
    </section>

    <section class="capability-contract">
      <h2 id={id('Contract')}>Contract</h2>
      <ContractDiagram cap={cap} n={nContract} describedby="ref-contract-tables" />
      <details class="fig-details" id="ref-contract-tables">
        <summary>The same contract as tables, with descriptions</summary>
        <ContractTable rows={contractRows(cap.input_schema)} caption={`Inputs of ${cap.id}`} from={ONTOLOGY_SOURCE} side="in" />
        <ContractTable rows={contractRows(cap.output_schema)} caption={`Outputs of ${cap.id}`} from={ONTOLOGY_SOURCE} side="out" />
      </details>
    </section>

    <section class="capability-usage">
      <h2 id={id('Used in workflows')}>Used in workflows</h2>
      <WhereItRuns cap={cap} n={nUsage} />
    </section>

    <section class="capability-skill" data-skill={cap.id}>
      <h2 id={id('Claude Code skill')}>Claude Code skill</h2>
      <p>
        The skill <code>{typeof fm.name === 'string' ? fm.name : cap.id}</code> implements this capability.
        {typeof fm.description === 'string' && <> {fm.description}</>}
      </p>
      {skillFacts.length > 0 && (
        <dl class="skill-meta">
          {skillFacts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd><code>{f.value}</code></dd>
            </div>
          ))}
        </dl>
      )}
      <div class="doc__body">
        {skill.lead && <Fragment set:html={skill.lead} />}
        {skill.parts.map((part) => {
          const fig = after[part.id];
          return (
            <>
              <Fragment set:html={part.head} />
              {fig?.kind === 'chain' && <CompositionChain cap={cap} chain={chain} n={fig.n} />}
              {fig?.kind === 'procedure' && <ProcedureMap cap={cap} map={procedure} n={fig.n} />}
              {fig?.kind === 'output' && <OutputFields cap={cap} fields={fields} n={fig.n} />}
              {fig?.kind === 'sequence' && <SafetySequence cap={cap} n={fig.n} />}
              {fig?.kind === 'sentence' && <p>{fig.text}</p>}
              <Fragment set:html={part.body} />
            </>
          );
        })}
      </div>
    </section>

    <p class="generated-stamp">
      From ontology {versions.ontology} (<a href={githubBlobUrl(ONTOLOGY_SOURCE)}>{ONTOLOGY_SOURCE}</a>), commit <code>{COMMIT_SHA.slice(0, 12)}</code>.
    </p>
  </article>
</DocLayout>
