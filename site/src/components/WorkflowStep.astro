---
// One step of the workflow diagram (design notes, design-system section 12;
// visual spec 3.3): its number on the rail, then a card that is a closed
// <details>. The summary shows the capability, its layer, its effective risk
// and its purpose, so the list reads as the text version of the step map
// above it. Opening the card shows everything else the catalog says about
// the step: its flags, the checkpoint it relies on, its condition or gates
// (drawn as a branch), the outputs it stores and reads, the workflow it runs,
// its failure handling, its input bindings and any other fields. The summary
// holds no links; the capability and layer links are in the body.
import type { Workflow } from '../data/workflows';
import { capabilityHref, diagnosticHref, repoPathHref, specSectionHref, workflowHref } from '../lib/generated';
import { failureRows, gateRows, producerSteps, type DiagramStep } from '../lib/views';
import PixelGlyph from '../pixel/PixelGlyph.astro';
import BreakCode from './BreakCode.astro';
import Callout from './Callout.astro';
import FlagBadge from './FlagBadge.astro';
import LayerBadge from './LayerBadge.astro';
import RiskBadge from './RiskBadge.astro';
import YamlBlock from './YamlBlock.astro';

interface Props {
  workflow: Workflow;
  d: DiagramStep;
}

const { workflow, d } = Astro.props;
const { step, role, branch, checkpointStep, missingCheckpoint } = d;
const e = step.effective;
const gates = gateRows(step);
const failures = failureRows(step);
const reads = producerSteps(workflow, step);
const stepId = (n: number) => `ref-step-${n}`;
// The node glyph shows the role, so the colour of the node is not the only signal.
const NODE_GLYPH: Partial<Record<typeof role, string>> = { checkpoint: 'flag', verify: 'check', rollback: 'undo', mutating: 'pencil' };
const nodeGlyph = NODE_GLYPH[role];
const has = (v: unknown) => v !== undefined && v !== null;
---
<li
  id={stepId(step.index)}
  value={step.index}
  class="wf-step has-layer"
  style={`--layer: var(--layer-${step.layer})`}
  data-step={step.index}
  data-role={role}
  data-branch={branch ? 'true' : undefined}
  data-capability={step.capability}
  data-layer={step.layer.toLowerCase()}
>
  <span class="wf-step__node" aria-hidden="true">{nodeGlyph && <PixelGlyph name={nodeGlyph} />}</span>
  <span class="wf-step__number">{step.index}</span>
  <details class="wf-step__card">
    <summary class="wf-step__summary">
      <RiskBadge risk={e.risk} />
      <span class="wf-step__head">
        <code>{step.capability}</code>
        <LayerBadge layer={step.layer} link={false} />
        {step.domain && <span class="wf-step__domain">domain <code>{step.domain}</code></span>}
      </span>
      {step.purpose && <span class="wf-step__purpose">{step.purpose}</span>}
    </summary>
    <div class="wf-step__body">
      <ul class="capability-flags">
        {e.mutation && <li><FlagBadge kind="mutation" label="Mutates" /></li>}
        {e.checkpoint.needed && <li><FlagBadge kind="checkpoint" label="Checkpoint required" /></li>}
        {e.requires_approval && <li><FlagBadge kind="approval" label="Approval required" /></li>}
      </ul>
      <dl class="wf-step__facts">
        <div>
          <dt>Capability</dt>
          <dd><a href={capabilityHref(step.capability)}><code>{step.capability}</code></a>, in the <LayerBadge layer={step.layer} /> layer</dd>
        </div>
        {role === 'mutating' && checkpointStep !== null && (
          <div><dt>Checkpoint</dt><dd><a href={`#${stepId(checkpointStep)}`}>step {checkpointStep}</a></dd></div>
        )}
        {role === 'rollback' && checkpointStep !== null && (
          <div><dt>Restores</dt><dd>the checkpoint from <a href={`#${stepId(checkpointStep)}`}>step {checkpointStep}</a></dd></div>
        )}
        {step.store_as && <div><dt>Stores</dt><dd><BreakCode text={step.store_as} /></dd></div>}
        {reads.length > 0 && (
          <div>
            <dt>Uses output of</dt>
            <dd>
              {reads.map((r, i) => (
                <>{i > 0 && ', '}<a href={`#${stepId(r.index)}`}>step {r.index}</a> (<BreakCode text={r.name} />)</>
              ))}
            </dd>
          </div>
        )}
        {step.workflow_id && (
          <div><dt>Runs workflow</dt><dd><PixelGlyph name="flow:invoke" /> <a href={workflowHref(step.workflow_id)}><code>{step.workflow_id}</code></a></dd></div>
        )}
        {step.parallel_group && <div><dt>Parallel group</dt><dd><code>{step.parallel_group}</code></dd></div>}
        {step.mapping_ref && (
          <div><dt>Mapping</dt><dd><a href={repoPathHref(step.mapping_ref, workflow.source)}><code>{step.mapping_ref}</code></a></dd></div>
        )}
        {has(step.timeout) && <div><dt>Timeout</dt><dd><code>{String(step.timeout)}</code></dd></div>}
        {has(step.retry) && <div><dt>Retry</dt><dd><code>{JSON.stringify(step.retry)}</code></dd></div>}
        {e.downgrades.length > 0 && (
          <div>
            <dt><a href={specSectionHref('5.2.1')}>Ignored declarations</a></dt>
            <dd>
              The step declares {e.downgrades.join(', ')} weaker than the ontology. The ontology's values apply, and a
              validator reports <a href={diagnosticHref('W602')}><code>W602</code></a>.
            </dd>
          </div>
        )}
      </dl>
      {missingCheckpoint && (
        <Callout type="caution">
          <p>
            This step needs a checkpoint before it, and no earlier step is one. A validator reports
            {' '}<a href={diagnosticHref(missingCheckpoint)}><code>{missingCheckpoint}</code></a>.
          </p>
        </Callout>
      )}
      {has(step.condition) && (
        <p class="wf-step__branch">
          <PixelGlyph name="flow:condition" /><span class="wf-step__only-if">Only if</span> <BreakCode text={String(step.condition)} />
          {step.skip_if_false === true && ' (skipped when false)'}
        </p>
      )}
      {gates.length > 0 && (
        <ul class="wf-step__gates">
          {gates.map((g) => (
            <li>
              <PixelGlyph name="diamond" /> <span class="wf-step__gate-label">Gate</span>{g.phase && <> ({g.phase} the step)</>}: when <BreakCode text={g.when} />,{' '}
              <code>{g.action}</code>.{g.message && <> {g.message}</>}
            </li>
          ))}
        </ul>
      )}
      {failures.length > 0 && (
        <>
          <p class="wf-step__label">Failure handling</p>
          <ul class="wf-step__failures">
            {failures.map((f) => (
              <li>
                {f.condition && <>{f.condition.replace(/[.\s]+$/, '')}{f.when && <> (<code>{f.when}</code>)</>}. </>}
                {!f.condition && f.when && <>When <code>{f.when}</code>. </>}
                {f.codes.length > 0 && (
                  <>Codes: {f.codes.map((c, i) => <>{i > 0 && ', '}<a href={diagnosticHref(c)}><code>{c}</code></a></>)}. </>
                )}
                Action: <code>{f.action}</code>.{f.recovery && <> {f.recovery}</>}
              </li>
            ))}
          </ul>
        </>
      )}
      {Object.keys(step.input_bindings).length > 0 && (
        <>
          <p class="wf-step__label">Input bindings</p>
          <YamlBlock value={step.input_bindings} />
        </>
      )}
      {Object.keys(step.extra).length > 0 && (
        <>
          <p class="wf-step__label">Other step fields</p>
          <YamlBlock value={step.extra} />
        </>
      )}
    </div>
  </details>
</li>
