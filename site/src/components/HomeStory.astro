---
// The home page's scroll story: text steps beside a sticky pixel diagram.
// Everything is drawn here from the ontology and the model_deployment
// workflow as rects on a 2px grid; nothing is copied or typed in.
// - Beat 1: every capability as a small periodic tile (its two-letter symbol
//   on its layer tint, in a layer-coloured border), in a column per layer
//   under that layer's glyph; the ones the workflow uses carry an ink frame.
//   The symbol and the glyph come with every colour (visual spec 1.2).
// - Beat 2: the workflow's steps as a rail, with the first step's contract
//   shown as input and output ports.
// - Beats 3 to 6: the checkpoint, the step that changes state (with a line
//   from the checkpoint it depends on), verify, and rollback (with a line
//   back to the checkpoint). Each is marked with its shared role glyph.
// The server-rendered diagram is the final frame: every beat shows (visual
// spec 1.2). That is what a reader without JavaScript, with reduced motion,
// a print or a full-page capture sees. Only when the reader scrolls inside
// the story does the script hide the beats after the current step, and it
// shows the final frame again when the story leaves the screen.
import { capabilitiesOfLayer, loadOntology } from '../data/ontology';
import { story } from '../lib/home';
import { capabilitySymbol } from '../lib/views';
import { chevron, glyphRects, type FigRect } from '../pixel/lines';
import InlineText from './InlineText.astro';
import Rects from './fig/Rects.astro';

interface Props {
  id: (text: string) => string;
}

const { id } = Astro.props;
const s = story();
const svgTitle = id('story-svg-title');
const ontology = loadOntology();
const used = new Set(s.workflow.steps.map((x) => x.capability));

// Every coordinate below is a multiple of 2 (visual spec 1.2).
const W = 320;
const X0 = 8;
const PITCH = 34;
const SQ = 22; // a tile: 2px border and an 18px face, room for a 12px two-letter symbol
const ROW_GAP = 6; // a used tile's 2px ink frame still leaves 2px to the next tile
const HEAD = 8;
const GLYPH = 2; // the layer glyphs at 2x: 18px, centred over the tile
const gridTop = HEAD + 9 * GLYPH + 8;
const maxRows = Math.max(...ontology.layers.map((l) => l.capabilities.length));
const colX = (i: number) => X0 + i * PITCH + (PITCH - SQ) / 2;
const heads = ontology.layers.map((layer, i) => ({ layer: layer.id, x: colX(i) + (SQ - 9 * GLYPH) / 2 }));
const squares = ontology.layers.flatMap((layer, i) =>
  capabilitiesOfLayer(ontology, layer.id).map((cap, j) => ({
    id: cap.id,
    layer: layer.id,
    x: colX(i),
    y: gridTop + j * (SQ + ROW_GAP),
    used: used.has(cap.id),
    symbol: capabilitySymbol(cap.id),
  })),
);
const gridBottom = gridTop + maxRows * (SQ + ROW_GAP);

// Rail of steps.
const railTop = gridBottom + 24;
const ROW = 30;
const BH = 22;
const RX = 60;
const RW = 196;
const rowY = (index: number) => railTop + (index - 1) * ROW;
/** The centre line of a step's block; runs are centred on it, so their rects land on even pixels. */
const mid = (index: number) => rowY(index) + BH / 2;
const H = railTop + s.workflow.steps.length * ROW + 6;

const beatOf = (index: number): number | null =>
  index === s.checkpointStep.index ? 3 : index === s.changeStep.index ? 4 : index === s.verifyStep.index ? 5 : index === s.rollbackStep.index ? 6 : null;

const cp = s.checkpointStep.index;
const ch = s.changeStep.index;
const rb = s.rollbackStep.index;
const vf = s.verifyStep.index;
if (!(cp < ch && ch < rb)) throw new Error('HomeStory: expected checkpoint, then the change, then rollback');

// Text size in viewBox units: 12 for the step labels and the tile symbols.
// The rail shows no stored names: they did not fit at a readable size, and
// the steps' text and the workflow page name them.
const LABEL = 12;

// The role marks: the shared 7x7 role glyphs at 2x, right of the rail.
const MARK_X = RX + RW + 10;
const mark = (role: string, index: number) => glyphRects(`role:${role}`, MARK_X, mid(index) - 7, 2);

// Lines are 2px rects whose top-left corners sit on even pixels: a line
// "at" an odd centre line y covers y - 1 to y + 1.
const hLine = (x1: number, x2: number, y: number): FigRect => ({ x: x1, y: y - 1, w: x2 - x1, h: 2, ink: 'ink' });
const vLine = (x: number, y1: number, y2: number): FigRect => ({ x, y: y1 - 1, w: 2, h: y2 - y1 + 2, ink: 'ink' });
// Beat 4: a line from the checkpoint to the step that changes state, along
// the left of the rail, ending in a chevron at the block.
const toChange: FigRect[] = [
  hLine(46, RX, mid(cp)),
  vLine(46, mid(cp), mid(ch)),
  hLine(46, RX - 6, mid(ch)),
  ...chevron(RX - 3, mid(ch), 'right', 'ink'),
];
// Beat 6: the line back from rollback enters the checkpoint block near its
// top, above the line out to the step that changes state, and runs further
// left, so the two lines never cross or touch.
const backY = rowY(cp) + 5;
const back: FigRect[] = [
  hLine(34, RX, mid(rb)),
  vLine(34, backY, mid(rb)),
  hLine(34, RX - 6, backY),
  ...chevron(RX - 3, backY, 'right', 'ink'),
];

// Below 960px the diagram is drawn larger by showing one part at a time:
// the capability grid for beat 1, the rail for the later beats. The box keeps
// the rail's shape so the text below does not move when the view changes.
const fullView = `0 0 ${W} ${H}`;
const gridView = `0 0 ${W} ${gridBottom + 4}`;
const railView = `0 ${railTop - 8} ${W} ${H - railTop + 8}`;
const portsIn = s.contractInputs.length;
const portsOut = s.contractOutputs.length;
const first = s.contractStep.index;
/** Ports spread down the block's edge, each on an even pixel. */
const portY = (n: number, k: number) => rowY(first) + 2 * Math.round(((k + 1) * BH) / (n + 1) / 2) - 2;
---
<div class="story" data-story>
  <div class="story__canvas">
    <svg
      class="story__svg"
      viewBox={fullView}
      style={`--rail-aspect: ${W} / ${H - railTop + 8}`}
      data-view-full={fullView}
      data-view-grid={gridView}
      data-view-rail={railView}
      role="img"
      aria-labelledby={svgTitle}
      shape-rendering="crispEdges"
      data-story-svg
    >
      <title id={svgTitle}>
        Diagram: the capabilities in a grid by layer, then the steps of the {s.workflow.id} workflow as a rail, with its
        checkpoint, the step that makes the change, verify and rollback marked.
      </title>
      <g data-beat="1">
        {heads.map((h) => (
          <g class="story__head has-layer" style={`--layer: var(--layer-${h.layer}); color: var(--layer)`}>
            <Rects rects={glyphRects(h.layer, h.x, HEAD, GLYPH)} />
          </g>
        ))}
        {squares.map((q) => (
          <g class:list={['story__tile', 'has-layer', q.used && 'story__tile--used']} style={`--layer: var(--layer-${q.layer})`} data-capability={q.id}>
            {q.used && <rect class="story__used" x={q.x - 2} y={q.y - 2} width={SQ + 4} height={SQ + 4} />}
            <rect class="story__cap" x={q.x} y={q.y} width={SQ} height={SQ} />
            <rect class="story__face" x={q.x + 2} y={q.y + 2} width={SQ - 4} height={SQ - 4} />
            <text class="story__symbol" x={q.x + SQ / 2} y={q.y + 15} font-size={LABEL}>{q.symbol}</text>
          </g>
        ))}
      </g>

      <g data-beat="2">
        {s.workflow.steps.map((st) => (
          <>
            <rect class="story__edge" x={RX} y={rowY(st.index)} width={RW} height={BH} />
            <rect class="story__block" x={RX + 2} y={rowY(st.index) + 2} width={RW - 4} height={BH - 4} />
          </>
        ))}
      </g>
      {s.workflow.steps.map((st) => {
        const beat = beatOf(st.index);
        return beat === null ? null : (
          <rect
            class="story__on"
            x={RX + 2}
            y={rowY(st.index) + 2}
            width={RW - 4}
            height={BH - 4}
            style={`--layer: var(--layer-${st.layer})`}
            data-beat={beat}
          />
        );
      })}
      <g data-beat="2">
        {s.workflow.steps.map((st) => (
          <>
            <rect class="story__stripe" x={RX + 2} y={rowY(st.index) + 2} width={4} height={BH - 4} style={`--layer: var(--layer-${st.layer})`} />
            <text class="story__label" x={RX + 10} y={mid(st.index) + 4} font-size={LABEL}>{st.index} {st.capability}</text>
          </>
        ))}
        {Array.from({ length: portsIn }, (_, k) => <rect class="story__port" x={RX - 6} y={portY(portsIn, k)} width={6} height={4} />)}
        {Array.from({ length: portsOut }, (_, k) => <rect class="story__port" x={RX + RW} y={portY(portsOut, k)} width={6} height={4} />)}
      </g>

      <g data-beat="3" class="story__mark"><Rects rects={mark('checkpoint', cp)} /></g>
      <g data-beat="4" class="story__mark"><Rects rects={[...mark('mutating', ch), ...toChange]} /></g>
      <g data-beat="5" class="story__mark"><Rects rects={mark('verify', vf)} /></g>
      <g data-beat="6" class="story__mark"><Rects rects={[...mark('rollback', rb), ...back]} /></g>
    </svg>
  </div>
  <ol class="story__steps">
    {s.steps.map((st) => (
      <li class="story__step" data-story-step={st.beat}>
        <h3 id={id(st.title)}>{st.title}</h3>
        <p><InlineText parts={st.text} /></p>
      </li>
    ))}
  </ol>
</div>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (story && !reduce.matches) {
    const steps = [...story.querySelectorAll<HTMLElement>('[data-story-step]')];
    const parts = [...story.querySelectorAll<SVGElement>('[data-beat]')];
    const svg = story.querySelector<SVGSVGElement>('[data-story-svg]')!;
    const narrow = window.matchMedia('(max-width: 959px)');
    // The final frame: every beat, the whole diagram, no step dimmed.
    const finalFrame = () => {
      delete story.dataset.playing;
      for (const p of parts) p.classList.remove('is-off');
      for (const s of steps) s.classList.remove('is-current');
      if (svg.dataset.viewFull) svg.setAttribute('viewBox', svg.dataset.viewFull);
    };
    const show = (b: number) => {
      story.dataset.playing = '';
      for (const p of parts) p.classList.toggle('is-off', Number(p.dataset.beat) > b);
      for (const s of steps) s.classList.toggle('is-current', Number(s.dataset.storyStep) === b);
      const view = !narrow.matches ? svg.dataset.viewFull : b === 1 ? svg.dataset.viewGrid : svg.dataset.viewRail;
      if (view) svg.setAttribute('viewBox', view);
    };
    // The current step is the last one whose heading has come up past the
    // line: the middle of the screen when wide; lower when narrow, where the
    // diagram covers the top of the screen.
    const update = () => {
      const vh = window.innerHeight;
      const box = story.getBoundingClientRect();
      if (box.bottom < vh * 0.5 || box.top > vh * 0.5) return finalFrame();
      const line = vh * (narrow.matches ? 0.8 : 0.55);
      let beat = 1;
      for (const s of steps) if (s.getBoundingClientRect().top < line) beat = Number(s.dataset.storyStep);
      show(beat);
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    // data-live spaces the steps out for scrolling; nothing is hidden until
    // the reader scrolls inside the story.
    story.dataset.live = '';
    window.addEventListener('scroll', onScroll, { passive: true });
    narrow.addEventListener('change', () => (story.dataset.playing === undefined ? finalFrame() : update()));
    // A reader who turns on reduced motion mid-page gets the final frame.
    reduce.addEventListener('change', () => {
      if (!reduce.matches) return;
      window.removeEventListener('scroll', onScroll);
      delete story.dataset.live;
      finalFrame();
    });
  }
</script>
