---
// The periodic table of capabilities (design notes, design-system section
// 11): one column per layer in ontology order, each with its name and count,
// then its capabilities as tiles numbered 1 onwards in layer order. Generated
// from the ontology; nothing in it is typed by hand, and the number of
// columns in the wide layout is the number of layers.
import { capabilitiesOfLayer, loadOntology } from '../data/ontology';
import { layerHref } from '../lib/generated';
import { capabilitySymbols, tableOrder } from '../lib/views';
import PixelGlyph from '../pixel/PixelGlyph.astro';
import CapabilityTile from './CapabilityTile.astro';

const ontology = loadOntology();
const order = tableOrder(ontology);
const symbols = capabilitySymbols(order);
---
<div class="capability-table" data-capabilities={order.length}>
  <div class="capability-table__grid" style={`--layers: ${ontology.layers.length}`}>
  {ontology.layers.map((layer) => (
    <section
      class="capability-table__layer has-layer"
      style={`--layer: var(--layer-${layer.id})`}
      data-layer={layer.slug}
      aria-label={`${layer.id}, ${layer.capabilities.length} capabilities`}
    >
      <p class="capability-table__layer-name">
        <PixelGlyph name={layer.id} layer={layer.id} scale={3} />
        <a href={layerHref(layer.id)}>{layer.id}</a>
        <span class="capability-table__layer-count">{layer.capabilities.length}</span>
      </p>
      <ul class="capability-table__tiles">
        {capabilitiesOfLayer(ontology, layer.id).map((cap) => (
          <li><CapabilityTile cap={cap} index={order.indexOf(cap.id) + 1} symbol={symbols.get(cap.id)!} /></li>
        ))}
      </ul>
    </section>
  ))}
  </div>
</div>
