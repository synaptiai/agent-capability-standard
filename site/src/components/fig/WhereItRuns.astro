---
// F-C4, where a capability runs (visual spec 3.1): one row per workflow that
// uses it, with its name and the step numbers on one line and the
// workflow's steps under them as a 20px StepStrip. Every plain step shows
// its capability's two-letter symbol on its layer tint, as on the home
// gallery, and this capability's steps also carry an ink ring. A key under
// the rows names each tile the strips use (stripKey). Up to 8 rows show; the
// rest are in a "Show all" disclosure. With no workflow, a sentence and the
// empty glyph instead of a figure.
//
// Props:
// - cap: Capability, required.
// - n: number, required. The figure number on the page.
import type { Capability } from '../../data/ontology';
import { capabilityUsage, loadWorkflows } from '../../data/workflows';
import { loadOntology } from '../../data/ontology';
import { stepWords, usageCaption } from '../../lib/capability-figures';
import { workflowHref } from '../../lib/generated';
import { ROLE_GLYPH, stripKey } from '../../lib/workflow-figures';
import { capabilitySymbol } from '../../lib/views';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import Figure from './Figure.astro';
import StepStrip from './StepStrip.astro';

interface Props {
  cap: Capability;
  n: number;
}

const { cap, n } = Astro.props;
const usage = capabilityUsage(cap.id);
const all = loadWorkflows().all;
const rows = usage.map((u) => ({ u, wf: all.find((w) => w.id === u.workflowId)! }));
const CAP = 8;
const shown = rows.slice(0, CAP);
const rest = rows.slice(CAP);
const key = stripKey(rows.map((r) => r.wf), cap.id);
const layerOf = (id: string) => loadOntology().byId.get(id)!.layer;
---
{usage.length === 0 ? (
  <p class="runs-empty"><PixelGlyph name="empty" scale={3} /> <span>{usageCaption(cap, usage)}</span></p>
) : (
  <Figure id="ref-fig-usage" n={n} title={`${cap.id} in workflows`} caption={usageCaption(cap, usage)} kind="usage">
    <ul class="runs" aria-label={`${cap.id} in workflows`}>
      {shown.map(({ u, wf }) => (
        <li class="runs__row" data-workflow={u.workflowId} data-catalog={u.catalog}>
          <a class="runs__name" href={workflowHref(u.workflowId)}><code>{u.workflowId}</code></a>
          <StepStrip wf={wf} size={20} highlight={cap.id} symbols />
          <span class="runs__steps">{stepWords(u.steps)}</span>
        </li>
      ))}
    </ul>
    {rest.length > 0 && (
      <details class="runs__more">
        <summary>Show all {rows.length}</summary>
        <ul class="runs" aria-label={`More workflows that use ${cap.id}`}>
          {rest.map(({ u, wf }) => (
            <li class="runs__row" data-workflow={u.workflowId} data-catalog={u.catalog}>
              <a class="runs__name" href={workflowHref(u.workflowId)}><code>{u.workflowId}</code></a>
              <StepStrip wf={wf} size={20} highlight={cap.id} symbols />
              <span class="runs__steps">{stepWords(u.steps)}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
    <ul class="strip-key" aria-label="Key">
      {key.map((k) => (
        <li data-key={k.kind}>
          <span class="step-strip step-strip--20" aria-hidden="true">
            {k.kind === 'here' && <span class="step-strip__step step-strip__step--hit step-strip__step--here has-layer" style={`--layer: var(--layer-${cap.layer})`}>{capabilitySymbol(cap.id)}</span>}
            {k.kind === 'symbol' && <span class="step-strip__step step-strip__step--hit has-layer" style={`--layer: var(--layer-${layerOf(k.capability)})`}>{capabilitySymbol(k.capability)}</span>}
            {k.kind === 'role' && <span class="step-strip__step step-strip__step--role"><PixelGlyph name={ROLE_GLYPH[k.role]!} scale={2} /></span>}
            {k.kind === 'gate' && <span class="step-strip__step step-strip__step--plain step-strip__step--gate"></span>}
          </span>
          <span>{k.label}</span>
        </li>
      ))}
    </ul>
  </Figure>
)}
