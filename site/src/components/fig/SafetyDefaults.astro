---
// F-S6, safety defaults by capability (visual spec 3.9): every capability
// in table order, one row each, with four columns: risk (1 to 3 pips in
// the risk's colour, with its word), changes state, needs checkpoint and
// needs approval, each a filled --ink square with its glyph when on and an
// outline when off. In a narrow frame the 36 rows become 4 columns of 9,
// each a 24px tile with its four marks under it. Each row is a list item
// whose hidden text says the same in words; the drawing is aria-hidden. A
// capability that needs a checkpoint only through a requires edge from
// checkpoint (rollback) gets an outlined cell with the requires mark, as §4.4
// and its own page say "Yes, via requires edge".
//
// Props:
// - id: string, required. A ref- id.
// - n: number, required.
// - title: string, required.
import { loadOntology } from '../../data/ontology';
import { checkpointViaEdge, FLAG_ROWS, flagState, flagWords, safetyDefaults, safetyDefaultsCaption } from '../../lib/spec-dsl-figures';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import Figure from './Figure.astro';
import MiniTile from './MiniTile.astro';

interface Props {
  id: string;
  n: number;
  title: string;
}

const { id, n, title } = Astro.props;
const o = loadOntology();
const rows = safetyDefaults(o).flatMap((g) => g.caps.map((c, i) => ({ c, layer: g.layer, first: i === 0 })));
const PIPS = { low: 1, medium: 2, high: 3 } as const;
const RISKS = Object.keys(PIPS) as (keyof typeof PIPS)[];
// A key entry for "via a requires edge" only when some capability needs one that way.
const anyViaEdge = o.capabilities.some(checkpointViaEdge);
---
<Figure id={id} n={n} title={title} caption={safetyDefaultsCaption(o)} kind="safety-defaults">
  <ul class="flag-key" aria-label="Key">
    <li><span class="flag-key__pips" aria-hidden="true">{RISKS.map((risk) => <span class="risk-pips flag-pips" data-risk={risk}>{Array.from({ length: PIPS[risk] }, () => <span class="risk-pips__pip"></span>)}</span>)}</span>Risk: low, medium, high</li>
    {FLAG_ROWS.map((f) => <li><span class="flag-cell flag-cell--on" aria-hidden="true"><PixelGlyph name={f.glyph} scale={1} /></span>{f.label}</li>)}
    {anyViaEdge && <li><span class="flag-cell flag-cell--edge" aria-hidden="true"><PixelGlyph name="mark:requires" scale={1} /></span>Needs checkpoint via a requires edge</li>}
    <li><span class="flag-cell flag-cell--off" aria-hidden="true"></span>Off</li>
  </ul>
  <div class="flag-strip">
    <p class="flag-row flag-row--head" aria-hidden="true">
      <span>Capability</span><span>Risk</span>{FLAG_ROWS.map((f) => <span>{f.label}</span>)}
    </p>
    <ul class="flag-rows" aria-label="Capabilities in table order" style={`--rows: ${Math.ceil(rows.length / 4)}`}>
      {rows.map(({ c, layer, first }) => (
        <li class:list={['flag-row', first && 'flag-row--layer']} data-capability={c.id} data-layer={layer} data-risk={c.risk} data-mutation={String(c.mutation)} data-checkpoint={String(c.requires_checkpoint)} data-approval={String(c.requires_approval)}>
          <span class="flag-row__cap" aria-hidden="true"><MiniTile id={c.id} size={24} link={false} /><code class="flag-row__id">{c.id}</code></span>
          <span class="flag-row__risk" aria-hidden="true"><span class="risk-pips flag-pips" data-risk={c.risk}>{Array.from({ length: PIPS[c.risk] }, () => <span class="risk-pips__pip"></span>)}</span><span class="flag-row__word">{c.risk}</span></span>
          {FLAG_ROWS.map((f) => (
            <span class:list={['flag-cell', `flag-cell--${flagState(c, f.id)}`]} data-flag={f.id} data-state={flagState(c, f.id)} aria-hidden="true">{flagState(c, f.id) === 'on' ? <PixelGlyph name={f.glyph} scale={1} /> : flagState(c, f.id) === 'edge' ? <PixelGlyph name="mark:requires" scale={1} /> : null}</span>
          ))}
          <span class="visually-hidden">{c.id}: {flagWords(c)}</span>
        </li>
      ))}
    </ul>
  </div>
</Figure>
