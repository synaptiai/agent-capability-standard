      <table class="heat">
        <thead><tr><th scope="col">Section</th>{heat.families.map((f) => <th scope="col" data-family={f.prefix}><span class="diag-family diag-family--small" aria-hidden="true">{f.prefix}</span><span class="heat__fam">{f.name}</span></th>)}</tr></thead>
        <tbody>
          {heat.sections.map((s, j) => (
            <tr>
              <th scope="row"><a href={sectionLink(s.n)}>§{s.n}</a> {s.title}</th>
              {heat.families.map((_, i) => {
                const c = heat.counts[i]![j]!;
                return <td class:list={['heat__cell', c > 0 && `heat__cell--${heatStep(c, heat.max)}`]} data-count={c}>{c > 0 ? c : ''}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </TableWrap>
    <p class="heat__legend">Codes named:{heatRanges(heat.max).map((r) => <span class="heat__key"><span class:list={['heat__cell', `heat__cell--${r.step}`]} aria-hidden="true"></span>{r.from === r.to ? r.from : `${r.from} to ${r.to}`}</span>)}<span class="heat__key"><span class="heat__cell" aria-hidden="true"></span>none</span></p>
  </Figure>
)}
