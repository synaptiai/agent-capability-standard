{slot === 'decay' && decay && (
  <Figure id={idOf('decay with a floor')} n={n} title={titled('Decay with a floor: reference configuration')} caption={T.decayCaption(decay)} kind="decay">
    <div class="decay">
      <svg class="decay__plot" viewBox={`-8 0 ${W_DECAY + 8} ${DECAY_H + 34}`} width={W_DECAY + 8} height={DECAY_H + 34} shape-rendering="crispEdges" role="img" aria-labelledby={`${idOf('decay with a floor')}-title`}>
        <Rects rects={decayRects} />
        <text x="28" y="10" text-anchor="end" font-size="12" fill="currentColor">1</text>
        <text x="28" y={floorY - 1} text-anchor="end" font-size="12" fill="currentColor">{decay.minTrust}</text>
        {decay.columns.filter((c) => Number.isInteger(c.halfLives)).map((c) => (
          <>
            <text x={36 + c.halfLives * 2 * 28 + 10} y={DECAY_H + 15} text-anchor="middle" font-size="12" fill="currentColor">{c.halfLives}</text>
            <text x={36 + c.halfLives * 2 * 28 + 10} y={DECAY_H + 30} text-anchor="middle" font-size="12" fill="currentColor">{c.days}d</text>
          </>
        ))}
      </svg>
      <ul class="decay__key">
        <li><span class="decay__swatch" aria-hidden="true"></span>0.5 ** (age / half_life)</li>
        <li><span class="decay__swatch decay__swatch--floor" aria-hidden="true"></span>held at the min_trust floor ({decay.minTrust})</li>
        <li>x axis: age in half-lives (top) and days (bottom)</li>
