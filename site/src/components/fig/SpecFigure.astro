                      <span class="chip chip--inner tree__a">{c.answer}</span>
                      <span class:list={['tree__out', /REQUIRED/.test(c.node.text) && 'tree__out--required']}>{/REQUIRED/.test(c.node.text) && <PixelGlyph name="role:checkpoint" />}{c.node.text}</span>
