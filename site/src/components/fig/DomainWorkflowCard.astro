---
// F-D6, a workflow of a domain profile as a card (visual spec 3.5): its steps
// in order as 24px periodic tiles (symbol and layer colour, not links, so the
// card adds one tab stop), the step count, the risk pips and a link to the
// workflow page. The spec draws a StepStrip here; the tiles say which
// capability each step runs, which the README's list under the card names. A
// workflow no catalog defines has no steps to draw, so it gets a plain card,
// not a figure: a dashed outline, the status:proposed glyph and the
// PROPOSED_WORKFLOW_STATUS badge. When the README lists the proposal's
// capabilities under "Capabilities used" and each is an ontology id
// (`listed`), the card is a figure of those capabilities as tiles in list
// order, each numbered, still dashed and marked proposed; its title names the
// workflow, and the proposed badge and the tiles share one row when they fit,
// so the dashed panel is no taller than it needs to be. The page puts each
// card under the matching H3 of the README's "Available Workflows".
//
// Props:
// - id: the workflow id the profile lists, required.
// - n: the figure number on the page.
// - figId: the figure's ref- id.
// - listed: the README's capability list for a proposed workflow, optional.
import Figure from './Figure.astro';
import MiniTile from './MiniTile.astro';
import { loadOntology } from '../../data/ontology';
import RiskBadge from '../RiskBadge.astro';
import StatusBadge from '../StatusBadge.astro';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import { loadWorkflows } from '../../data/workflows';
import { workflowHref } from '../../lib/generated';
import { PROPOSED_WORKFLOW_STATUS } from '../../lib/status';
import { workflowCardCaption } from '../../lib/domain-figures';
import { proposedCaption } from '../../lib/domain-usage';

interface Props {
  id: string;
  n: number;
  figId: string;
  listed?: string[] | null;
}

const { id, n, figId, listed } = Astro.props;
const wf = loadWorkflows().byId.get(id);
const known = new Set(loadOntology().capabilities.map((c) => c.id));
---
{wf ? (
  <Figure id={figId} n={n} title={`Steps of ${id}`} caption={workflowCardCaption(wf)} kind="workflow-card" class="wf-card">
    <div class="wf-card__body" data-workflow={id}>
      <ol class="wf-card__steps" aria-label={`The ${wf.steps.length} steps of ${id}, in order`}>
        {wf.steps.map((s) => (
          <li data-step={s.index}>
            {known.has(s.capability) ? <MiniTile id={s.capability} size={24} link={false} relation={`step ${s.index}`} /> : <code>{s.capability}</code>}
            <span class="wf-card__n" aria-hidden="true">{s.index}</span>
          </li>
        ))}
      </ol>
      <p class="wf-card__facts"><span>{wf.steps.length} {wf.steps.length === 1 ? 'step' : 'steps'}</span> <RiskBadge risk={wf.risk} /> <a class="wf-card__link" href={workflowHref(id)}>Open <code>{id}</code></a></p>
    </div>
  </Figure>
) : listed && listed.length > 0 ? (
  <Figure id={figId} n={n} title={`Capabilities the guide lists for ${id}`} caption={proposedCaption(listed)} kind="workflow-card-proposed" class="wf-card wf-card--listed">
    <div class="wf-card__body" data-workflow={id}>
      <p class="wf-card__facts">
        <span class="wf-card__glyph"><PixelGlyph name="status:proposed" scale={2} /></span>
        <StatusBadge status={PROPOSED_WORKFLOW_STATUS} />
      </p>
      <ol class="wf-card__steps" aria-label={`The ${listed.length} capabilities listed for ${id}, in order`}>
        {listed.map((c, k) => (
          <li>
            <MiniTile id={c} size={24} link={false} relation={`item ${k + 1}`} />
            <span class="wf-card__n" aria-hidden="true">{k + 1}</span>
          </li>
        ))}
      </ol>
    </div>
  </Figure>
) : (
  <div class="wf-card wf-card--proposed" data-workflow={id}>
    <span class="wf-card__glyph"><PixelGlyph name="status:proposed" scale={3} /></span>
    <code>{id}</code>
    <StatusBadge status={PROPOSED_WORKFLOW_STATUS} />
  </div>
)}
