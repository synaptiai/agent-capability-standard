---
// The chain the capability page draws under the skill's "Composition
// Patterns" heading (visual spec 3.1): one row of small periodic tiles in the
// order the section names them, the capabilities it commonly follows, then
// this capability (the 4px-bordered tile), then the ones it commonly
// precedes, with a chevron between each pair. The ids come from the
// section's own lists; words that are not capability ids are skipped. Drawn
// only when it has two or more tiles.
//
// Props:
// - cap: Capability, required.
// - chain: CompositionChain, required. From compositionChain().
// - n: number, required. The figure number on the page.
import type { Capability } from '../../data/ontology';
import { chainCaption, type CompositionChain } from '../../lib/capability-figures';
import PixelGlyph from '../../pixel/PixelGlyph.astro';
import Figure from './Figure.astro';
import MiniTile from './MiniTile.astro';

interface Props {
  cap: Capability;
  chain: CompositionChain;
  n: number;
}

const { cap, chain, n } = Astro.props;
const items = [
  ...chain.follows.map((id) => ({ id, relation: `commonly before ${cap.id}`, self: false })),
  { id: cap.id, relation: 'this capability', self: true },
  ...chain.precedes.map((id) => ({ id, relation: `commonly after ${cap.id}`, self: false })),
];
---
<Figure id="ref-fig-composition" n={n} title={`Where ${cap.id} sits in a sequence`} caption={chainCaption(cap, chain)} kind="composition">
  <ol class="chain" aria-label={`Capabilities in the order this section names them, with ${cap.id} in place`}>
    {items.map((x, i) => (
      <li class:list={['chain__item', x.self && 'chain__item--self']}>
        {i > 0 && <PixelGlyph name="chevron-right" class="chain__arrow" />}
        <MiniTile id={x.id} size={32} relation={x.relation} current={x.self} link={!x.self} />
      </li>
    ))}
  </ol>
</Figure>
