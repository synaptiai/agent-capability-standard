---
// The risk level of a capability or step (Standard §4.1). Always shows the word.
import type { Risk } from '../data/ontology';

interface Props {
  risk: Risk;
  href?: string;
  /** Text before the level, e.g. "Risk" or "Effective risk". */
  label?: string;
}

const { risk, href, label = 'Risk' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['risk-badge', `risk-badge--${risk}`]} href={href} data-risk={risk}>{label}: {risk}</Tag>
