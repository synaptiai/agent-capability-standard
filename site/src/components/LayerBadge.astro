---
// A capability layer (Standard §4.2), linked to its page: the layer glyph in
// the layer colour and the layer name, on the layer tint.
import { loadOntology } from '../data/ontology';
import { layerHref } from '../lib/generated';
import PixelGlyph from '../pixel/PixelGlyph.astro';

interface Props {
  layer: string;
  link?: boolean;
  /** Glyph only, the name kept for screen readers: for a row that is already one line of a step map. */
  compact?: boolean;
}

const { layer, link = true, compact = false } = Astro.props;
const info = loadOntology().layers.find((l) => l.id === layer);
if (!info) throw new Error(`LayerBadge: unknown layer ${layer}`);
const Tag = link ? 'a' : 'span';
---
<Tag
  class:list={['layer-badge', 'has-layer', `layer-badge--${info.slug}`, compact && 'layer-badge--compact']}
  style={`--layer: var(--layer-${layer})`}
  href={link ? layerHref(layer) : undefined}
  data-layer={info.slug}
><PixelGlyph name={layer} />{compact ? <span class="visually-hidden">{layer}</span> : layer}</Tag>
